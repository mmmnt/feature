{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Feat",
  "scopeName": "source.feat",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#pragma"
    },
    {
      "include": "#identity"
    },
    {
      "include": "#sections"
    },
    {
      "include": "#scenario"
    },
    {
      "include": "#trigger"
    },
    {
      "include": "#prediction"
    },
    {
      "include": "#matchers"
    },
    {
      "include": "#refs"
    },
    {
      "include": "#placeholders"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    }
  ],
  "repository": {
    "comment": {
      "comment": "ADR-0040: a comment is '#' as the first non-blank character only; a trailing '#' is not one",
      "match": "^\\s*(#.*)$",
      "captures": {
        "1": {
          "name": "comment.line.number-sign.feat"
        }
      }
    },
    "pragma": {
      "match": "^(feat)\\s+(\\d+\\.\\d+)\\s*$",
      "captures": {
        "1": {
          "name": "keyword.control.pragma.feat"
        },
        "2": {
          "name": "constant.numeric.version.feat"
        }
      }
    },
    "identity": {
      "patterns": [
        {
          "match": "^(spec)\\s+([A-Z0-9-]+)\\s+(\".*\")",
          "captures": {
            "1": {
              "name": "keyword.declaration.spec.feat"
            },
            "2": {
              "name": "entity.name.type.spec-id.feat"
            },
            "3": {
              "name": "string.quoted.double.feat"
            }
          }
        },
        {
          "match": "^(context|aggregate)\\s+(\\S+)",
          "captures": {
            "1": {
              "name": "keyword.declaration.feat"
            },
            "2": {
              "name": "entity.name.namespace.feat"
            }
          }
        },
        {
          "match": "^(type)\\s+(command|query|infrastructure|integration|scaffold|projection|policy|saga)\\b",
          "captures": {
            "1": {
              "name": "keyword.declaration.feat"
            },
            "2": {
              "name": "constant.language.spec-type.feat"
            }
          }
        },
        {
          "match": "^(status)\\s+(draft|agreed|built|verified)\\b",
          "captures": {
            "1": {
              "name": "keyword.declaration.feat"
            },
            "2": {
              "name": "constant.language.status.feat"
            }
          }
        },
        {
          "comment": "ADR-0033: the services this spec observes, each a service key",
          "begin": "^(observes)(?=\\s|$)",
          "beginCaptures": {
            "1": {
              "name": "keyword.declaration.feat"
            }
          },
          "end": "$",
          "patterns": [
            {
              "match": "[A-Za-z_][A-Za-z0-9_-]*",
              "name": "variable.other.service.feat"
            },
            {
              "match": ",",
              "name": "punctuation.separator.comma.feat"
            }
          ]
        }
      ]
    },
    "sections": {
      "patterns": [
        {
          "match": "^\\s*(construct|enforce|contract|variables|given|examples)\\s*:\\s*$",
          "captures": {
            "1": {
              "name": "keyword.control.section.feat"
            }
          }
        },
        {
          "match": "^\\s*(handler[ \\t]+at)[ \\t]+\\S+\\s*$",
          "captures": {
            "1": {
              "name": "keyword.other.directive.feat"
            }
          }
        },
        {
          "match": "^\\s*(imports)[ \\t]+\\S+[ \\t]+(from)[ \\t]+\\S+\\s*$",
          "captures": {
            "1": {
              "name": "keyword.other.directive.feat"
            },
            "2": {
              "name": "keyword.other.directive.feat"
            }
          }
        },
        {
          "match": "^\\s*(register)[ \\t]+\\S+[ \\t]+\\S+[ \\t]+(in)[ \\t]+\\S+\\s*$",
          "captures": {
            "1": {
              "name": "keyword.other.directive.feat"
            },
            "2": {
              "name": "keyword.other.directive.feat"
            }
          }
        },
        {
          "match": "^\\s*(emit[ \\t]+to)[ \\t]+\\S+\\s*$",
          "captures": {
            "1": {
              "name": "keyword.other.directive.feat"
            }
          }
        },
        {
          "match": "^\\s*(touches|needs)[ \\t]+\\S+\\s*$",
          "captures": {
            "1": {
              "name": "keyword.other.directive.feat"
            }
          }
        },
        {
          "match": "^\\s*(rejects)\\b",
          "captures": {
            "1": {
              "name": "keyword.other.directive.feat"
            }
          }
        },
        {
          "comment": "contract: entries",
          "match": "^\\s*(input|response|record|event|error)[ \\t]+[A-Za-z_][A-Za-z0-9_]*(?:[ \\t]+(from)(?=[ \\t]+\"))?",
          "captures": {
            "1": {
              "name": "keyword.other.directive.feat"
            },
            "2": {
              "name": "keyword.other.directive.feat"
            }
          }
        },
        {
          "match": "^\\s*(stream)(?=[ \\t]+\")",
          "captures": {
            "1": {
              "name": "keyword.other.directive.feat"
            }
          }
        },
        {
          "comment": "given: seed <service> from \"<path>\"",
          "match": "^\\s*(seed)[ \\t]+([A-Za-z_][A-Za-z0-9_]*)[ \\t]+(from)(?=[ \\t]+\")",
          "captures": {
            "1": {
              "name": "keyword.other.directive.feat"
            },
            "2": {
              "name": "variable.other.service.feat"
            },
            "3": {
              "name": "keyword.other.directive.feat"
            }
          }
        },
        {
          "comment": "given: seed <service> [ … ]",
          "match": "^\\s*(seed)[ \\t]+([A-Za-z_][A-Za-z0-9_]*)(?=[ \\t]*\\[)",
          "captures": {
            "1": {
              "name": "keyword.other.directive.feat"
            },
            "2": {
              "name": "variable.other.service.feat"
            }
          }
        },
        {
          "match": "^\\s*(random[ \\t]+seed)(?=[ \\t]|$)",
          "captures": {
            "1": {
              "name": "keyword.other.directive.feat"
            }
          }
        },
        {
          "match": "^\\s*(clock[ \\t]+at)(?=[ \\t]|$)",
          "captures": {
            "1": {
              "name": "keyword.other.directive.feat"
            }
          }
        },
        {
          "match": "^\\s*(execute)(?=[ \\t]*\\([ \\t]*as\\b|[ \\t]+[A-Za-z_][A-Za-z0-9_]*[ \\t]*\\{)",
          "captures": {
            "1": {
              "name": "keyword.other.directive.feat"
            }
          }
        },
        {
          "comment": "ADR-0023: fault <service> <Operation> <Fault> [{ json }] [once | times <n> | until reset]",
          "begin": "^\\s*(fault)(?=[ \\t]|$)",
          "beginCaptures": {
            "1": {
              "name": "keyword.other.directive.feat"
            }
          },
          "end": "$",
          "patterns": [
            {
              "match": "(?<=[ \\t])(once|until[ \\t]+reset)(?=[ \\t]*$)",
              "name": "keyword.other.fault-count.feat"
            },
            {
              "match": "(?<=[ \\t])(times)(?=[ \\t]+[0-9]+[ \\t]*$)",
              "name": "keyword.other.fault-count.feat"
            },
            {
              "include": "#strings"
            },
            {
              "include": "#numbers"
            }
          ]
        }
      ]
    },
    "scenario": {
      "patterns": [
        {
          "match": "^\\s*(scenario)(\\s+outline)?\\s+(\".*\")\\s*:",
          "captures": {
            "1": {
              "name": "keyword.control.scenario.feat"
            },
            "2": {
              "name": "keyword.control.scenario.feat"
            },
            "3": {
              "name": "string.quoted.double.scenario-name.feat"
            }
          }
        }
      ]
    },
    "trigger": {
      "patterns": [
        {
          "match": "^\\s*(when)[ \\t]*(?:\\((as)[ \\t]+([A-Za-z0-9_-]+)\\))?[ \\t]*:[ \\t]*([A-Za-z_][A-Za-z0-9_]*)?",
          "captures": {
            "1": {
              "name": "keyword.control.trigger.feat"
            },
            "2": {
              "name": "keyword.other.actor.feat"
            },
            "3": {
              "name": "variable.other.actor.feat"
            },
            "4": {
              "name": "entity.name.function.command.feat"
            }
          }
        },
        {
          "comment": "ADR-0036: `to response` names the response role, never a service",
          "begin": "^\\s*(deliver)[ \\t]+([A-Za-z_][A-Za-z0-9_]*)",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.trigger.feat"
            },
            "2": {
              "name": "entity.name.function.event.feat"
            }
          },
          "end": "(?:(?<=[ \\t}])(to)[ \\t]+(?:(response)|([A-Za-z_][A-Za-z0-9_]*))[ \\t]*$)|$",
          "endCaptures": {
            "1": {
              "name": "keyword.control.trigger.feat"
            },
            "2": {
              "name": "keyword.other.response.feat"
            },
            "3": {
              "name": "variable.other.service.feat"
            }
          },
          "patterns": [
            {
              "include": "#refs"
            },
            {
              "include": "#placeholders"
            },
            {
              "include": "#strings"
            },
            {
              "include": "#numbers"
            }
          ]
        },
        {
          "match": "\\b(as)\\s+(\\w+)",
          "captures": {
            "1": {
              "name": "keyword.other.actor.feat"
            },
            "2": {
              "name": "variable.other.actor.feat"
            }
          }
        }
      ]
    },
    "prediction": {
      "patterns": [
        {
          "match": "^\\s*(predict)\\s+(success|error)\\b(\\s+[A-Z0-9_]+)?",
          "captures": {
            "1": {
              "name": "keyword.control.predict.feat"
            },
            "2": {
              "name": "constant.language.prediction-type.feat"
            },
            "3": {
              "name": "constant.other.error-code.feat"
            }
          }
        },
        {
          "match": "^\\s*(predict)\\s+(rejection)\\s+(<?[A-Za-z0-9_-]+>?)",
          "captures": {
            "1": {
              "name": "keyword.control.predict.feat"
            },
            "2": {
              "name": "constant.language.prediction-type.feat"
            },
            "3": {
              "name": "constant.other.rejection-id.feat"
            }
          }
        },
        {
          "match": "^\\s*(response)\\s+(\\w+)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.other.response.feat"
            },
            "2": {
              "name": "constant.numeric.status.feat"
            },
            "3": {
              "name": "entity.name.type.schema.feat"
            }
          }
        },
        {
          "match": "^\\s*([A-Za-z_][A-Za-z0-9_]*)\\s+(has|contains)\\b(?:\\s+(ordered|unordered)\\b)?",
          "captures": {
            "1": {
              "name": "variable.other.service.feat"
            },
            "2": {
              "name": "keyword.other.assertion.feat"
            },
            "3": {
              "name": "keyword.other.ordering.feat"
            }
          }
        },
        {
          "comment": "a record in a list: <Type> with <Schema>, the type dotted or lowercase (ADR-0015)",
          "match": "(?<=[\\[,])[ \\t]*([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)[ \\t]+(with)[ \\t]+([A-Z][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "entity.name.type.record.feat"
            },
            "2": {
              "name": "keyword.other.with.feat"
            },
            "3": {
              "name": "entity.name.type.schema.feat"
            }
          }
        },
        {
          "comment": "a record that opens a line of a multi-line list, before its block",
          "match": "^[ \\t]*([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)[ \\t]+(with)[ \\t]+([A-Z][A-Za-z0-9_]*)(?=[ \\t]*(?:\\{|partial\\b|equals[ \\t]+fixture\\b))",
          "captures": {
            "1": {
              "name": "entity.name.type.record.feat"
            },
            "2": {
              "name": "keyword.other.with.feat"
            },
            "3": {
              "name": "entity.name.type.schema.feat"
            }
          }
        }
      ]
    },
    "matchers": {
      "patterns": [
        {
          "comment": "`any` with or without a type, in a field's value position or as a list item",
          "match": "(?<=[:\\[,])[ \\t]*(any)\\b(?:[ \\t]+(uuid|timestamp|string|number|boolean)\\b)?",
          "captures": {
            "1": {
              "name": "support.function.matcher.feat"
            },
            "2": {
              "name": "support.type.matcher.feat"
            }
          }
        },
        {
          "match": "\\b(any)\\s+(uuid|timestamp|string|number|boolean)\\b",
          "captures": {
            "1": {
              "name": "support.function.matcher.feat"
            },
            "2": {
              "name": "support.type.matcher.feat"
            }
          }
        },
        {
          "match": "\\b(matching|absent)\\b",
          "name": "support.function.matcher.feat"
        },
        {
          "match": "(?:(?<=[:\\[])|(?<=,)(?=\\s*not[ \\t]+(?:[\"@<\\[0-9-]|any\\b|matching\\b|true\\b|false\\b|null\\b)))\\s*\\b(not)\\b(?=[ \\t])",
          "captures": {
            "1": {
              "name": "support.function.matcher.feat"
            }
          }
        },
        {
          "match": "\\b(f32)[ \\t]+[0-9]+[ \\t]+(sha256)\\b(?=[ \\t]+\")",
          "captures": {
            "1": {
              "name": "support.function.matcher.feat"
            },
            "2": {
              "name": "support.function.matcher.feat"
            }
          }
        },
        {
          "match": "\\b(equals fixture)\\b",
          "name": "support.function.matcher.feat"
        },
        {
          "match": "(?<=[A-Za-z0-9_][ \\t])(partial)\\b(?=[ \\t]*\\{)",
          "captures": {
            "1": {
              "name": "support.function.matcher.feat"
            }
          }
        }
      ]
    },
    "refs": {
      "patterns": [
        {
          "match": "@(when|deliver|given|[A-Za-z][A-Za-z0-9_-]*)(\\[\\d+\\])?(\\.[A-Za-z0-9_.]+)?",
          "name": "variable.language.stimulus-ref.feat"
        }
      ]
    },
    "placeholders": {
      "patterns": [
        {
          "match": "<[A-Za-z_][A-Za-z0-9_-]*>",
          "name": "variable.parameter.placeholder.feat"
        }
      ]
    },
    "strings": {
      "comment": "ADR-0040: a JSON string; ADR-0017: a ${name} spec-variable reference is written inside one",
      "begin": "\"",
      "end": "\"|$",
      "name": "string.quoted.double.feat",
      "patterns": [
        {
          "match": "\\\\(?:[\"\\\\/bfnrt]|u[0-9A-Fa-f]{4})",
          "name": "constant.character.escape.feat"
        },
        {
          "match": "\\$\\{[A-Za-z_][A-Za-z0-9_]*\\}",
          "name": "variable.parameter.placeholder.feat"
        }
      ]
    },
    "numbers": {
      "match": "\\b\\d+(\\.\\d+)?\\b",
      "name": "constant.numeric.feat"
    }
  }
}
