{
  "name": "feat-vscode",
  "displayName": "Feature — execution specifications",
  "description": "Syntax highlighting and live spec-anchored test feedback for .feat files",
  "version": "0.18.0",
  "publisher": "mmmnt",
  "license": "BSD-3-Clause",
  "homepage": "https://feature.mmmnt.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mmmnt/feature.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Testing"
  ],
  "activationEvents": [
    "workspaceContains:**/feat.config.json"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "feat",
        "aliases": [
          "Feat",
          "feat"
        ],
        "extensions": [
          ".feat"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "feat",
        "scopeName": "source.feat",
        "path": "./syntaxes/feat.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "feat.watch.start",
        "title": "Feat: Start watch"
      },
      {
        "command": "feat.watch.stop",
        "title": "Feat: Stop watch"
      }
    ],
    "configuration": {
      "title": "Feat",
      "properties": {
        "feat.watch.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Start `feat watch --json` automatically when a feat.config.json is present."
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts-sync-grammar.mjs && tsc -p tsconfig.json",
    "test": "npm run build && node --test \"test/**/*.test.mjs\"",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^26.6.10",
    "@types/vscode": "~1.85.0",
    "typescript": "^7.0.2"
  },
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#4FC7B0",
    "theme": "dark"
  },
  "keywords": [
    "feat",
    "specification",
    "spec-driven",
    "testing",
    "tdd",
    "e2e",
    "dsl",
    "prediction"
  ]
}
