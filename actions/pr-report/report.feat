feat 1.0

# SPEC-PRR-001 — the pull request build report Action (actions/pr-report). Agreed 2026-11-17 by the founder's flip
# ("Agree as drafted (Recommended)").
# (ADR-0032-DRAFT; requested 2026-11-17: "I review all PRs, but I won't go through the code … get it into a friendly
# format, into the PR"; form ruled "GitHub Action in Feature (Recommended)"). Revised 2026-11-17 on the founder's
# feedback: "we need more detail on the attestations. digest is truncated, and we need to make alignment from the
# signature to the PR ref so we can establish an easy chain of evidence for an auditor."
#
# Amended 2026-11-17 by the founder's flip ("Agree as drafted (Recommended)"; the missing-SBOM check conclusion
# confirmed "Neutral (Recommended)") — two rulings in one amendment (ADR-0032 decisions 13–14):
# (1) "Sign with our own key" (flmnt f1530c7d): GitHub artifact attestations are not available to the consumer, so
# attestations are signed with the consumer's own cosign key, stored as OCI referrers in GHCR, verified with
# `cosign verify-attestation --key`; no public transparency log. The tlog link becomes the key link.
# (2) "Add the scenario": evidence present but
# an expected attestation subject not produced (flmnt's SBOM, from its build job) is an explicit incomplete result,
# "❌ incomplete: SBOM not produced (job build)", never a pass and never a report that is not posted. The consumer names
# its required subjects (input `required-subjects: SBOM from build`); the probe step `sbom:missing` is that case.
# Verify command amended 2026-11-17 by founder ruling "Add the flag": cosign verify-attestation fails on an attestation
# with no transparency-log entry unless given --insecure-ignore-tlog, so the rendered command carries it.
# Amended 2026-11-17 after the first real report (flmnt#145), three founder rulings:
# (A) "Accept a newer base (Recommended)": the event's base sha is a snapshot; GitHub builds the merge ref on the
#     base branch's tip at that time, so a first parent on the base branch (the event's base or newer) holds the link.
# (B) "Leave them out (Recommended)": jobs still running because they wait on the report, and the report's own check
#     run, are not tallied among the CI jobs.
# (C) "One row per bundle, named (Recommended)": a bundle that names its package is a Tests row `<tier> · <package>`.
# Amended 2026-11-18 by founder ruling "Action reads .att too (Recommended)": cosign 2's classic key signing keeps its
# attestations as the layers of the subject's `sha256-<hex>.att` tag, not as OCI referrers (flmnt#145's first signed
# SBOM read "chain broken at signature" for it); with no referrer, the Action reads that tag.
# Amended 2026-11-18 by founder ruling "Two-run merge mode (Recommended)": the run on a push to main (report-main)
# never holds the signing key. It writes the merge statement unsigned, records its digest as the main check's
# external_id and points the pull request at it with "signature pending (job sign-merge)"; a separate sign run
# (input `sign-statement`, job sign-merge) signs exactly that statement for that main commit, or refuses
# STATEMENT_MISMATCH with no effect.
# Corrected 2026-11-19 after flmnt's first merge to main (run 44446177926, "run 44441336322 has no attested
# artifacts"): the pulls API names no merge commit a pull request's run tested (its merge_commit_sha is the commit on
# main; the probe's merge_ref_sha was invented). Merge mode reads the tested commit from the pull request run's own
# feat report check on the head: its external_id, which PR mode now sets to the built commit, else the "built `<ref>` @
# `<sha>`" of an older check's summary. The probe's pulls response has the real shape; `prcheck:summary` is an older
# check with no external_id.
# Under (A) a first parent other than the event's base is compared with the base branch before the link is judged,
# so the badparents scenario's trace gains that compare (`0badc0de…` is not on main: diverged, the link still breaks).
# Driven through actions/pr-report/fixtures/probe.mjs (part of the build, inside touches, not shipped). The probe runs
# the Action's entry with a recorded GitHub API, a recorded GHCR referrers listing and recorded cosign results (no network): every request is
# answered from a fixture, and the trace lists the requests made, in order, as `METHOD path`.
# `ProbePrReport { script }` runs a space-separated script:
#   pr:<n>                     the run belongs to pull request <n>: head 9f2c41d8a07e5b3c6d1f0e2a4b8c7d9e1f3a5b6c, base
#                              4e1a9c3b7d2f6e0a8c5b1d9f3e7a2c6b0d4f8e1a, built ref refs/pull/<n>/merge, built commit
#                              c0ffee12a3b4c5d6e7f8091a2b3c4d5e6f708192; `push:topic` = a push to a branch other than main
#   main:<sha>                 merge mode: the run is a push to main at <sha> (main sha below:
#                              5e8d1f2a3b4c5d6e7f8091a2b3c4d5e6f7081a2b)
#   prlookup:found|notfound    the pull request associated with the main commit (#7, merged from head
#                              9f2c41d8a07e5b3c6d1f0e2a4b8c7d9e1f3a5b6c, tested merge ref commit
#                              c0ffee12a3b4c5d6e7f8091a2b3c4d5e6f708192, PR run 44153523061), or none
#   prcheck:summary            the pull request head's feat report check has no external_id; its summary names the
#                              built commit (a check posted before the Action recorded it)
#   mainattest:good|wrongsource  main's build attestation: source commit = main sha, or another commit
#   prattest:present|missing   the PR run's attestation digests are, or are not, retrievable
#   ghcr:ok|fail               merge mode: storing main's evidence bundles in GHCR as a digest-pinned OCI artifact succeeds or fails
#   fork:<n>                   follow-up mode: a trusted `workflow_run` run reporting on fork pull request <n> from the
#                              results its `pull_request` run uploaded; no fork code is checked out or run
#   merge:good|badparents      the built commit's parents are [base, head], or are not
#   merge:basemoved            the built commit's parents are [1f2e3d4c5b6a79880a1b2c3d4e5f60718293a4b5, head]: the base
#                              branch (main) moved past the event's base, and that commit is on it (compare: behind)
#   merge:offbranch            as basemoved, but the first parent is not on the base branch (compare: diverged)
#   evidence:<tier>:<fixture>[:<package>]  an uploaded feat-evidence/2 bundle for that tier, of that package when named: `pass`, `fail` (one scenario fails
#                              with one violation row), `noruns` (verify pass, no run block)
#   jobs:<fixture>             the run's jobs: `green` (install, lint, unit, harness all succeed), `red` (harness fails),
#                              `aggregate` (green, plus `CI green` still in progress because it needs the report, and
#                              the report's own `feat report` check run, concluded failure)
#   attest:<fixture>           cosign attestations (OCI referrers in GHCR) for the run's artifact (subject
#                              sha256:3a7bd3e2360a3d29eea436fcfb7e44c735d117c42d1c1835420b6b9942dd4f1b): `verified`;
#                              `unverified` (cosign verify --key fails); `wrongsource` (provenance gitCommit is
#                              0badc0de1a2b3c4d5e6f708192a3b4c5d6e7f809); `foreignsigner` (the provenance names another
#                              repository's workflow); `otherkey` (signed by a key other than the repository's
#                              public key); `classic` (no OCI referrer; one attestation held by cosign's classic
#                              `.att` tag, layer sha256:4c6cc238681fcaf230c2a643479538ace0bc675f0eb2b24b083dbccce260956c);
#                              `none` (no attestation)
#   comment:<id>|none          an earlier report comment carrying the marker exists with that id, or none does
#   token:full|readonly        the token's granted permissions (readonly = what a fork pull request receives)
#   sbom:missing               the run was required to produce the SBOM (job build) and did not: no subject
#   sign:good|othermain|tampered  sign mode on main 5e8d1f2a3b4c5d6e7f8091a2b3c4d5e6f7081a2b: the statement report-main
#                              wrote (`good`), one naming another main commit (`othermain`), or one whose bytes differ
#                              from what main's check (id 77) recorded (`tampered`)
#   go                         run the Action
# After `go` the trace carries `verdict=<pass|fail|incomplete>`, `chain=<ok|broken:<link>>` and `sections=<names>`;
# `body` is the rendered comment's markdown and `check` the check run's conclusion.

spec SPEC-PRR-001 "PR build report: one updating comment and a check summary, with an auditable chain of evidence"
context Toolchain
aggregate Reporting
type infrastructure
status agreed

construct:
  handler at actions/pr-report/src/index.ts
  touches actions/pr-report/**
  Read every uploaded feat-evidence bundle (one per tier), the workflow run's jobs, the built commit, and the
  attestations of the run's artifacts (OCI referrers of the subject, else the layers of cosign's classic
  `sha256-<hex>.att` tag); verify each attestation with cosign against the repository's public key (`ci/signing/<key>.pub`): the signature,
  the key's fingerprint, the signer workflow and the provenance source; render one markdown report and post it as ONE pull
  request comment found again by the marker `<!-- feat-pr-report -->` (update in place, else create), and as the
  summary of a check run named `feat report` whose conclusion is the verdict.
  The comment is compact and evidential, with no prose: a header (verdict and PR number; head commit, built ref and
  built commit, run link); Tests (per tier: specs, scenarios passed, evidence bundle digest; CI jobs passed); Attestations
  (per artifact: name, full subject digest, signature digest, key fingerprint, signer workflow@ref, source commit,
  verified); Chain (one row per
  check: built commit parents = base + head, each source commit = built commit, signer = this repository's workflow,
  key = the repository's public key, pinned images = the pin file); and a collapsed Verify block with the
  `cosign verify-attestation --key ci/signing/flmnt.pub --insecure-ignore-tlog --type slsaprovenance1 ghcr.io/<o>/<r>-sbom@sha256:<full>`
  command. On failure only the header and the failing row change. After merge one line is appended: merged as the
  main commit, the merge statement's signature digest, a link to the main report. Full detail (the full provenance,
  the referrer manifests) stays in the evidence bundle and the
  attestations, not in the comment. Every digest and commit SHA is printed in full, never shortened.
  The verdict is pass only when every tier's bundle has verify pass and run pass, every job succeeded, and every
  link of the chain holds; fail when any of them failed or any link is broken; incomplete when evidence or a run is
  missing.

enforce:
  exactly one report comment exists on the pull request after any number of runs
  the check run's conclusion equals the report's verdict
  every digest and commit SHA in the report is printed in full
  the comment holds only the header, Tests, Attestations, Chain and Verify sections, and on failure differs from a pass only in its header and failing rows
  the provenance's source commit must equal the commit the run built, or the chain is broken at the provenance link
  the signer must be one of this repository's workflows at the built ref, or the chain is broken at the signer link
  an attestation signed by any key other than the repository's public key breaks the chain at the key link
  there is no transparency log: no step reads or writes one
  a subject's attestations are its OCI referrers; with none, the layers of its classic `.att` tag; with neither, it has no attestation
  the built commit's first parent must be a commit on the base branch (the event's base or newer) and its second the head, or the chain is broken at the built-commit link
  jobs still in progress because they wait on the report, and the report's own check run, are not tallied among the CI jobs
  each evidence bundle is one Tests row, named `<tier> · <package>` when the bundle names its package
  a required attestation subject the run did not produce makes the verdict incomplete, and the header names it and the job that should have produced it
  on a push to main the Action writes one merge statement naming the pull request number, its head commit, the
  tested merge-ref commit, the pull request run and its attestation digests, the main commit and main's artifact
  digests; posts a check run on the main commit in the same report format, recording the statement's digest as its
  external_id; and appends "merged as <main sha>" with the statement's full digest and "signature pending (job
  sign-merge)" to the closed pull request's report comment
  the merge statement is signed only in sign mode, never in the run that writes it
  sign mode signs exactly the statement whose digest main's check recorded, for the run's main commit, then appends
  the signature's digest to that check and to the pull request's comment
  rejects STATEMENT_MISMATCH when the statement names another main commit, or its digest is not the one main's check recorded, and nothing is signed or posted
  main's build attestation must have the main commit as its source, or the chain is broken at the main-provenance link
  the tested merge-ref commit is the one the pull request run's feat report check recorded (its external_id, else the built commit its summary names); a pull request whose check records none rejects PR_EVIDENCE_MISSING
  rejects NO_PR_CONTEXT when the run is neither a pull request nor a push to main, and nothing is posted
  rejects NO_PR_FOR_MERGE when no merged pull request is associated with the main commit, and nothing is signed or posted
  rejects PR_EVIDENCE_MISSING when the pull request run's attestations cannot be retrieved, and nothing is signed or posted
  on a push to main the evidence bundles are stored in GHCR as a digest-pinned OCI artifact before the merge-linking attestation is signed, and that digest is named in it
  rejects EVIDENCE_STORE_FAILED when the evidence bundles cannot be stored in GHCR, and nothing is signed or posted
  a fork pull request is reported by a trusted workflow_run follow-up from the uploaded results only; it never checks out or runs the fork's code, and shows attestations as "not attested (fork PR); attested on merge"
  rejects NO_EVIDENCE when no evidence bundle was uploaded, and nothing is posted
  rejects INSUFFICIENT_PERMISSIONS when the token cannot write pull request comments or check runs, and nothing is posted

contract:
  input ProbeInput
  response ProbeResult
  error ReportError

scenario "a green build with an unbroken chain posts a new report comment and a passing check":
  when: ProbePrReport { script: "pr:7 merge:good evidence:unit:pass evidence:integration:pass jobs:green attest:verified comment:none token:full go" }
  predict success:
    response OK ProbeResult {
      trace: "GET /repos/o/r/actions/runs/1/attempts/1/jobs GET /repos/o/r/commits/c0ffee12a3b4c5d6e7f8091a2b3c4d5e6f708192 GET ghcr.io/o/r/referrers/sha256:3a7bd3e2360a3d29eea436fcfb7e44c735d117c42d1c1835420b6b9942dd4f1b GET /repos/o/r/issues/7/comments POST /repos/o/r/issues/7/comments POST /repos/o/r/check-runs verdict=pass chain=ok sections=header,tests,attestations,chain,verify"
      check: "success"
    }
    filesystem has []

scenario "a second run updates the same comment instead of adding one":
  when: ProbePrReport { script: "pr:7 merge:good evidence:unit:pass jobs:green attest:verified comment:901 token:full go" }
  predict success:
    response OK ProbeResult {
      trace: "GET /repos/o/r/actions/runs/1/attempts/1/jobs GET /repos/o/r/commits/c0ffee12a3b4c5d6e7f8091a2b3c4d5e6f708192 GET ghcr.io/o/r/referrers/sha256:3a7bd3e2360a3d29eea436fcfb7e44c735d117c42d1c1835420b6b9942dd4f1b GET /repos/o/r/issues/7/comments PATCH /repos/o/r/issues/comments/901 POST /repos/o/r/check-runs verdict=pass chain=ok sections=header,tests,attestations,chain,verify"
      check: "success"
    }
    filesystem has []

scenario "the report prints every digest and commit in full":
  when: ProbePrReport { script: "pr:7 merge:good evidence:unit:pass jobs:green attest:verified comment:none token:full go" }
  predict success:
    response OK ProbeResult {
      trace: any string
      body: matching "sha256:3a7bd3e2360a3d29eea436fcfb7e44c735d117c42d1c1835420b6b9942dd4f1b"
      check: "success"
    }
    filesystem has []

scenario "a failing scenario shows its violation and fails the check":
  when: ProbePrReport { script: "pr:7 merge:good evidence:unit:pass evidence:integration:fail jobs:red attest:verified comment:none token:full go" }
  predict success:
    response OK ProbeResult {
      trace: "GET /repos/o/r/actions/runs/1/attempts/1/jobs GET /repos/o/r/commits/c0ffee12a3b4c5d6e7f8091a2b3c4d5e6f708192 GET ghcr.io/o/r/referrers/sha256:3a7bd3e2360a3d29eea436fcfb7e44c735d117c42d1c1835420b6b9942dd4f1b GET /repos/o/r/issues/7/comments POST /repos/o/r/issues/7/comments POST /repos/o/r/check-runs verdict=fail chain=ok sections=header,tests,attestations,chain,verify"
      check: "failure"
    }
    filesystem has []

scenario "an attestation whose signature fails verification breaks the chain":
  when: ProbePrReport { script: "pr:7 merge:good evidence:unit:pass jobs:green attest:unverified comment:none token:full go" }
  predict success:
    response OK ProbeResult {
      trace: "GET /repos/o/r/actions/runs/1/attempts/1/jobs GET /repos/o/r/commits/c0ffee12a3b4c5d6e7f8091a2b3c4d5e6f708192 GET ghcr.io/o/r/referrers/sha256:3a7bd3e2360a3d29eea436fcfb7e44c735d117c42d1c1835420b6b9942dd4f1b GET /repos/o/r/issues/7/comments POST /repos/o/r/issues/7/comments POST /repos/o/r/check-runs verdict=fail chain=broken:signature sections=header,tests,attestations,chain,verify"
      check: "failure"
    }
    filesystem has []

scenario "a provenance source commit other than the built commit breaks the chain":
  when: ProbePrReport { script: "pr:7 merge:good evidence:unit:pass jobs:green attest:wrongsource comment:none token:full go" }
  predict success:
    response OK ProbeResult {
      trace: "GET /repos/o/r/actions/runs/1/attempts/1/jobs GET /repos/o/r/commits/c0ffee12a3b4c5d6e7f8091a2b3c4d5e6f708192 GET ghcr.io/o/r/referrers/sha256:3a7bd3e2360a3d29eea436fcfb7e44c735d117c42d1c1835420b6b9942dd4f1b GET /repos/o/r/issues/7/comments POST /repos/o/r/issues/7/comments POST /repos/o/r/check-runs verdict=fail chain=broken:provenance sections=header,tests,attestations,chain,verify"
      check: "failure"
    }
    filesystem has []

scenario "a signer that is not this repository's workflow breaks the chain":
  when: ProbePrReport { script: "pr:7 merge:good evidence:unit:pass jobs:green attest:foreignsigner comment:none token:full go" }
  predict success:
    response OK ProbeResult {
      trace: "GET /repos/o/r/actions/runs/1/attempts/1/jobs GET /repos/o/r/commits/c0ffee12a3b4c5d6e7f8091a2b3c4d5e6f708192 GET ghcr.io/o/r/referrers/sha256:3a7bd3e2360a3d29eea436fcfb7e44c735d117c42d1c1835420b6b9942dd4f1b GET /repos/o/r/issues/7/comments POST /repos/o/r/issues/7/comments POST /repos/o/r/check-runs verdict=fail chain=broken:signer sections=header,tests,attestations,chain,verify"
      check: "failure"
    }
    filesystem has []

scenario "an attestation signed by another key breaks the chain":
  when: ProbePrReport { script: "pr:7 merge:good evidence:unit:pass jobs:green attest:otherkey comment:none token:full go" }
  predict success:
    response OK ProbeResult {
      trace: "GET /repos/o/r/actions/runs/1/attempts/1/jobs GET /repos/o/r/commits/c0ffee12a3b4c5d6e7f8091a2b3c4d5e6f708192 GET ghcr.io/o/r/referrers/sha256:3a7bd3e2360a3d29eea436fcfb7e44c735d117c42d1c1835420b6b9942dd4f1b GET /repos/o/r/issues/7/comments POST /repos/o/r/issues/7/comments POST /repos/o/r/check-runs verdict=fail chain=broken:key sections=header,tests,attestations,chain,verify"
      check: "failure"
    }
    filesystem has []

scenario "a built commit whose parents are not the PR's base and head breaks the chain":
  when: ProbePrReport { script: "pr:7 merge:badparents evidence:unit:pass jobs:green attest:verified comment:none token:full go" }
  predict success:
    response OK ProbeResult {
      trace: "GET /repos/o/r/actions/runs/1/attempts/1/jobs GET /repos/o/r/commits/c0ffee12a3b4c5d6e7f8091a2b3c4d5e6f708192 GET /repos/o/r/compare/main...0badc0de1a2b3c4d5e6f708192a3b4c5d6e7f809 GET ghcr.io/o/r/referrers/sha256:3a7bd3e2360a3d29eea436fcfb7e44c735d117c42d1c1835420b6b9942dd4f1b GET /repos/o/r/issues/7/comments POST /repos/o/r/issues/7/comments POST /repos/o/r/check-runs verdict=fail chain=broken:built-commit sections=header,tests,attestations,chain,verify"
      check: "failure"
    }
    filesystem has []

scenario "a bundle with no run is incomplete, not passing":
  when: ProbePrReport { script: "pr:7 merge:good evidence:unit:noruns jobs:green attest:none comment:none token:full go" }
  predict success:
    response OK ProbeResult {
      trace: "GET /repos/o/r/actions/runs/1/attempts/1/jobs GET /repos/o/r/commits/c0ffee12a3b4c5d6e7f8091a2b3c4d5e6f708192 GET /repos/o/r/issues/7/comments POST /repos/o/r/issues/7/comments POST /repos/o/r/check-runs verdict=incomplete chain=ok sections=header,tests,chain"
      check: "neutral"
    }
    filesystem has []

scenario "a merge to main writes the merge statement, checks main and points the PR at it, the signature left to sign-merge":
  when: ProbePrReport { script: "main:5e8d1f2a3b4c5d6e7f8091a2b3c4d5e6f7081a2b prlookup:found prattest:present ghcr:ok mainattest:good evidence:unit:pass jobs:green comment:901 token:full go" }
  predict success:
    response OK ProbeResult {
      trace: "GET /repos/o/r/actions/runs/1/attempts/1/jobs GET /repos/o/r/commits/5e8d1f2a3b4c5d6e7f8091a2b3c4d5e6f7081a2b/pulls GET /repos/o/r/commits/9f2c41d8a07e5b3c6d1f0e2a4b8c7d9e1f3a5b6c/check-runs?check_name=feat%20report GET /repos/o/r/actions/runs/44153523061/artifacts GET ghcr.io/o/r/referrers/sha256:3a7bd3e2360a3d29eea436fcfb7e44c735d117c42d1c1835420b6b9942dd4f1b GET ghcr.io/o/r/referrers/sha256:9b74c9897bac770ffc029102a200c5de2a4c2a6c2d1e3f4a5b6c7d8e9f0a1b2c PUT ghcr.io/o/r-evidence@sha256:2c26b46b68ffc68ff99b453c1d30413413422d706483bfa0f98a5e886266e7ae WRITE merge-statement POST /repos/o/r/check-runs GET /repos/o/r/issues/7/comments PATCH /repos/o/r/issues/comments/901 verdict=pass chain=ok sections=header,tests,attestations,chain,verify"
      body: matching "signature pending \\(job sign-merge\\)"
      check: "success"
    }
    filesystem has []

scenario "a merge finds the commit the pull request run tested from that run's check, when the check predates its external_id":
  when: ProbePrReport { script: "main:5e8d1f2a3b4c5d6e7f8091a2b3c4d5e6f7081a2b prlookup:found prcheck:summary prattest:present ghcr:ok mainattest:good evidence:unit:pass jobs:green comment:901 token:full go" }
  predict success:
    response OK ProbeResult {
      trace: "GET /repos/o/r/actions/runs/1/attempts/1/jobs GET /repos/o/r/commits/5e8d1f2a3b4c5d6e7f8091a2b3c4d5e6f7081a2b/pulls GET /repos/o/r/commits/9f2c41d8a07e5b3c6d1f0e2a4b8c7d9e1f3a5b6c/check-runs?check_name=feat%20report GET /repos/o/r/actions/runs/44153523061/artifacts GET ghcr.io/o/r/referrers/sha256:3a7bd3e2360a3d29eea436fcfb7e44c735d117c42d1c1835420b6b9942dd4f1b GET ghcr.io/o/r/referrers/sha256:9b74c9897bac770ffc029102a200c5de2a4c2a6c2d1e3f4a5b6c7d8e9f0a1b2c PUT ghcr.io/o/r-evidence@sha256:2c26b46b68ffc68ff99b453c1d30413413422d706483bfa0f98a5e886266e7ae WRITE merge-statement POST /repos/o/r/check-runs GET /repos/o/r/issues/7/comments PATCH /repos/o/r/issues/comments/901 verdict=pass chain=ok sections=header,tests,attestations,chain,verify"
      body: matching "tested `c0ffee12a3b4c5d6e7f8091a2b3c4d5e6f708192`"
      check: "success"
    }
    filesystem has []

scenario "main's build attested for another commit breaks the chain at main's provenance":
  when: ProbePrReport { script: "main:5e8d1f2a3b4c5d6e7f8091a2b3c4d5e6f7081a2b prlookup:found prattest:present ghcr:ok mainattest:wrongsource evidence:unit:pass jobs:green comment:901 token:full go" }
