{
  "$schema": "https://feat.dev/schemas/contract.json",
  "specId": "SPEC-WL-001",
  "schemas": {
    "JoinWaitlistInput": {
      "type": "object",
      "required": ["email"],
      "additionalProperties": false,
      "properties": {
        "email": { "type": "string" }
      }
    },
    "WaitlistReceipt": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "enum": ["pending"] }
      }
    },
    "WaitlistRow": {
      "type": "object",
      "required": ["email", "status"],
      "properties": {
        "email": { "type": "string" },
        "status": { "type": "string" }
      }
    },
    "ErrorResponse": {
      "type": "object",
      "required": ["code"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" }
      }
    }
  }
}
