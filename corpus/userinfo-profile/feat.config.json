{
  "featVersion": "1.0",
  "schemas": { "adapter": "@mmmnt/feat-schema-json" },
  "response": {
    "adapter": "@mmmnt/feat-adapter-handler",
    "commands": {
      "MapUserinfo": { "module": "features/map-userinfo/handler.ts", "export": "mapUserinfo" }
    }
  },
  "services": {
    "artifacts": { "adapter": "@mmmnt/feat-adapter-fs", "consistency": "acid", "options": { "scope": "observed" } }
  },
  "specs": { "dir": ".", "pattern": "*.feat", "contractPattern": "*.contract.json", "outputPattern": "{name}.test.ts" },
  "report": { "format": ["console"] }
}
