{
  "$schema": "https://feat.dev/schemas/contract.json",
  "specId": "SPEC-PAU-001",
  "schemas": {
    "PauseInput": {
      "type": "object",
      "required": ["holder"],
      "additionalProperties": false,
      "properties": { "holder": { "type": "string", "minLength": 1 } }
    },
    "PauseReceipt": {
      "type": "object",
      "required": ["holder"],
      "properties": { "holder": { "type": "string" } }
    },
    "PauseEvent": {
      "type": "object",
      "required": ["holder", "at"],
      "properties": { "holder": { "type": "string" }, "at": { "type": "string" } }
    },
    "PauseEntry": {
      "type": "object",
      "required": ["holder"],
      "properties": { "holder": { "type": "string" } }
    },
    "Refusal": {
      "type": "object",
      "required": ["code"],
      "properties": { "code": { "type": "string" }, "holder": { "type": "string" } }
    }
  }
}
