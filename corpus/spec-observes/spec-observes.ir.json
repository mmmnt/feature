{
  "featVersion": "1.0",
  "identity": {
    "id": "SPEC-PAU-001",
    "name": "PauseWrites holds the node's writes",
    "context": "Lifecycle",
    "aggregate": "Node",
    "type": "command",
    "status": "agreed"
  },
  "observes": [
    "log",
    "cache"
  ],
  "construct": [
    {
      "kind": "handler",
      "path": "features/pause-writes/handler.ts"
    },
    {
      "kind": "touches",
      "glob": "features/pause-writes/**"
    }
  ],
  "enforce": [
    {
      "kind": "constraint",
      "text": "record that writes are paused and hold the pause under the holder"
    },
    {
      "kind": "rejects",
      "rejectionId": "ALREADY_PAUSED",
      "text": "another holder holds the pause"
    }
  ],
  "contract": [
    {
      "kind": "input",
      "schemaName": "PauseInput"
    },
    {
      "kind": "response",
      "schemaName": "PauseReceipt"
    },
    {
      "kind": "event",
      "schemaName": "PauseEvent"
    },
    {
      "kind": "record",
      "schemaName": "PauseEntry"
    },
    {
      "kind": "error",
      "schemaName": "Refusal"
    }
  ],
  "scenarios": [
    {
      "name": "a pause is recorded and held",
      "when": {
        "command": "PauseWrites",
        "payload": {
          "holder": "h-1"
        }
      },
      "prediction": {
        "type": "success",
        "response": {
          "status": 200,
          "schemaName": "PauseReceipt",
          "valueBlock": {
            "holder": {
              "matcher": "whenRef",
              "path": "holder"
            }
          }
        },
        "services": {
          "log": {
            "records": [
              {
                "type": "writes.paused",
                "schemaName": "PauseEvent",
                "valueBlock": {
                  "holder": {
                    "matcher": "whenRef",
                    "path": "holder"
                  },
                  "at": {
                    "matcher": "any",
                    "ofType": "timestamp"
                  }
                }
              }
            ]
          },
          "cache": {
            "records": [
              {
                "type": "PAUSE_SET",
                "schemaName": "PauseEntry",
                "valueBlock": {
                  "holder": {
                    "matcher": "whenRef",
                    "path": "holder"
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "name": "a second holder is refused and nothing changes",
      "given": {
        "executes": [
          {
            "command": "PauseWrites",
            "payload": {
              "holder": "h-1"
            }
          }
        ]
      },
      "when": {
        "command": "PauseWrites",
        "payload": {
          "holder": "h-2"
        }
      },
      "prediction": {
        "type": "rejection",
        "rejectionId": "ALREADY_PAUSED",
        "response": {
          "status": 409,
          "schemaName": "Refusal",
          "valueBlock": {
            "code": {
              "matcher": "literal",
              "value": "ALREADY_PAUSED"
            },
            "holder": {
              "matcher": "literal",
              "value": "h-1"
            }
          }
        },
        "services": {
          "log": {
            "records": []
          },
          "cache": {
            "records": []
          }
        }
      }
    }
  ]
}
