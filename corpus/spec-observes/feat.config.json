{
  "featVersion": "1.0",
  "schemas": { "adapter": "@mmmnt/feat-schema-json" },
  "response": {
    "adapter": "@mmmnt/feat-adapter-handler",
    "commands": {
      "PauseWrites": { "module": "features/pause-writes/handler.ts", "export": "pauseWrites" }
    }
  },
  "services": {
    "log": { "adapter": "@mmmnt/feat-adapter-memory", "consistency": "strong" },
    "cache": { "adapter": "@mmmnt/feat-adapter-memory", "consistency": "strong" },
    "files": { "adapter": "@mmmnt/feat-adapter-fs", "consistency": "acid", "options": { "scope": "out" } }
  },
  "specs": { "dir": ".", "pattern": "*.feat", "contractPattern": "*.contract.json", "outputPattern": "{name}.test.ts" },
  "report": { "format": ["console"] }
}
