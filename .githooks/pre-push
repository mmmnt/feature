#!/usr/bin/env bash
# Before a push, run the ubuntu jobs of .github/workflows/ci.yml on each commit being pushed, in throwaway Linux
# containers (scripts/ci-local.sh). A failing job blocks the push. The one-time setup per clone is in
# README.md ("Local CI before a push").
set -euo pipefail

ROOT=$(git rev-parse --show-toplevel)
ZERO=0000000000000000000000000000000000000000
seen=" "
commits=()
# git feeds one line per ref: <local ref> <local oid> <remote ref> <remote oid>
while read -r local_ref local_oid remote_ref remote_oid; do
  [ -n "${local_oid:-}" ] || continue
  [ "$local_oid" != "$ZERO" ] || continue # a deleted ref pushes no commit
  commit=$(git rev-parse --verify "$local_oid^{commit}" 2>/dev/null) || continue # a tag of a non-commit
  case "$seen" in *" $commit "*) continue ;; esac
  seen="$seen$commit "
  commits+=("$commit")
done

[ "${#commits[@]}" -gt 0 ] || exit 0
for commit in "${commits[@]}"; do
  echo "pre-push: scripts/ci-local.sh --ref $commit"
  "$ROOT/scripts/ci-local.sh" --ref "$commit"
done
