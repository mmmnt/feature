feat 1.0

# SPEC-ADPNEO-003 — Neo4j adapter: the instrument's credential and URI are read from files (an amendment to SPEC-ADPNEO-001, in a
# spec of its own, mirroring SPEC-ADPKUR-005).
# Agreed by founder ruling 2026-11-13, chosen verbatim: "Mirror Kurrent (Recommended)": auth { user (a literal login name),
# passwordFile } beside the variable-name form, uriFile, CREDENTIAL_FILE_UNREADABLE before any connection and never the content,
# exactly one trailing LF or CRLF removed, relative paths against the run's working directory, OPTIONS_INVALID for mixed sources.
# Spec tier, as SPEC-ADPKUR-005: the integration config leaves this file out so it runs once.
# Direction (founder 2026-11-13, "Feature reads a file (Recommended)"): a consumer whose secrets live in files (Docker secrets, a
# mounted secrets directory) hands the adapter a PATH, never a secret and never an environment variable that holds one. The
# environment-variable forms of SPEC-ADPNEO-001 stay, unchanged.
#
# What is added to the options (all paths; no option holds a secret):
#   uriFile             a file whose content is the URI. uriFile is never given with uri or uriEnv. uri and uriEnv given together
#                       keep SPEC-ADPNEO-001's rule (the literal wins); that combination is not refused.
#   auth.passwordFile   with auth.user (a literal login name, not a secret), the instrument's credentials: the password is the file's
#                       content. The environment form `auth: { username, password }` (variable names) is the other form; the two
#                       forms are never mixed in one `auth`, and the file form needs both user and passwordFile.
# The driver takes the credentials as an auth token, never from the URI, so no part of a password is decoded or re-encoded: a
# password is used byte for byte as the file holds it, less the one line ending.
# Exactly which options are refused, all at setup() before any file is read and before any connection, with OPTIONS_INVALID:
#   - uriFile with uri, or uriFile with uriEnv;
#   - an auth naming any of username, password together with any of user, passwordFile;
#   - an auth naming user or passwordFile without the other.
# Reading a file:
#   - A relative path is resolved against the working directory of the run (the project root `feat run` starts in).
#   - The files are read at setup(), after the option rule and before any connection.
#   - Exactly one trailing line ending (LF or CRLF) is removed, nothing else, so a password with inner or leading spaces is kept.
#   - A path that is missing, is a directory, cannot be read, or holds nothing after the line ending is removed is refused at
#     setup() with CREDENTIAL_FILE_UNREADABLE before the adapter connects to anything. The detail names the option and the path
#     and the cause; it never carries the file's content.
#
# Driven through the probe of SPEC-ADPNEO-001 (adapters/neo4j/fixtures/probe.mjs, inside touches, not shipped).
# `ObserveNeo4jCredentials { source, content?, path?, script }` writes a file in a fresh temporary directory and creates the
# adapter from it (keys as SPEC-ADPNEO-001's fixture). A second file always holds the fixture user's password exactly, for the
# sources whose auth is not the subject:
#   source "passwordFile"    { uri: the server, auth: { user, passwordFile: <the file> } }; the file holds the password
#   source "uriFile"         { uriFile: <the file>, auth: { user, passwordFile: <the second file> } }; the file holds the URI
#   source "uriAndFile"      uri and uriFile both
#   source "uriEnvAndFile"   uriEnv and uriFile both
#   source "uriAndEnv"       uri (the server) and uriEnv (a variable naming an unreachable server), auth from the second file
#   source "authMixed"       auth { username: <var>, password: <var>, user, passwordFile }
#   source "authNoUser"      auth { passwordFile } alone
#   content (default "exact")  "exact": the subject alone; "lf": then "\n"; "crlf": then "\r\n"; "empty": nothing; "lfOnly": "\n"
#                              alone; "innerSpace" (passwordFile only): the password of a user the probe creates, which starts
#                              with a space and has one inside, logged in as that user
#   path (default "absolute")  "absolute", "relative" (to the working directory), "missing" (nothing written there), "directory"
#   script                     the steps of SPEC-ADPNEO-001 (setup, start, create, stop, ...)
# The probe never prints a secret. The files and their directory are removed after the case.

spec SPEC-ADPNEO-003 "Neo4j adapter: the instrument's credential and URI are read from files the config names by path"
context Toolchain
aggregate Adapters
type infrastructure
status agreed

construct:
  handler at adapters/neo4j/src/index.ts
  touches adapters/neo4j/**
  touches feat.config.json
  touches feat.integration.config.json
  needs SPEC-ADPNEO-001
  Add `uriFile` (a path) to the adapter's options, and `user` with `passwordFile` (a literal login name and a path) as the second
  form of `options.auth`. Resolve the connection in one place, at setup() after the keys check: first the option rule
  (OPTIONS_INVALID, as listed above); then read any named file (relative to process.cwd()), remove exactly one trailing "\n" or
  "\r\n", and refuse a missing, unreadable, directory or empty file with CREDENTIAL_FILE_UNREADABLE; then connect. The variable
  form of auth is read when the driver is made, as before. Add CREDENTIAL_FILE_UNREADABLE to Neo4jAdapterErrorCode. Document both
  options in the README.

enforce:
  rejects OPTIONS_INVALID when uriFile is given with uri or with uriEnv, before any file is read or any connection
  rejects OPTIONS_INVALID when one auth names any of username and password together with any of user and passwordFile, before any file is read or any connection
  rejects OPTIONS_INVALID when one auth names user or passwordFile without the other
  rejects CREDENTIAL_FILE_UNREADABLE when a named file is missing, is a directory, cannot be read, or is empty after one trailing line ending is removed, before any connection
  the detail of CREDENTIAL_FILE_UNREADABLE names the option and the path and never the file's content
  exactly one trailing LF or CRLF is removed from a file's content and nothing else is trimmed
  a relative path is resolved against the working directory of the run
  uri and uriEnv given together keep SPEC-ADPNEO-001's rule, the literal wins
  the environment-variable forms of SPEC-ADPNEO-001 behave exactly as before

contract:
  input CredentialsInput
  response ObserveResult
  error ObserveError

scenario "a password read from a file connects the instrument, and the system's writes are observed":
  when: ObserveNeo4jCredentials { source: "passwordFile", script: "setup:a start:a create:a:Order:o1 stop:a" }
  predict success:
    response OK ObserveResult { trace: "setup:a start:a create:a stop:a=1", last: "INSERT:Order:o1" }
    filesystem has []

scenario outline "one trailing line ending is removed, so a secret written by echo or an editor still connects":
  when: ObserveNeo4jCredentials { source: "passwordFile", content: <content>, script: "setup:a start:a create:a:Order:o1 stop:a" }
  predict success:
    response OK ObserveResult { trace: "setup:a start:a create:a stop:a=1", last: "INSERT:Order:o1" }
    filesystem has []
  examples:
    | content |
    | "lf"    |
    | "crlf"  |

scenario "nothing but the line ending is trimmed, so a password with a space in it is kept":
  when: ObserveNeo4jCredentials { source: "passwordFile", content: "innerSpace", script: "setup:a start:a create:a:Order:o1 stop:a" }
  predict success:
    response OK ObserveResult { trace: "setup:a start:a create:a stop:a=1", last: "INSERT:Order:o1" }
    filesystem has []

scenario "a relative path is read from the run's working directory":
  when: ObserveNeo4jCredentials { source: "passwordFile", path: "relative", script: "setup:a start:a create:a:Order:o1 stop:a" }
  predict success:
    response OK ObserveResult { trace: "setup:a start:a create:a stop:a=1", last: "INSERT:Order:o1" }
    filesystem has []

scenario outline "a URI read from a file connects, with its line ending removed":
  when: ObserveNeo4jCredentials { source: "uriFile", content: <content>, script: "setup:a start:a create:a:Order:o1 stop:a" }
  predict success:
    response OK ObserveResult { trace: "setup:a start:a create:a stop:a=1", last: "INSERT:Order:o1" }
    filesystem has []
  examples:
    | content |
    | "exact" |
    | "lf"    |

scenario "uri and uriEnv together keep the earlier rule: the literal wins":
  when: ObserveNeo4jCredentials { source: "uriAndEnv", script: "setup:a start:a create:a:Order:o1 stop:a" }
  predict success:
    response OK ObserveResult { trace: "setup:a start:a create:a stop:a=1", last: "INSERT:Order:o1" }
    filesystem has []

scenario outline "a password file that cannot be used is refused before the adapter connects to anything":
  when: ObserveNeo4jCredentials { source: "passwordFile", content: <content>, path: <path>, script: "setup:a" }
  predict rejection CREDENTIAL_FILE_UNREADABLE:
    response ERR ObserveError { code: "CREDENTIAL_FILE_UNREADABLE", detail: matching <detail> }
    filesystem has []
  examples:
    | content  | path        | detail                         |
    | "exact"  | "missing"   | "auth.passwordFile.*missing"   |
    | "exact"  | "directory" | "auth.passwordFile.*directory" |
    | "empty"  | "absolute"  | "auth.passwordFile.*empty"     |
    | "lfOnly" | "absolute"  | "auth.passwordFile.*empty"     |

scenario "a URI file that is missing is refused the same way, naming its option":
  when: ObserveNeo4jCredentials { source: "uriFile", path: "missing", script: "setup:a" }
  predict rejection CREDENTIAL_FILE_UNREADABLE:
    response ERR ObserveError { code: "CREDENTIAL_FILE_UNREADABLE", detail: matching "uriFile.*missing" }
    filesystem has []

scenario outline "a URI file given with another URI source is refused before any file is read":
  when: ObserveNeo4jCredentials { source: <source>, path: "missing", script: "setup:a" }
  predict rejection OPTIONS_INVALID:
    response ERR ObserveError { code: "OPTIONS_INVALID", detail: matching <detail> }
    filesystem has []
  examples:
    | source          | detail          |
    | "uriAndFile"    | "uri, uriFile"  |
    | "uriEnvAndFile" | "uriEnv, uriFile" |

scenario "an auth that mixes variable names with a password file is refused before any file is read":
  when: ObserveNeo4jCredentials { source: "authMixed", path: "missing", script: "setup:a" }
  predict rejection OPTIONS_INVALID:
    response ERR ObserveError { code: "OPTIONS_INVALID", detail: matching "auth.*passwordFile" }
    filesystem has []

scenario "a password file without its user is refused":
  when: ObserveNeo4jCredentials { source: "authNoUser", script: "setup:a" }
  predict rejection OPTIONS_INVALID:
    response ERR ObserveError { code: "OPTIONS_INVALID", detail: matching "user and passwordFile" }
    filesystem has []
