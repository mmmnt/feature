{
  "$schema": "https://feat.dev/schemas/contract.json",
  "specId": "SPEC-ADPNEO-003",
  "schemas": {
    "CredentialsInput": {
      "type": "object",
      "required": [
        "source",
        "script"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "enum": [
            "passwordFile",
            "uriFile",
            "uriAndFile",
            "uriEnvAndFile",
            "uriAndEnv",
            "authMixed",
            "authNoUser"
          ]
        },
        "content": {
          "enum": [
            "exact",
            "lf",
            "crlf",
            "empty",
            "lfOnly",
            "innerSpace"
          ]
        },
        "path": {
          "enum": [
            "absolute",
            "relative",
            "missing",
            "directory"
          ]
        },
        "script": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ObserveResult": {
      "type": "object",
      "required": [
        "trace"
      ],
      "additionalProperties": false,
      "properties": {
        "trace": {
          "type": "string"
        },
        "last": {
          "type": "string"
        }
      }
    },
    "ObserveError": {
      "type": "object",
      "required": [
        "code"
      ],
      "properties": {
        "code": {
          "enum": [
            "CREDENTIAL_FILE_UNREADABLE",
            "OPTIONS_INVALID"
          ]
        },
        "detail": {
          "type": "string"
        }
      }
    }
  }
}
