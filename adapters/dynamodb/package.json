{
  "name": "@mmmnt/feat-adapter-dynamodb",
  "version": "0.1.2",
  "description": "DynamoDB service adapter for Feat: table writes become a capture window via DynamoDB Streams — an unpredicted INSERT/MODIFY/REMOVE fails the suite",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@mmmnt/feat-types": "workspace:^",
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/client-dynamodb-streams": "^3.700.0",
    "@aws-sdk/util-dynamodb": "^3.700.0",
    "@aws-sdk/credential-providers": "^3.700.0",
    "@aws-sdk/types": "^3.700.0"
  },
  "devDependencies": {
    "@mmmnt/feat-runtime": "workspace:^",
    "@mmmnt/feat-adapter-kit": "workspace:^",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mmmnt/feature.git",
    "directory": "adapters/dynamodb"
  },
  "homepage": "https://github.com/mmmnt/feature#readme",
  "bugs": {
    "url": "https://github.com/mmmnt/feature/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
