{
  "$schema": "https://feat.dev/schemas/contract.json",
  "specId": "SPEC-ADPDDB-001",
  "schemas": {
    "ObserveInput": {
      "type": "object",
      "required": [
        "script"
      ],
      "additionalProperties": false,
      "properties": {
        "script": {
          "type": "string",
          "minLength": 1
        },
        "stream": {
          "enum": [
            "on",
            "off"
          ]
        },
        "fence": {
          "type": "boolean"
        },
        "table": {
          "enum": [
            "default",
            "numeric",
            "nostream"
          ]
        },
        "settleTimeoutMs": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "ObserveResult": {
      "type": "object",
      "required": [
        "trace"
      ],
      "additionalProperties": false,
      "properties": {
        "trace": {
          "type": "string"
        },
        "last": {
          "type": "string"
        },
        "peekEqualsStop": {
          "type": "boolean"
        },
        "readVia": {
          "enum": [
            "GetItem",
            "Query",
            "Scan"
          ]
        }
      }
    },
    "ObserveError": {
      "type": "object",
      "required": [
        "code"
      ],
      "properties": {
        "code": {
          "enum": [
            "NAMESPACE_INVALID",
            "NAMESPACE_KEY_NOT_STRING",
            "STREAM_NOT_ENABLED",
            "FAULT_UNSUPPORTED"
          ]
        },
        "detail": {
          "type": "string"
        }
      }
    }
  }
}
