{
  "name": "@mmmnt/feat-adapter-fs",
  "version": "0.18.1",
  "description": "Feat service adapter: filesystem capture (files written during the capture window). Dogfood-critical.",
  "license": "BSD-3-Clause",
  "author": "listenrightmeow <@listenrightmeow> (https://sdd.mmmnt.dev/)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude '**/observe.test.ts' --exclude '**/archive.test.ts' --passWithNoTests"
  },
  "dependencies": {
    "@mmmnt/feat-types": "workspace:^"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mmmnt/feature.git",
    "directory": "adapters/fs"
  },
  "homepage": "https://github.com/mmmnt/feature/tree/main/adapters/fs#readme",
  "bugs": {
    "url": "https://github.com/mmmnt/feature/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22.15"
  },
  "devDependencies": {
    "@mmmnt/feat-adapter-kit": "workspace:^",
    "@mmmnt/feat-runtime": "workspace:^",
    "vitest": "^3.2.0"
  },
  "keywords": [
    "feature",
    "feat",
    "specification",
    "spec-driven-development",
    "testing",
    "vitest",
    "adapter",
    "filesystem"
  ]
}
