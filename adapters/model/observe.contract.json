{
  "$schema": "https://feat.dev/schemas/contract.json",
  "specId": "SPEC-ADPMODEL-001",
  "schemas": {
    "ObserveInput": {
      "type": "object",
      "required": [
        "script"
      ],
      "additionalProperties": false,
      "properties": {
        "script": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "enum": [
            "absolute",
            "relative",
            "missing",
            "unknownKey",
            "notString"
          ]
        },
        "namespace": {
          "enum": [
            "valid",
            "none",
            "bad"
          ]
        }
      }
    },
    "ObserveResult": {
      "type": "object",
      "required": [
        "trace"
      ],
      "additionalProperties": false,
      "properties": {
        "trace": {
          "type": "string"
        },
        "lastTypes": {
          "type": "string"
        },
        "lastPayload": {
          "type": "object"
        }
      }
    },
    "ObserveError": {
      "type": "object",
      "required": [
        "code"
      ],
      "properties": {
        "code": {
          "enum": [
            "OPTIONS_INVALID",
            "NAMESPACE_INVALID",
            "RECORD_MALFORMED"
          ]
        },
        "detail": {
          "type": "string"
        }
      }
    }
  }
}
