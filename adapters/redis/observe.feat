feat 1.0

# SPEC-ADPRDS-001 — the Redis service adapter (@mmmnt/feat-adapter-redis, built on the official node-redis client,
# `redis` 6.3.1). Agreed in advance by founder ruling a78f0662 (HELD-78, "Build the adapter": a Feature cache adapter,
# mirroring the Kurrent and Neo4j adapters, with its credential and CA read from files from day one); amended before
# its first publish by founder ruling 2026-11-15: "Require a user" (the file form of auth always names its user) and
# "Add TLS test now" (a TLS server whose certificate a throwaway CA signs proves a verified connection, and a server
# certificate from another CA is refused).
#
# Amended 2026-11-17, requested by flmnt, whose specs must say which set changed: founder ruling "Key in the payload
# (Recommended)" (halt 52238f1b), and the founder's flip "Agree as drafted (Recommended)": Feat's matchers read a record's payload only (feat-runtime recordMatches), so a record-level
# key cannot be predicted. Every record the adapter reports, diff and state alike, now carries its key inside the payload
# as well: payload { key, kind, value }, key without the namespace prefix; the record-level key stays.
#
# Driven through adapters/redis/fixtures/probe.mjs (part of the build, inside touches, not shipped) against a Redis
# container the TEST starts (redis 7.4.12 pinned by digest, `requirepass` set from the environment inside the
# container, never an argument; an ACL user `spaced` whose password starts with a space and has one inside).
# `ObserveRedis { script, url?, source?, content?, path? }` creates one adapter per namespace named in the script and runs
# a space-separated script. Without `source` the instrument connects by `urlEnv` and `auth { password: <var> }`.
# Steps:
#   setup:<ns> / observes:<ns>
#   seed:<ns>:<kind>:<key>           adapter.seed(): a key of that kind (string v0, set [m0], list [i0], hash {f0: v0},
#                                    zset [{m0, 1}]); `bogus` is no kind, `nokey` as the key leaves values.key out
#   seedmisfit:<ns>:<kind>:<key>     adapter.seed(): a key of that kind whose value does not fit it (string 1, set [1],
#                                    list [], hash {f0: 1}, zset [{m0}]) (founder ruling 0c5cae75)
#   set / sadd / rpush:<ns>:<key>:<value>, hset:<ns>:<key>:<field>:<value>, zadd:<ns>:<key>:<member>:<score>,
#   xadd:<ns>:<key>, del:<ns>:<key>  the SYSTEM writes under the namespace prefix `<ns>:`
#   setraw:<key>:<value>             the SYSTEM writes a key with no namespace prefix
#   start / peek / stop / settle / reset : <ns>
#   read:<ns>[:<key>]                adapter.read() with or without a key hint
#   count:<ns>                       how many keys the namespace holds, as the system sees them
#   fault:<ns>:<Operation>.<FAULT>
# The trace carries the record count for window and read steps and settle true/false. `last` is the last peek or stop as
# `TYPE:key` joined by comma, in key order; `payloads` is the JSON of the last stop's payloads; `read` is the last read as
# `kind:key`; `readVia` is KeyedLookup or NamespaceScan.
# Credentials (`source` set): the probe writes a file in a fresh temporary directory and creates the adapter from it:
#   source "passwordFile"        { url, auth: { user: default, passwordFile: <the file> } } (content "innerSpace": user spaced)
#   source "authNoUser"          { url, auth: { passwordFile } } with no user
#   source "urlFile"             { urlFile: <the file>, auth: { user: default, passwordFile: <a second file> } }
#   source "urlAndFile" / "urlEnvAndFile"   url (or urlEnv) and urlFile both
#   source "authMixed"           auth { password: <var>, passwordFile }
#   source "urlWithCredentials"  a url that carries a password
#   source "tlsCAFilePlain"      tlsCAFile with a redis:// url
#   source "tlsCAFile"           tlsCAFile with the TLS server's rediss:// url; the file holds the CA that signed its certificate
#   source "tlsCAFileOther"      the same, the file holding another throwaway CA's certificate
#   content (default "exact")    "exact", "lf", "crlf", "empty", "lfOnly", "innerSpace" (passwordFile only)
#   path (default "absolute")    "absolute", "relative", "missing", "directory"
# The probe never prints a secret; the files and their directory are removed after the case.
#
# Verified (DESIGN.md): Redis offers no change feed a client can read back for a window (keyspace notifications are
# fire-and-forget pub/sub and carry no values), so the diff is a snapshot comparison and `observes` says `snapshot`.

spec SPEC-ADPRDS-001 "Redis adapter: snapshot diff of the namespace's keys, state, seed, reset, credentials and CA from files"
context Toolchain
aggregate Adapters
type infrastructure
status agreed

construct:
  handler at adapters/redis/src/index.ts
  touches adapters/redis/**
  touches feat.config.json
  touches feat.integration.config.json
  needs SPEC-RT-002
  Declare `observes = { diff: "snapshot", state: true }` and an empty fault catalog: Redis has no fault an adapter can
  arm for one namespace alone (a server-wide setting would fault every other namespace's run).
  Options: `url` (redis:// or rediss://, never carrying credentials), `urlEnv` (a variable's name), `urlFile` (a path),
  `auth` (either `{ username?, password }` variable names or `{ user, passwordFile }`; the file form always names its
  user, `default` for a requirepass server), `tlsCAFile` (a PEM file, only with rediss://, against which the server's
  certificate is verified).
  Namespace: received from the runner (SPEC-RT-006) as the config's top-level `namespace`. Every key the system writes
  for the namespace starts with `<ns>:`; the prefix is never reported.
  startCapture(): SCAN the keys matching `<ns>:*` and read each by its type. peekCapture()/stopCapture(): read again and
  diff by key: added = INSERT, value changed = MODIFY, gone = REMOVE (with the value it had); CapturedRecord { type,
  key: without the prefix, payload: { key, kind, value }, timestamp } (the key in the payload too, so a prediction can
  name it). kind is string (value a string), set (sorted
  members), hash (fields sorted), list (in order) or zset ({ member, score } in score order); any other type is
  KIND_UNSUPPORTED.
  settle(): true with a window open (Redis applies one command at a time, so a command the system has had answered is
  applied before the instrument's next read), false with none. It writes nothing.
  read(query): with `query.expect` entries that each name `key.key`, a lookup of those keys; otherwise every key of the
  namespace. Records { type: kind, key, payload: { key, kind, value } }.
  seed(records): SeedRecord { type: kind, values: { key, value } } written under the prefix in one MULTI, before the
  window; a record whose type is no kind, or whose key is not a non-empty string, is SEED_INVALID, and one whose value does
  not fit its kind is SEED_VALUE_UNSTORABLE (amended by founder ruling 12081c37, the codes split; SPEC-ADPRDS-002;
  its scenario here by founder ruling 0c5cae75, "Add a -001 scenario").
  reset(): UNLINK every key of the namespace, close the window.
  Credentials: a file the options name is read at setup before any connection; relative to the working directory;
  exactly one trailing LF or CRLF is removed and nothing else (the CA file is read as is); a refusal names the option,
  the path and the cause, never the content. The password is given to the client apart from the URL.

enforce:
  rejects NAMESPACE_INVALID when the namespace does not match ^s[0-9a-f]{12}$, the pattern the runner derives (SPEC-RT-006); defensive, the runner never passes another
  rejects REDIS_UNREACHABLE when the server does not answer at setup
  rejects KIND_UNSUPPORTED when a namespaced key holds a type the adapter does not read
  rejects SEED_INVALID when a seed record's type is no kind, or its key is not a non-empty string
  rejects SEED_VALUE_UNSTORABLE when a seed record's value does not fit its kind (SPEC-ADPRDS-002)
  rejects FAULT_UNSUPPORTED when any fault is armed (the catalog is empty)
  rejects OPTIONS_INVALID when urlFile is given with another url source, auth mixes its two forms, the file form names no user, the url carries credentials, or tlsCAFile is given without rediss://
  a rediss:// connection verifies the server's certificate against tlsCAFile, and one signed by another CA does not connect
  rejects CREDENTIAL_FILE_UNREADABLE when a file the options name is missing, a directory, unreadable or empty
  capture and read are restricted to keys carrying the namespace prefix
  the namespace prefix is never reported
  every record's payload carries its key, without the prefix, beside its kind and value
  the diff is a snapshot comparison and cannot see a key created and removed inside the window
  no file's content appears in any message

contract:
  input ObserveInput
  response ObserveResult
  error ObserveError

scenario "a namespace that does not match the runner's pattern is refused":
  when: ObserveRedis { script: "setup:raw=Orders" }
  predict rejection NAMESPACE_INVALID:
    response ERR ObserveError { code: "NAMESPACE_INVALID", detail: matching "Orders" }
    filesystem has []

scenario "a server that does not answer is a configuration error at setup":
  when: ObserveRedis { script: "setup:a", url: "unreachable" }
  predict rejection REDIS_UNREACHABLE:
    response ERR ObserveError { code: "REDIS_UNREACHABLE", detail: matching "redis://127.0.0.1:1" }
    filesystem has []

scenario "the adapter declares snapshot diff and state":
  when: ObserveRedis { script: "setup:a observes:a" }
  predict success:
    response OK ObserveResult { trace: "setup:a observes:a=snapshot/true" }
    filesystem has []

scenario "a window reports keys added, changed and removed, seeds excluded":
  when: ObserveRedis { script: "setup:a seed:a:string:k9 seed:a:set:k2 start:a set:a:k1:v1 sadd:a:k2:m1 del:a:k9 stop:a" }
  predict success:
    response OK ObserveResult {
      trace: "setup:a seed:a seed:a start:a set:a sadd:a del:a stop:a=3",
      last: "INSERT:k1,MODIFY:k2,REMOVE:k9",
      payloads: "[{\"key\":\"k1\",\"kind\":\"string\",\"value\":\"v1\"},{\"key\":\"k2\",\"kind\":\"set\",\"value\":[\"m0\",\"m1\"]},{\"key\":\"k9\",\"kind\":\"string\",\"value\":\"v0\"}]"
    }
    filesystem has []

scenario "every kind the adapter reads is reported in its canonical order":
  when: ObserveRedis { script: "setup:a start:a hset:a:h:z:1 hset:a:h:a:2 rpush:a:l:x rpush:a:l:b zadd:a:z:m2:2 zadd:a:z:m1:1 stop:a" }
  predict success:
    response OK ObserveResult {
      trace: "setup:a start:a hset:a hset:a rpush:a rpush:a zadd:a zadd:a stop:a=3",
      last: "INSERT:h,INSERT:l,INSERT:z",
      payloads: "[{\"key\":\"h\",\"kind\":\"hash\",\"value\":{\"a\":\"2\",\"z\":\"1\"}},{\"key\":\"l\",\"kind\":\"list\",\"value\":[\"x\",\"b\"]},{\"key\":\"z\",\"kind\":\"zset\",\"value\":[{\"member\":\"m1\",\"score\":1},{\"member\":\"m2\",\"score\":2}]}]"
    }
    filesystem has []

scenario "two namespaces never see each other's keys":
  when: ObserveRedis { script: "setup:a setup:b start:a start:b set:a:k1:v set:b:k1:v set:b:k2:v stop:a stop:b" }
  predict success:
    response OK ObserveResult {
      trace: "setup:a setup:b start:a start:b set:a set:b set:b stop:a=1 stop:b=2",
      last: "INSERT:k1,INSERT:k2"
    }
    filesystem has []

scenario "a key with no namespace prefix is nobody's effect":
  when: ObserveRedis { script: "setup:a start:a setraw:loose:v stop:a" }
  predict success:
    response OK ObserveResult { trace: "setup:a start:a setraw stop:a=0" }
    filesystem has []

scenario "a namespaced key of a type the adapter does not read is refused, not silently skipped":
  when: ObserveRedis { script: "setup:a start:a xadd:a:events stop:a" }
  predict rejection KIND_UNSUPPORTED:
    response ERR ObserveError { code: "KIND_UNSUPPORTED", detail: matching "stream" }
    filesystem has []

scenario "snapshot diff cannot see a key created and removed inside the window":
  when: ObserveRedis { script: "setup:a start:a set:a:k1:v del:a:k1 stop:a" }
  predict success:
    response OK ObserveResult { trace: "setup:a start:a set:a del:a stop:a=0" }
    filesystem has []

scenario "a peek reports the window's records and consumes nothing":
  when: ObserveRedis { script: "setup:a start:a set:a:k1:v peek:a peek:a stop:a" }
  predict success:
    response OK ObserveResult {
      trace: "setup:a start:a set:a peek:a=1 peek:a=1 stop:a=1",
      last: "INSERT:k1",
      peekEqualsStop: true
    }
    filesystem has []

scenario "settle vouches with a window open and declines with none":
  when: ObserveRedis { script: "setup:a settle:a start:a set:a:k1:v settle:a stop:a" }
  predict success:
    response OK ObserveResult { trace: "setup:a settle:a=false start:a set:a settle:a=true stop:a=1", last: "INSERT:k1" }
    filesystem has []

scenario "a read with a key hint looks the key up; without one it scans the namespace":
  when: ObserveRedis { script: "setup:a seed:a:string:k1 seed:a:set:k2 read:a:k2 read:a" }
  predict success:
    response OK ObserveResult { trace: "setup:a seed:a seed:a read:a:k2=1 read:a=2", read: "string:k1,set:k2", readVia: "NamespaceScan" }
    filesystem has []

scenario "a read's records carry their key in the payload":
  when: ObserveRedis { script: "setup:a seed:a:set:k2 read:a:k2" }
  predict success:
    response OK ObserveResult { trace: "setup:a seed:a read:a:k2=1", read: "set:k2", readPayloads: "[{\"key\":\"k2\",\"kind\":\"set\",\"value\":[\"m0\"]}]" }
    filesystem has []

scenario "a keyed read names how it found the key":
  when: ObserveRedis { script: "setup:a seed:a:list:k3 read:a:k3" }
  predict success:
    response OK ObserveResult { trace: "setup:a seed:a read:a:k3=1", read: "list:k3", readVia: "KeyedLookup" }
    filesystem has []

scenario outline "a seed that does not fit a kind is refused":
  when: ObserveRedis { script: <script> }
  predict rejection SEED_INVALID:
    response ERR ObserveError { code: "SEED_INVALID", detail: matching <detail> }
    filesystem has []
  examples:
    | script                     | detail   |
    | "setup:a seed:a:bogus:k1"  | "bogus"  |
    | "setup:a seed:a:set:nokey" | "values.key" |

scenario "a seed whose value does not fit its kind is refused, and nothing is written":
  when: ObserveRedis { script: "setup:a seedmisfit:a:string:k1" }
  predict rejection SEED_VALUE_UNSTORABLE:
    response ERR ObserveError { code: "SEED_VALUE_UNSTORABLE", detail: matching "k1" }
    filesystem has []

scenario "reset removes every key of the namespace and nothing else":
  when: ObserveRedis { script: "setup:a setup:b seed:a:string:k1 seed:a:hash:k2 seed:b:string:k1 reset:a count:a count:b" }
  predict success:
    response OK ObserveResult { trace: "setup:a setup:b seed:a seed:a seed:b reset:a count:a=0 count:b=1" }
    filesystem has []

scenario "any fault is refused, because the catalog is empty":
  when: ObserveRedis { script: "setup:a fault:a:Connection.Timeout" }
  predict rejection FAULT_UNSUPPORTED:
    response ERR ObserveError { code: "FAULT_UNSUPPORTED", detail: matching "Connection.Timeout" }
    filesystem has []

scenario "a password read from a file connects the instrument, and the system's writes are observed":
  when: ObserveRedis { script: "setup:a start:a set:a:k1:v stop:a", source: "passwordFile" }
  predict success:
    response OK ObserveResult { trace: "setup:a start:a set:a stop:a=1", last: "INSERT:k1" }
    filesystem has []

scenario outline "one trailing line ending is removed, so a secret written by echo or an editor still connects":
  when: ObserveRedis { script: "setup:a", source: "passwordFile", content: <content> }
  predict success:
    response OK ObserveResult { trace: "setup:a" }
    filesystem has []
  examples:
    | content |
    | "lf"    |
    | "crlf"  |

scenario "nothing but the line ending is trimmed, so a password with a space in it is kept":
  when: ObserveRedis { script: "setup:a start:a set:a:k1:v stop:a", source: "passwordFile", content: "innerSpace" }
  predict success:
    response OK ObserveResult { trace: "setup:a start:a set:a stop:a=1", last: "INSERT:k1" }
    filesystem has []

scenario "a relative path is read from the run's working directory":
  when: ObserveRedis { script: "setup:a", source: "passwordFile", path: "relative" }
  predict success:
    response OK ObserveResult { trace: "setup:a" }
    filesystem has []

scenario "a URL read from a file connects, with its line ending removed":
  when: ObserveRedis { script: "setup:a", source: "urlFile", content: "lf" }
  predict success:
    response OK ObserveResult { trace: "setup:a" }
    filesystem has []

scenario outline "a password file that cannot be used is refused before the adapter connects to anything":
  when: ObserveRedis { script: "setup:a", source: "passwordFile", content: <content>, path: <path> }
  predict rejection CREDENTIAL_FILE_UNREADABLE:
    response ERR ObserveError { code: "CREDENTIAL_FILE_UNREADABLE", detail: matching <detail> }
    filesystem has []
  examples:
    | content  | path        | detail         |
    | "exact"  | "missing"   | "is missing"   |
    | "exact"  | "directory" | "is a directory" |
    | "empty"  | "absolute"  | "is empty"     |
    | "lfOnly" | "absolute"  | "is empty"     |

scenario outline "conflicting connection options are refused before any file is read":
  when: ObserveRedis { script: "setup:a", source: <source> }
  predict rejection OPTIONS_INVALID:
    response ERR ObserveError { code: "OPTIONS_INVALID", detail: matching <detail> }
    filesystem has []
  examples:
    | source               | detail           |
    | "urlAndFile"         | "url, urlFile"   |
    | "urlEnvAndFile"      | "urlEnv, urlFile" |
    | "authMixed"          | "mixes"          |
    | "urlWithCredentials" | "carries credentials" |
    | "tlsCAFilePlain"     | "rediss://"      |
    | "authNoUser"         | "needs both user and passwordFile" |

scenario "a CA file is read before any connection, and a missing one is refused naming its option":
  when: ObserveRedis { script: "setup:a", source: "tlsCAFile", path: "missing" }
  predict rejection CREDENTIAL_FILE_UNREADABLE:
    response ERR ObserveError { code: "CREDENTIAL_FILE_UNREADABLE", detail: matching "tlsCAFile" }
    filesystem has []

scenario "a TLS server is verified against the CA read from tlsCAFile, and the instrument reads through it":
  when: ObserveRedis { script: "setup:a read:a", source: "tlsCAFile" }
  predict success:
    response OK ObserveResult { trace: "setup:a read:a=0", read: "", readVia: "NamespaceScan" }
    filesystem has []

scenario "a server certificate signed by another CA is refused at setup":
  when: ObserveRedis { script: "setup:a", source: "tlsCAFileOther" }
  predict rejection REDIS_UNREACHABLE:
    response ERR ObserveError { code: "REDIS_UNREACHABLE", detail: matching "certificate" }
    filesystem has []
