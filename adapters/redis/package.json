{
  "name": "@mmmnt/feat-adapter-redis",
  "version": "0.17.0",
  "description": "Redis service adapter for Feat: a snapshot diff of the namespace's keys, state by key or namespace scan, and credentials and a CA read from files",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude '**/seed-transform.test.ts' --exclude '**/observe.test.ts' --passWithNoTests"
  },
  "dependencies": {
    "@mmmnt/feat-adapter-stdio-jsonrpc": "workspace:^",
    "@mmmnt/feat-types": "workspace:^",
    "redis": "6.3.1"
  },
  "devDependencies": {
    "@mmmnt/feat-adapter-kit": "workspace:^",
    "@mmmnt/feat-runtime": "workspace:^",
    "@peculiar/x509": "3.1.0",
    "reflect-metadata": "0.2.2",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "BSD-3-Clause",
  "author": "listenrightmeow <@listenrightmeow> (https://sdd.mmmnt.dev/)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mmmnt/feature.git",
    "directory": "adapters/redis"
  },
  "homepage": "https://github.com/mmmnt/feature/tree/main/adapters/redis#readme",
  "bugs": {
    "url": "https://github.com/mmmnt/feature/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "feature",
    "feat",
    "specification",
    "spec-driven-development",
    "testing",
    "vitest",
    "adapter",
    "redis"
  ]
}
