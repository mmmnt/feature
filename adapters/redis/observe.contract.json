{
  "$schema": "https://feat.dev/schemas/contract.json",
  "specId": "SPEC-ADPRDS-001",
  "schemas": {
    "ObserveInput": {
      "type": "object",
      "required": [
        "script"
      ],
      "additionalProperties": false,
      "properties": {
        "script": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "enum": [
            "direct",
            "unreachable"
          ]
        },
        "source": {
          "enum": [
            "passwordFile",
            "urlFile",
            "urlAndFile",
            "urlEnvAndFile",
            "authMixed",
            "urlWithCredentials",
            "tlsCAFilePlain",
            "tlsCAFile",
            "authNoUser",
            "tlsCAFileOther"
          ]
        },
        "content": {
          "enum": [
            "exact",
            "lf",
            "crlf",
            "empty",
            "lfOnly",
            "innerSpace"
          ]
        },
        "path": {
          "enum": [
            "absolute",
            "relative",
            "missing",
            "directory"
          ]
        }
      }
    },
    "ObserveResult": {
      "type": "object",
      "required": [
        "trace"
      ],
      "additionalProperties": false,
      "properties": {
        "trace": {
          "type": "string"
        },
        "last": {
          "type": "string"
        },
        "payloads": {
          "type": "string"
        },
        "read": {
          "type": "string"
        },
        "peekEqualsStop": {
          "type": "boolean"
        },
        "readVia": {
          "enum": [
            "KeyedLookup",
            "NamespaceScan"
          ]
        },
        "readPayloads": {
          "type": "string"
        }
      }
    },
    "ObserveError": {
      "type": "object",
      "required": [
        "code"
      ],
      "properties": {
        "code": {
          "enum": [
            "NAMESPACE_INVALID",
            "REDIS_UNREACHABLE",
            "KIND_UNSUPPORTED",
            "SEED_INVALID",
            "SEED_VALUE_UNSTORABLE",
            "FAULT_UNSUPPORTED",
            "OPTIONS_INVALID",
            "CREDENTIAL_FILE_UNREADABLE"
          ]
        },
        "detail": {
          "type": "string"
        }
      }
    }
  }
}
