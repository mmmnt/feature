{
  "$schema": "https://feat.dev/schemas/contract.json",
  "specId": "SPEC-ADPKMS-001",
  "schemas": {
    "ObserveInput": {
      "type": "object",
      "required": [
        "script"
      ],
      "additionalProperties": false,
      "properties": {
        "script": {
          "type": "string",
          "minLength": 1
        },
        "emulator": {
          "enum": [
            "local-kms",
            "unreachable"
          ]
        },
        "settleTimeoutMs": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "ObserveResult": {
      "type": "object",
      "required": [
        "trace"
      ],
      "additionalProperties": false,
      "properties": {
        "trace": {
          "type": "string"
        },
        "last": {
          "type": "string"
        },
        "peekEqualsStop": {
          "type": "boolean"
        },
        "readVia": {
          "enum": [
            "DescribeKey",
            "ListKeys"
          ]
        }
      }
    },
    "ObserveError": {
      "type": "object",
      "required": [
        "code"
      ],
      "properties": {
        "code": {
          "enum": [
            "NAMESPACE_INVALID",
            "KMS_UNREACHABLE",
            "FAULT_TARGET_MISSING",
            "FAULT_UNSUPPORTED"
          ]
        },
        "detail": {
          "type": "string"
        }
      }
    }
  }
}
