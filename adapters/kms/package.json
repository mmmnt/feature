{
  "name": "@mmmnt/feat-adapter-kms",
  "version": "0.1.0",
  "description": "KMS service adapter for Feat: a snapshot diff of key state (keys, aliases, tags, rotation) against a KMS endpoint — an unpredicted key change fails the suite",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude '**/observe.test.ts' --exclude '**/transport.test.ts' --passWithNoTests"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "3.1164.0",
    "@mmmnt/feat-fault-proxy": "workspace:^",
    "@mmmnt/feat-types": "workspace:^"
  },
  "devDependencies": {
    "@mmmnt/feat-runtime": "workspace:^",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mmmnt/feature.git",
    "directory": "adapters/kms"
  },
  "homepage": "https://github.com/mmmnt/feature#readme",
  "bugs": {
    "url": "https://github.com/mmmnt/feature/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
