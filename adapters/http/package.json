{
  "name": "@mmmnt/feat-adapter-http",
  "version": "0.17.1",
  "description": "Feat response adapter: HTTP invocation (method/path routes from response.commands, baseUrl/headers from invoke, actor headers from the actor registry).",
  "license": "BSD-3-Clause",
  "author": "listenrightmeow <@listenrightmeow> (https://sdd.mmmnt.dev/)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@mmmnt/feat-types": "workspace:^"
  },
  "devDependencies": {
    "vitest": "^3.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mmmnt/feature.git",
    "directory": "adapters/http"
  },
  "homepage": "https://github.com/mmmnt/feature/tree/main/adapters/http#readme",
  "bugs": {
    "url": "https://github.com/mmmnt/feature/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "feature",
    "feat",
    "specification",
    "spec-driven-development",
    "testing",
    "vitest",
    "adapter",
    "http"
  ],
  "engines": {
    "node": ">=22"
  }
