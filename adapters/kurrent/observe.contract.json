{
  "$schema": "https://feat.dev/schemas/contract.json",
  "specId": "SPEC-ADPKUR-001",
  "schemas": {
    "ObserveInput": {
      "type": "object",
      "required": [
        "script"
      ],
      "additionalProperties": false,
      "properties": {
        "script": {
          "type": "string",
          "minLength": 1
        },
        "credentials": {
          "enum": [
            "admin",
            "reader"
          ]
        },
        "settleTimeoutMs": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "ObserveResult": {
      "type": "object",
      "required": [
        "trace"
      ],
      "additionalProperties": false,
      "properties": {
        "trace": {
          "type": "string"
        },
        "last": {
          "type": "string"
        },
        "peekEqualsStop": {
          "type": "boolean"
        }
      }
    },
    "ObserveError": {
      "type": "object",
      "required": [
        "code"
      ],
      "properties": {
        "code": {
          "enum": [
            "NAMESPACE_INVALID",
            "ALL_READ_DENIED",
            "FAULT_UNSUPPORTED",
            "TLS_HOST_UNSUPPORTED"
          ]
        },
        "detail": {
          "type": "string"
        }
      }
    }
  }
}
