scenario "an answer that carries both result and error is a protocol violation":
  when: Exchange { host: { command: ["node", "adapters/stdio-jsonrpc/fixtures/fake-host.mjs", "--mode", "both"] }, method: "reset", params: {} }
  predict rejection PROTOCOL_VIOLATION:
    response ERR ExchangeError { code: "PROTOCOL_VIOLATION", hostSpawned: true, hostAlive: false }
    filesystem has []

scenario "a JSON-RPC error from the host is relayed verbatim":
  when: Exchange { host: { command: ["node", "adapters/stdio-jsonrpc/fixtures/fake-host.mjs", "--mode", "rpc-error"] }, method: "reset", params: {} }
  predict rejection HOST_ERROR:
    response ERR ExchangeError { code: "HOST_ERROR", rpcCode: -32000, message: "boom", hostSpawned: true, hostAlive: false }
    filesystem has []

scenario "a parse-error answer with a null id is relayed as the host error of the one outstanding request":
  when: Exchange { host: { command: ["node", "adapters/stdio-jsonrpc/fixtures/fake-host.mjs", "--mode", "parse-error"] }, method: "reset", params: {} }
  predict rejection HOST_ERROR:
    response ERR ExchangeError { code: "HOST_ERROR", rpcCode: -32700, hostSpawned: true, hostAlive: false }
    filesystem has []

scenario "a null id with any other code is a protocol violation":
  when: Exchange { host: { command: ["node", "adapters/stdio-jsonrpc/fixtures/fake-host.mjs", "--mode", "null-id-other"] }, method: "reset", params: {} }
  predict rejection PROTOCOL_VIOLATION:
