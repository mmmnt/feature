feat 1.0

# SPEC-RPC-001 — the transport of @mmmnt/feat-adapter-stdio-jsonrpc: one request, one
# answer, over the Feat Host Protocol (JSON-RPC 2.0 over stdio; contract
# schemas/feat-host-protocol.schema.json). Successor of the draft SPEC-WIRE-001.
# Agreed and ordered built by Sift decision 58a4ac88 (2026-11-09).
#
# Scope: the client side of one exchange (validate, spawn, frame, correlate, check the
# answer against the CLOSED shape of its method, fail precisely, leave nothing running).
# Layering of the namespace (SPEC-RT-006 owns the codes): this spec owns SHAPE only, so a setup
# answer with no namespace, or a malformed one, is PROTOCOL_VIOLATION and a setup request without a
# valid namespace is INVALID_REQUEST; an answer that is well-formed but names another value is a
# valid exchange, and NAMESPACE_NOT_HONOURED is raised by the adapter that compared it (SPEC-RPC-002).
# The same split holds for the protocol version: the request names exactly 2 (anything else is
# INVALID_REQUEST); the answer must carry an integer protocol (absent = PROTOCOL_VIOLATION); a
# well-formed answer naming another version is a valid exchange and PROTOCOL_MISMATCH is the adapter's.
# The namespace is exactly `s` plus 12 lowercase hex characters, on the request and on the echo.
# The adapter classes, the host shared by a spec file's roles, settle, peekCapture
# non-destructiveness and the clock on every case (setClock) are SPEC-RPC-002.
# The fake host the scenarios drive (adapters/stdio-jsonrpc/fixtures/fake-host.mjs; its
# --mode argument picks canned, echo, rpc-error, garbage, wrong-id, exit, silent,
# bad-invoke, bad-record, bad-settle, both, parse-error, null-id-other, other-ns, other-protocol, bad-setup-none, bad-setup-no-protocol, bad-setup-pattern;
# canned and echo answer setup with protocol 2 and the namespace they were sent) is part of the
# build and sits inside touches. The schema is draft-07, compiled by Ajv strict.

spec SPEC-RPC-001 "Exchange one request with a spec host"
context Toolchain
aggregate Host
type command
status agreed

construct:
  handler at adapters/stdio-jsonrpc/src/exchange.ts
  touches adapters/stdio-jsonrpc/**
  touches feat.config.json
  imports Ajv from ajv
  needs SPEC-RT-001
  Spawn the host named by host.command with stdin and stdout piped, send exactly one request line
  ({"jsonrpc":"2.0","id":<n>,"method":...,"params":...}), read exactly one answer line, and return
  its result. Validate the request against schemas/feat-host-protocol.schema.json BEFORE spawning:
  an invalid request never reaches a host. Validate the answer against the same schema, require its
  id to equal the request id (a null id is accepted only on an error of code -32700 or -32600 and is
  attributed to the one outstanding request), and validate a success result against the closed
  definition for the method that was sent (#/definitions/results/<method>). Never retry, never
  reconnect: one exchange is one attempt. The host is killed when the exchange ends. Every failure
  names its code; the answer carries the request line that was sent, whether a host was spawned,
  and whether it is still alive.

enforce:
  validate the request, spawn the host, write one line, read one line, validate the answer
  rejects INVALID_REQUEST when the request does not validate against the protocol schema, and no host is spawned
  rejects HOST_SPAWN_FAILED when the host command cannot be started
  rejects HOST_EXITED when the host exits before it answers
  rejects HOST_TIMEOUT when the host does not answer within timeoutMs (default 30000)
  rejects PROTOCOL_VIOLATION when the host's line is not valid JSON, does not validate against the protocol schema, carries another id, or carries a result that violates the closed shape of the method sent
  rejects HOST_ERROR when the host answers with a JSON-RPC error, relaying its code and message verbatim
  on every outcome leave no host process running

contract:
  input ExchangeInput
  response ExchangeResult
  error ExchangeError

scenario "an invoke round-trips and relays status and body":
  when: Exchange { host: { command: ["node", "adapters/stdio-jsonrpc/fixtures/fake-host.mjs", "--mode", "echo"] }, method: "invoke", params: { command: "Ping", input: { n: 1 }, actor: "admin" } }
  predict success:
    response OK ExchangeResult { method: "invoke", sent: { method: "invoke", params: { command: "Ping", input: { n: 1 }, actor: "admin" } }, hostSpawned: true, hostAlive: false, result: { status: 200, body: { command: "Ping" } } }
    filesystem has []

scenario "setup carries the protocol version, the services and the runner namespace and relays the host's echo":
  when: Exchange { host: { command: ["node", "adapters/stdio-jsonrpc/fixtures/fake-host.mjs", "--mode", "canned"] }, method: "setup", params: { protocol: 2, services: ["log", "kv"], namespace: "s0599e33863c1" } }
  predict success:
    response OK ExchangeResult { method: "setup", sent: { method: "setup", params: { protocol: 2, services: ["log", "kv"], namespace: "s0599e33863c1" } }, hostSpawned: true, hostAlive: false, result: { protocol: 2, namespace: "s0599e33863c1" } }
    filesystem has []

scenario "a setup answer echoing another well-formed namespace is a valid exchange, the comparison is the adapter's":
  when: Exchange { host: { command: ["node", "adapters/stdio-jsonrpc/fixtures/fake-host.mjs", "--mode", "other-ns"] }, method: "setup", params: { protocol: 2, services: ["log"], namespace: "s0599e33863c1" } }
  predict success:
    response OK ExchangeResult { method: "setup", hostSpawned: true, hostAlive: false, result: { protocol: 2, namespace: "s3b04e21257fd" } }
    filesystem has []

scenario "a setup answer naming another protocol version is a valid exchange, the comparison is the adapter's":
  when: Exchange { host: { command: ["node", "adapters/stdio-jsonrpc/fixtures/fake-host.mjs", "--mode", "other-protocol"] }, method: "setup", params: { protocol: 2, services: ["log"], namespace: "s0599e33863c1" } }
  predict success:
    response OK ExchangeResult { method: "setup", hostSpawned: true, hostAlive: false, result: { protocol: 1, namespace: "s0599e33863c1" } }
    filesystem has []

scenario "a setup answer without the namespace echo violates the closed schema":
  when: Exchange { host: { command: ["node", "adapters/stdio-jsonrpc/fixtures/fake-host.mjs", "--mode", "bad-setup-none"] }, method: "setup", params: { protocol: 2, services: ["log"], namespace: "s0599e33863c1" } }
  predict rejection PROTOCOL_VIOLATION:
    response ERR ExchangeError { code: "PROTOCOL_VIOLATION", detail: matching "namespace", hostSpawned: true, hostAlive: false }
    filesystem has []

scenario "a setup answer without the protocol version violates the closed schema":
  when: Exchange { host: { command: ["node", "adapters/stdio-jsonrpc/fixtures/fake-host.mjs", "--mode", "bad-setup-no-protocol"] }, method: "setup", params: { protocol: 2, services: ["log"], namespace: "s0599e33863c1" } }
  predict rejection PROTOCOL_VIOLATION:
    response ERR ExchangeError { code: "PROTOCOL_VIOLATION", detail: matching "protocol", hostSpawned: true, hostAlive: false }
    filesystem has []

scenario "a setup answer whose namespace is not s plus twelve hex characters violates the closed schema":
  when: Exchange { host: { command: ["node", "adapters/stdio-jsonrpc/fixtures/fake-host.mjs", "--mode", "bad-setup-pattern"] }, method: "setup", params: { protocol: 2, services: ["log"], namespace: "s0599e33863c1" } }
  predict rejection PROTOCOL_VIOLATION:
    response ERR ExchangeError { code: "PROTOCOL_VIOLATION", detail: matching "namespace", hostSpawned: true, hostAlive: false }
    filesystem has []

