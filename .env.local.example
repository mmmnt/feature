# Copy to .env.local (gitignored) and fill in what you use. Never commit .env.* files.
# `pnpm claude:session` loads it with dotenvx.

# The environment evidence bundles are stamped with (overrides feat.config.json's environment).
ENVIRONMENT=

# Agent and model credentials.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Atlassian (the atlassian MCP server in .mcp.json reads these).
ATLASSIAN_USERNAME=
ATLASSIAN_API_TOKEN=

# Integration-tier instruments.
LOCALSTACK_AUTH_TOKEN=

# Other tooling.
GITHUB_PAT=
SERVERLESS_LICENSE_KEY=
XRAY_CLIENT_ID=
XRAY_CLIENT_SECRET=
DEBUG=
