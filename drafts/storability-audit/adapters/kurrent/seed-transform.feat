feat 1.0

# SPEC-ADPKUR-006 — Kurrent adapter: a consumer's spec host may transform seed values before they are appended, and every seed
# is checked against what an event can hold (an amendment to SPEC-ADPKUR-001, in a spec of its own). Agreed by founder ruling 094b5dcc (2026-11-21, the set agreed), with the follow-ups ruled in 12081c37 (Redis's value code split, an identity change refused as SEED_TRANSFORM_FAILED, an oversized Kurrent event left to the server, canonical-JSON equality). Founder rulings
# 944b1d17 ("Feature seed hook") and c141a704 (Q1 spec host only, Q2 optional method v2, Q3 all seeds, Q4 check by doing it
# twice, Q5 all store adapters). The option, the protocol, the twice-asked transform and the refusals are SPEC-ADPNEO-005's,
# stated here for Kurrent. ADR-0035. Amended by founder ruling c786e54d (2026-11-21, "Amend all, stay agreed (Recommended)"): its literals follow the store and the adapter's existing spec. Amended by founder ruling 99212372 (2026-11-21, S2 "Allow any JSON"): a seed's values may be any JSON value, as KurrentDB appends any JSON as event data.
#
#   options.seedTransform: { host: { command: [<argv>], cwd?, env? } }
#
# Storable in Kurrent (SPEC-ADPKUR-001's seed: { type, values } appended as a JSON event of that type to values.stream, else to
# the stream named by type): values is any JSON value (KurrentDB appends an object, a scalar, a string, null or a list as event
# data alike). Only an object can carry values.stream; a seed whose values is not an object, or is an object without `stream`,
# is appended to the stream named by its type. values.stream, when present, is a non-empty string. A record's identity is its
# type and its stream; a transform changes neither, so a transform that turns an object naming a stream into a non-object moves
# the record to its type's stream and is refused as a changed identity.
#
# This amendment also moves SPEC-ADPKUR-001's seed from append-as-you-go to check-then-append: every record of a call is
# transformed and checked before the first append, so a refused call appends nothing. (The appends of one call stay
# separate; a server failure between two of them is not this spec's.)
#
# Spec tier, the integration config leaves this file out so it runs once. Driven through the probe of SPEC-ADPKUR-001
# (adapters/kurrent/fixtures/probe.mjs) and the shared fake transform host (adapters/stdio-jsonrpc/fixtures/seed-host.mjs, its
# modes as SPEC-ADPNEO-005 lists them), both inside touches. `ObserveKurrentSeedTransform { host, script }` runs the steps of
# SPEC-ADPKUR-001 plus:
#   seedenc:<ns>:<stream>:<Type>:<text>  seed() of one record whose data v is { encode: "<text>" }
#   seedmix:<ns>                         ONE seed() call: Placed into orders with v { encode: "a" }, then with v { encode: "b" }
#   seedraw:<ns>:<case>                  a plain Placed seed: streamnum (values.stream = 1), streamempty (values.stream = ""),
#                                        scalar (values 5), string (values "x"), list (values [1])
#   read:<ns>:<stream>                   adapter.read() of that stream, traced `read:<ns>:<stream>=<n>` as SPEC-ADPKUR-001 traces it;
#                                        `readPayloads` is the JSON of its events' data, values.stream included
#   calls:<ns>                           the number of transformSeed requests the fake host received

spec SPEC-ADPKUR-006 "Kurrent adapter: a consumer's spec host may transform seed values, and every seed must be an event Kurrent can hold"
context Toolchain
aggregate Adapters
type infrastructure
status agreed

construct:
  handler at adapters/kurrent/src/index.ts
  touches adapters/kurrent/**
  touches adapters/stdio-jsonrpc/fixtures/seed-host.mjs
  touches feat.config.json
  touches feat.integration.config.json
  needs SPEC-ADPKUR-001
  needs SPEC-ADPNEO-005
  needs SPEC-RPC-001
  options.seedTransform, setup(), the twice-asked transformSeed and teardown() exactly as SPEC-ADPNEO-005 states them, with a
  record's identity being its type and its stream. Then every record, transformed or plain, is checked, and only then is each
  appended as SPEC-ADPKUR-001 says, in order. The transform applies to seeds only: capture, read and state never pass
  through it.

enforce:
  rejects OPTIONS_INVALID when options.seedTransform is not { host } with a host whose command is a non-empty list of strings
  rejects SEED_TRANSFORM_UNAVAILABLE when the seed-transform host cannot be started at setup()
  rejects SEED_TRANSFORM_FAILED when the host answers transformSeed with an error, does not implement it, ends, or answers with records that differ in number, order, type or stream
  rejects SEED_TRANSFORM_NONDETERMINISTIC when the two answers to one seed call's transformSeed differ
  rejects SEED_VALUE_UNSTORABLE when a seed record's values, transformed or plain, is an object whose stream is not a non-empty string
  nothing of a seed call is appended unless every record of it was transformed and checked
  a transform applies to seeds only, never to what the adapter observes or reads

contract:
  input SeedTransformInput
  response SeedTransformResult
  error SeedTransformError

scenario "a seed's data is appended as the host transformed it":
  when: ObserveKurrentSeedTransform { host: "encode", script: "setup:a seedenc:a:orders:Placed:ab read:a:orders" }
  predict success:
    response OK SeedTransformResult { trace: "setup:a seedenc:a read:a:orders=1", readPayloads: "[{\"stream\":\"orders\",\"v\":[2,97,1]}]" }
    filesystem has []

scenario "one seed call is transformed in one request, asked twice, and appended in order":
  when: ObserveKurrentSeedTransform { host: "encode", script: "setup:a seedmix:a calls:a read:a:orders" }
  predict success:
    response OK SeedTransformResult { trace: "setup:a seedmix:a calls:a=2 read:a:orders=2", readPayloads: "[{\"stream\":\"orders\",\"v\":[1,97,1]},{\"stream\":\"orders\",\"v\":[1,98,1]}]" }
    filesystem has []

scenario "a transformed seed is state: the window that follows reports nothing":
  when: ObserveKurrentSeedTransform { host: "encode", script: "setup:a seedenc:a:orders:Placed:ab start:a stop:a" }
  predict success:
    response OK SeedTransformResult { trace: "setup:a seedenc:a start:a stop:a=0" }
    filesystem has []

scenario "without seedTransform no host is asked and a plain seed is appended as before":
  when: ObserveKurrentSeedTransform { host: "none", script: "setup:a seed:a:orders:Placed read:a:orders" }
  predict success:
    response OK SeedTransformResult { trace: "setup:a seed:a read:a:orders=1" }
    filesystem has []

scenario "a host that cannot be started is refused at setup":
  when: ObserveKurrentSeedTransform { host: "absent", script: "setup:a" }
  predict rejection SEED_TRANSFORM_UNAVAILABLE:
    response ERR SeedTransformError { code: "SEED_TRANSFORM_UNAVAILABLE", detail: matching "seedTransform" }
    filesystem has []

scenario "a seedTransform without a command is refused at setup":
  when: ObserveKurrentSeedTransform { host: "nocommand", script: "setup:a" }
  predict rejection OPTIONS_INVALID:
    response ERR SeedTransformError { code: "OPTIONS_INVALID", detail: matching "seedTransform.host.command" }
    filesystem has []

scenario outline "a transform that fails appends nothing":
  when: ObserveKurrentSeedTransform { host: <host>, script: "setup:a seedmix:a" }
  predict rejection SEED_TRANSFORM_FAILED:
    response ERR SeedTransformError { code: "SEED_TRANSFORM_FAILED", detail: matching <detail> }
    filesystem has []
  examples:
    | host       | detail               |
    | "fail"     | "encoder not loaded" |
    | "nomethod" | "transformSeed"      |
    | "crash"    | "ended"              |
    | "short"    | "2 records"          |
    | "retype"   | "Placed"             |
    | "rekey"    | "orders"             |

scenario "two answers that differ are refused as nondeterministic":
  when: ObserveKurrentSeedTransform { host: "random", script: "setup:a seedenc:a:orders:Placed:ab" }
  predict rejection SEED_TRANSFORM_NONDETERMINISTIC:
    response ERR SeedTransformError { code: "SEED_TRANSFORM_NONDETERMINISTIC", detail: matching "Placed" }
    filesystem has []

scenario outline "after a refused seed call the stream holds nothing of it":
  when: ObserveKurrentSeedTransform { host: <host>, script: "setup:a seedmix:a! read:a:orders" }
  predict success:
    response OK SeedTransformResult { trace: <trace>, readPayloads: "[]" }
    filesystem has []
  examples:
    | host     | trace                                                        |
    | "short"  | "setup:a seedmix:a!SEED_TRANSFORM_FAILED read:a:orders=0"           |
    | "random" | "setup:a seedmix:a!SEED_TRANSFORM_NONDETERMINISTIC read:a:orders=0" |
    | "scalar" | "setup:a seedmix:a!SEED_TRANSFORM_FAILED read:a:orders=0"           |

scenario "a transform that turns a seed naming a stream into a non-object moves its stream and is refused as a changed identity":
  when: ObserveKurrentSeedTransform { host: "scalar", script: "setup:a seedenc:a:orders:Placed:ab" }
  predict rejection SEED_TRANSFORM_FAILED:
    response ERR SeedTransformError { code: "SEED_TRANSFORM_FAILED", detail: matching "orders" }
    filesystem has []

scenario outline "a plain seed whose values is not an object is appended, as event data, to the stream named by its type":
  when: ObserveKurrentSeedTransform { host: "none", script: <script> }
  predict success:
    response OK SeedTransformResult { trace: <trace>, readPayloads: <payloads> }
    filesystem has []
  examples:
    | script                                      | trace                                       | payloads    |
    | "setup:a seedraw:a:scalar read:a:Placed"    | "setup:a seedraw:a read:a:Placed=1"         | "[5]"       |
    | "setup:a seedraw:a:string read:a:Placed"    | "setup:a seedraw:a read:a:Placed=1"         | "[\"x\"]" |
    | "setup:a seedraw:a:list read:a:Placed"      | "setup:a seedraw:a read:a:Placed=1"         | "[[1]]"     |

scenario outline "a plain seed whose stream is not a non-empty string is refused":
  when: ObserveKurrentSeedTransform { host: "none", script: <script> }
  predict rejection SEED_VALUE_UNSTORABLE:
    response ERR SeedTransformError { code: "SEED_VALUE_UNSTORABLE", detail: matching "values.stream" }
    filesystem has []
  examples:
    | script                          |
    | "setup:a seedraw:a:streamnum"   |
    | "setup:a seedraw:a:streamempty" |
