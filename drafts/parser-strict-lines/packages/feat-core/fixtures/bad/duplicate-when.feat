feat 1.0

spec SPEC-BAD-148 "A scenario with two when lines"
context Bad
aggregate Thing
type command
status draft

construct:
  handler at src/do-thing.ts
  touches src/**

enforce:
  do the thing

contract:
  input ThingInput
  response ThingResult
  record ThingRow

scenario "does the thing":
  when: DoThing { value: 1 }
  when: DoThing { value: 2 }
  predict success:
    response OK ThingResult
    eventStore has []
