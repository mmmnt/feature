feat 1.0

spec SPEC-BAD-147 "A scenario name with an escape JSON does not have"
context Bad
aggregate Thing
type command
status draft

construct:
  handler at src/do-thing.ts
  touches src/**

enforce:
  do the thing

contract:
  input ThingInput
  response ThingResult
  record ThingRow

scenario "does the \q thing":
  when: DoThing { value: 1 }
  predict success:
    response OK ThingResult
    eventStore has []
