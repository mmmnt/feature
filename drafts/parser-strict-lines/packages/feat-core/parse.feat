scenario outline "rejects invalid specs with the precise code, with a hint and no line":
  when: Parse { spec: <spec>, config: "packages/feat-core/fixtures/parse.config.json" }
  predict rejection <code>:
    response ERR ParseError { code: <code>, line: absent, hint: matching <hint> }
    filesystem has []
  examples:
    | spec | code | hint |
    | "packages/feat-core/fixtures/bad/unknown-service.feat" | "UNKNOWN_SERVICE_KEY" | "^Configured services: eventStore$" |
    | "packages/feat-core/fixtures/bad/unknown-capture-service.feat" | "UNKNOWN_SERVICE_KEY" | "^Configured services: eventStore$" |
    | "packages/feat-core/fixtures/bad/unknown-command.feat" | "UNKNOWN_COMMAND" | "^Configured commands: DoThing$" |
    | "packages/feat-core/fixtures/bad/undeclared-schema.feat" | "UNDECLARED_SCHEMA" | "^Declared schemas: ThingInput, ThingResult$" |
    | "packages/feat-core/fixtures/bad/unknown-actor.feat" | "UNKNOWN_ACTOR" | "^Configured actors: admin$" |
    | "packages/feat-core/fixtures/bad/duplicate-scenario.feat" | "DUPLICATE_SCENARIO_NAME" | "^Scenario names are failure anchors and must be unique per spec\\.$" |
    | "packages/feat-core/fixtures/bad/incomplete-prediction.feat" | "INCOMPLETE_PREDICTION" | "^Every configured service must appear; 'has \\[\\]' is the explicit zero-assertion\\.$" |
    | "packages/feat-core/fixtures/bad/missing-minimum.feat" | "MISSING_MINIMUM" | "^See grammar reference §1\\.2\\.$" |
    | "packages/feat-core/fixtures/bad/fault-unknown-service.feat" | "UNKNOWN_SERVICE_KEY" | "^Configured services: eventStore$" |
    | "packages/feat-core/fixtures/bad/not-not.feat" | "MALFORMED_SYNTAX" | "^Write the operand itself: 'not not M' is 'M'\\.$" |
    | "packages/feat-core/fixtures/bad/not-absent.feat" | "MALFORMED_SYNTAX" | "^Write 'any' for a field that must be present\\.$" |
    | "packages/feat-core/fixtures/bad/not-bare-any.feat" | "MALFORMED_SYNTAX" | "^Write 'absent' for a field that must not exist; 'not any <type>' negates a type check\\.$" |
    | "packages/feat-core/fixtures/bad/not-block.feat" | "MALFORMED_SYNTAX" | "^Negate a field inside the block instead: '\\{ field: not <matcher> \\}'\\.$" |
    | "packages/feat-core/fixtures/bad/not-bare.feat" | "MALFORMED_SYNTAX" | "^Write 'not' and one matcher on the same line: 'not \"Failed\"', 'not @when\\.id', 'not matching \"\\^tmp-\"', 'not any uuid'\\.$" |
    | "packages/feat-core/fixtures/bad/not-unknown-capture-service.feat" | "UNKNOWN_SERVICE_KEY" | "^Configured services: eventStore$" |
    | "packages/feat-core/fixtures/bad/f32-zero-dims.feat" | "MALFORMED_SYNTAX" | "^Write 'f32 <dims> sha256 \"<64 lowercase hex>\"', e\\.g\\. 'embedding: f32 384 sha256 \"9c1e…\"'\\.$" |
    | "packages/feat-core/fixtures/bad/f32-fractional-dims.feat" | "MALFORMED_SYNTAX" | "^Write 'f32 <dims> sha256 \"<64 lowercase hex>\"', e\\.g\\. 'embedding: f32 384 sha256 \"9c1e…\"'\\.$" |
    | "packages/feat-core/fixtures/bad/f32-uppercase-digest.feat" | "MALFORMED_SYNTAX" | "^Write 'f32 <dims> sha256 \"<64 lowercase hex>\"', e\\.g\\. 'embedding: f32 384 sha256 \"9c1e…\"'\\.$" |
    | "packages/feat-core/fixtures/bad/f32-short-digest.feat" | "MALFORMED_SYNTAX" | "^Write 'f32 <dims> sha256 \"<64 lowercase hex>\"', e\\.g\\. 'embedding: f32 384 sha256 \"9c1e…\"'\\.$" |
    | "packages/feat-core/fixtures/bad/f32-missing-sha256.feat" | "MALFORMED_SYNTAX" | "^Write 'f32 <dims> sha256 \"<64 lowercase hex>\"', e\\.g\\. 'embedding: f32 384 sha256 \"9c1e…\"'\\.$" |
    | "packages/feat-core/fixtures/bad/f32-bare.feat" | "MALFORMED_SYNTAX" | "^Write 'f32 <dims> sha256 \"<64 lowercase hex>\"', e\\.g\\. 'embedding: f32 384 sha256 \"9c1e…\"'\\.$" |
    | "packages/feat-core/fixtures/bad/not-f32.feat" | "MALFORMED_SYNTAX" | "^Write 'f32 <dims> sha256 \"<64 lowercase hex>\"', e\\.g\\. 'embedding: f32 384 sha256 \"9c1e…\"'\\.$" |
    | "packages/feat-core/fixtures/bad/list-absent-item.feat" | "MALFORMED_SYNTAX" | "^Write a shorter list: a list predicts every item it holds\\.$" |
    | "packages/feat-core/fixtures/bad/list-absent-field.feat" | "MALFORMED_SYNTAX" | "^Leave the field out\\.$" |
    | "packages/feat-core/fixtures/bad/not-list.feat" | "MALFORMED_SYNTAX" | "^Negate a field inside an item instead: '\\[ \\{ field: not <matcher> \\} \\]'\\.$" |
    | "packages/feat-core/fixtures/bad/list-unknown-capture-service.feat" | "UNKNOWN_SERVICE_KEY" | "^Configured services: eventStore$" |

