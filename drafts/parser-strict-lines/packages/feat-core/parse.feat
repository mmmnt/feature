  when: Parse { spec: "packages/feat-core/fixtures/ok/observes-subset.feat", config: "packages/feat-core/fixtures/parse-observes.config.json" }
  predict success:
    response OK BuiltSpec equals fixture "../../packages/feat-core/fixtures/ok/observes-subset.ir.json"
    filesystem has []

scenario "a query that observes one service may read it with contains":
  when: Parse { spec: "packages/feat-core/fixtures/ok/observes-query.feat", config: "packages/feat-core/fixtures/parse-observes.config.json" }
  predict success:
    response OK BuiltSpec equals fixture "../../packages/feat-core/fixtures/ok/observes-query.ir.json"
    filesystem has []

scenario outline "refuses an observes declaration that is not well formed or names an unconfigured service":
  when: Parse { spec: <spec>, config: "packages/feat-core/fixtures/parse-observes.config.json" }
  predict rejection <code>:
    response ERR ParseError { code: <code>, hint: matching <hint>, line: <line> }
    filesystem has []
  examples:
    | spec                                                         | code                  | hint                     | line |
    | "packages/feat-core/fixtures/bad/observes-unknown-service.feat" | "UNKNOWN_SERVICE_KEY" | "^Configured services: eventStore, cache, log" | 8 |
    | "packages/feat-core/fixtures/bad/observes-duplicate.feat"    | "MALFORMED_SYNTAX"    | "^Write 'observes <service>, <service>'" | 8 |
    | "packages/feat-core/fixtures/bad/observes-bare.feat"         | "MALFORMED_SYNTAX"    | "^Write 'observes <service>, <service>'" | 8 |
    | "packages/feat-core/fixtures/bad/observes-trailing-comma.feat" | "MALFORMED_SYNTAX"  | "^Write 'observes <service>, <service>'" | 8 |
    | "packages/feat-core/fixtures/bad/observes-twice.feat"        | "MALFORMED_SYNTAX"    | "^Write 'observes <service>, <service>'" | 9 |

scenario "a delivery to response names the response role, so it is neither an unknown nor an unobserved service":
  when: Parse { spec: "packages/feat-core/fixtures/ok/deliver-response.feat", config: "packages/feat-core/fixtures/parse-observes.config.json" }
  predict success:
    response OK BuiltSpec equals fixture "../../packages/feat-core/fixtures/ok/deliver-response.ir.json"
    filesystem has []

scenario "a delivery to a target that is neither response nor a configured service is refused":
  when: Parse { spec: "packages/feat-core/fixtures/bad/deliver-unknown-target.feat", config: "packages/feat-core/fixtures/parse-observes.config.json" }
  predict rejection UNKNOWN_SERVICE_KEY:
    response ERR ParseError { code: "UNKNOWN_SERVICE_KEY", message: matching "'cash'", hint: matching "^Configured services: eventStore, cache, log", line: absent }
    filesystem has []

scenario outline "refuses a service the spec uses but does not observe, naming it and the observed ones":
  when: Parse { spec: <spec>, config: "packages/feat-core/fixtures/parse-observes.config.json" }
  predict rejection UNOBSERVED_SERVICE:
    response ERR ParseError { code: "UNOBSERVED_SERVICE", message: matching "'cache'", hint: matching "^Observed services: eventStore", line: absent }
    filesystem has []
  examples:
    | spec                                                              |
