    | "packages/feat-core/fixtures/bad/rejection-id-lower-camel.feat" | "MALFORMED_SYNTAX" | 24 | "^Use 'predict success:', 'predict rejection <ID>:' \\(ID is UPPER_SNAKE or UpperCamel\\), or 'predict error <CODE>:' \\(CODE is UPPER_SNAKE\\)$" |
