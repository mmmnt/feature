    | "packages/feat-core/fixtures/bad/rejection-id-kebab.feat" | "MALFORMED_SYNTAX" | 24 | "^Use 'predict success:', 'predict rejection <ID>:' \\(ID is UPPER_SNAKE or UpperCamel\\), or 'predict error <CODE>:' \\(CODE is UPPER_SNAKE\\)$" |
    | "packages/feat-core/fixtures/bad/fault-missing-operation.feat" | "MALFORMED_SYNTAX" | 22 | "^Form: fault <service> <Operation> <Fault> \\[\\{ json \\}\\] \\[once \\x7c times <n> \\x7c until reset\\]$" |
    | "packages/feat-core/fixtures/bad/fault-lowercase-operation.feat" | "MALFORMED_SYNTAX" | 22 | "^Form: fault <service> <Operation> <Fault> \\[\\{ json \\}\\] \\[once \\x7c times <n> \\x7c until reset\\]$" |
    | "packages/feat-core/fixtures/bad/fault-times-zero.feat" | "MALFORMED_SYNTAX" | 22 | "^Form: fault <service> <Operation> <Fault> \\[\\{ json \\}\\] \\[once \\x7c times <n> \\x7c until reset\\]$" |
    | "packages/feat-core/fixtures/bad/fault-times-without-count.feat" | "MALFORMED_SYNTAX" | 22 | "^Form: fault <service> <Operation> <Fault> \\[\\{ json \\}\\] \\[once \\x7c times <n> \\x7c until reset\\]$" |
    | "packages/feat-core/fixtures/bad/fault-trailing-junk.feat" | "MALFORMED_SYNTAX" | 22 | "^Form: fault <service> <Operation> <Fault> \\[\\{ json \\}\\] \\[once \\x7c times <n> \\x7c until reset\\]$" |
    | "packages/feat-core/fixtures/bad/fault-bare-keyword.feat" | "MALFORMED_SYNTAX" | 22 | "^Form: fault <service> <Operation> <Fault> \\[\\{ json \\}\\] \\[once \\x7c times <n> \\x7c until reset\\]$" |
