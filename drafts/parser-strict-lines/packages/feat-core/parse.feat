feat 1.0

# SPEC-CORE-001 — the parser's own contract, written in the language it parses.
# The corpus is the executable ground truth: one golden scenario per exemplar
# (equals fixture, ADR-0013). Rejection families cover the pragma, the four
# closed reference spaces, trigger discipline, the query guarantee, and the
# no-escape-hatch minimums. status agreed proposed per ADR-0008.
#
# AMENDMENT (ADR-0022, UpperCamel rejection ids; Sift founder ruling 19878957 (1), "Change
# Feature's grammar"; flipped to agreed and ordered built by Sift decision 0026e0ea, 2026-11-09).
#
# AMENDMENT (ADR-0023, `fault` in given:; Sift founder rulings 05537e6e (3) "reserved inside given:
# in feat 1.0" and 0026e0ea, 2026-11-09).
#
# AMENDMENT (ADR-0025, given steps in written order; founder ruling cd1ed65b, 2026-11-12, "Feature:
# written order (Recommended)"). A given that has both seed and execute lines records their written
# order as given.order; the harness runs them in it (SPEC-RT-009). One new exemplar, corpus/given-order;
# every other scenario and every other exemplar's IR is unchanged.
#
# AMENDMENT (ADR-0027, the negation matcher `not <matcher>`; founder ruling 9959cfbc, 2026-11-13, "Add
# `not` to Feature (Recommended)"). A value block's matcher may be `not <operand>`, recorded as
# { matcher: "not", operand }; the runtime evaluates it (SPEC-RT-011). One new exemplar, corpus/not-matcher,
# and six refusal fixtures; every other scenario and every other exemplar's IR is unchanged.
#
# AMENDMENT (ADR-0028 and ADR-0029; founder ruling 5f05d5e1, 2026-11-14, "Agree as drafted" and "Seedable
# randomness"). In a value block's matcher position, `@given.response.<path>` and `@given[i].response.<path>`
# are the given-response reference, recorded as { matcher: "givenRef", path, index? } (alone and as the
# operand of `not`); the runtime evaluates it (SPEC-RT-012). A given line `random seed <n>` is recorded as
# given.random; the harness delivers it (SPEC-RT-013). One new exemplar, corpus/given-ref, and two refusal
# fixtures; every other scenario and every other exemplar's IR is unchanged.
#
# AMENDMENT (ADR-0030, the f32 digest matcher; founder ruling 2026-11-16, "New Feature matcher
# (Recommended)", agreed "Agree as drafted (Recommended)"). A value block's matcher may be
# `f32 <dims> sha256 "<hex>"`, recorded as { matcher: "f32Digest", dims, sha256 }; the runtime evaluates it
# (SPEC-RT-014). One new exemplar, corpus/f32-digest, and seven refusal fixtures; every other scenario and every
# other exemplar's IR is unchanged.
#
# AMENDMENT (ADR-0033, a spec declares the services it observes; agreed by founder decision 2d6e954c, "Agree once
# revised (Rec.)", on rulings bcce4098 F3-a "Narrow successes (Rec.)" and F3-b "UNOBSERVED_SERVICE (Rec.)"). Founder ruling 2026-11-20 N3 "Per-spec services" (NOT the recommendation; flmnt workspace
# bc674142, decision f2f873a8): "Feature's grammar lets a spec declare the subset of configured services it observes."
# A header line `observes <service>[, <service>]...` names services of the config; the IR records them, in written order,
# as a top-level `observes`. INV-6 then reads "every OBSERVED service in every non-query prediction". With no `observes`
# line a spec observes every configured service and its IR has no `observes` key, so every existing exemplar's IR is
# unchanged. One new exemplar, corpus/spec-observes (#20), two ok fixtures and eleven refusal fixtures; one new code,
# UNOBSERVED_SERVICE. Every other scenario is unchanged.
#
# AMENDMENT (ADR-0034, matchers inside a list; founder ruling cc58ae94, 2026-11-20, "Matchers in list items
# (Recommended)"; Q1 7ca2385c, "Refuse it (Recommended)"; agreed 2026-11-20, "Agree (Recommended)"). In a value
# block's matcher position, a list's items, and the fields of an object inside it, are read in matcher position. A
# list with no matcher at any depth is recorded as before, { matcher: "literal", value }, so every existing
# exemplar's IR is unchanged. A list that holds one is { matcher: "list", items }; inside it an object that holds one
# is { matcher: "object", fields } and a matcher-free item or field is a literal; the runtime evaluates them
# (SPEC-RT-015). One new exemplar, corpus/list-matcher (#21), and six refusal fixtures. Every other scenario is
# unchanged.

# AMENDED by founder rulings aee7d787 and 28f7d2d6, agreed b680b51c (ADR-0036): `deliver … to response` names the
# response role, never a service, so it is neither UNKNOWN_SERVICE_KEY nor UNOBSERVED_SERVICE; the IR keeps
# `service: "response"`.

# AMENDMENT (ADR-0038, the `partial` keyword; founder rulings 7d3026eb "Fix specs + Feature lint (Recommended)" and
# 55fb39c4 L1 "`partial` keyword" and L4 "Refuse it in data, values and beside a golden (Recommended)"; the set agreed
# 580f3d10, 2026-11-23). A predicted record or response may write `partial` between its schema name and its value
# block; the IR records "partial": true beside the block, and a block without it records nothing new, so every
# existing exemplar's IR is unchanged. `partial` in a payload or a seed, as a field's value or a list item, beside
# `equals fixture` (before or after), or with no block after it is refused MALFORMED_SYNTAX naming where it goes. One
# new exemplar (fixtures/ok/partial-blocks, SPEC-OK-202) and eight refusal fixtures (SPEC-BAD-136 to -143).

# AMENDMENT DRAFT (ADR-0040, draft; drafts/parser-strict-lines, status draft, awaiting the owner). The owner's ruling
# "Parser wins" (2026-11-25) made the grammar reference describe five behaviours of the parser that break its own
# rules (§1.3: "Malformation is a parse error, never a silent failure"; this spec: "parse errors inside
# construct:/enforce: freeform text are impossible"). This amendment states the stricter rules:
#  1. a scenario with no predict is MISSING_MINIMUM at its opener (today an uncaught TypeError);
#  2. every quoted string is a JSON string: \uXXXX is decoded, any other non-JSON escape is MALFORMED_SYNTAX
#     (today an uncaught SyntaxError in a value, and raw, unrefused text on a line);
#  3. a second when:, predict, response, has or contains for one service, clock at, random seed or header key is
#     MALFORMED_SYNTAX (today the last one wins, silently);
#  4. a trailing comment on a line the parser reads by keyword is MALFORMED_SYNTAX (today a given step becomes
#     context, a touches or handler at line a custom directive, and a comment after a response block is dropped);
#  5. header directives are read in the header only; after it a header-shaped line belongs to its zone (today
#     `status agreed` in construct: sets the header's status).
# One new exemplar, corpus/strict-lines (#22), one ok fixture (SPEC-OK-203) and twenty refusal fixtures
# (SPEC-BAD-144 to -163). No IR field changes, so every other exemplar's IR is unchanged; SPEC-RT-014's recorded
# name changes under rule 2 (its name holds \"<hex>\").

spec SPEC-CORE-001 "Parse a .feat file to BuiltSpec IR"
context Toolchain
aggregate Language
type infrastructure
status draft

construct:
  handler at packages/feat-core/src/parse.ts
  touches packages/feat-core/**
  imports BuiltSpec from @mmmnt/feat-types
  needs SPEC-RT-001
  Implement as a hand-rolled deterministic recursive-descent parser (amendment 2026-07-16:
  Langium's role narrowed to the M6 LSP surface; the corpus keeps both grammars in sync).
  The corpus at corpus/ is ground truth: every exemplar parses to its .ir.json exactly.
  Agent zones are opaque: parse errors inside construct:/enforce: freeform text are impossible.
  The response body is the IR WITHOUT loc (ADR-0013 companion ruling); loc serves LSP surfaces only.
  Parse errors carry line numbers and a hint naming valid alternatives where a closed space is violated.
  A rejection id (in `rejects <ID> when` and `predict rejection <ID>:`) is UPPER_SNAKE ([A-Z0-9_]+) or
  UpperCamel ([A-Z][A-Za-z0-9]*) and is kept verbatim in the IR (ADR-0022). Anything else in the
  rejection-id position of a prediction is MALFORMED_SYNTAX.
  Inside a scenario's given: block `fault` is a reserved first word (ADR-0023): a line that is exactly
  `fault`, or starts `fault` followed by a space or tab, is a fault line and is never freeform context.
  The form is `fault <service> <Operation> <Fault> [{ json }] [once | times <n> | until reset]`, <Operation>
  UpperCamel, <Fault> UpperCamel or UPPER_SNAKE, <n> a positive integer. A well-formed line lands in the
  scenario's given.faults, in written order, as { service, operation, fault, detail?, times } with times
  always present (1 for the default and for once, n, or "reset"). Anything else that begins with the
  reserved word is MALFORMED_SYNTAX. A word that merely begins with the letters, such as `faults` or
  `faultline`, is not reserved and stays freeform. The fault's service joins the closed service space.
  A given whose lines include both a seed and an execute records their kinds in written order as
  given.order, an array of "seed" and "execute", one per line, the n-th "seed" naming given.seeds[n] and
  the n-th "execute" given.executes[n] (ADR-0025). A given with only one of the two kinds has no order.
  In a value block's matcher position, `not` followed by a space or tab and one operand is the negation
  matcher (ADR-0027), recorded as { matcher: "not", operand } with the operand parsed as a matcher. The
  operand is a literal, `@when.<path>`, `@deliver[i].<path>`, `@<service>[i].<path>`, `any <type>`,
  `matching "<regex>"` or an outline placeholder (`<name>`, `matching <name>`). `not not`, `not absent`,
  `not any` without a type, `not { ... }` and a `not` with no operand are MALFORMED_SYNTAX, each with a hint
  naming the spelling to use. A capture reference inside `not` joins the closed service space.
  In a value block's matcher position, `@given.response.<path>` and `@given[i].response.<path>` are the
  given-response reference (ADR-0028), recorded as { matcher: "givenRef", path } with `index` when written;
  `given` is never read as a service key. A given line `random seed <n>`, n a whole number from 0 to
  9007199254740991, is recorded as given.random (ADR-0029); any other line beginning `random seed` is
  MALFORMED_SYNTAX.
  In a value block's matcher position, `f32` followed by a positive integer, `sha256` and a string of 64
  lowercase hexadecimal characters is the f32 digest matcher (ADR-0030), recorded as { matcher: "f32Digest",
  dims, sha256 }. A length that is not a positive integer, a digest that is not 64 lowercase hex, a missing
  part, and `not f32 ...` are MALFORMED_SYNTAX, each with a hint giving the form.
  A header line `observes` followed by one or more service keys separated by commas (spaces or tabs around a comma
  allowed) declares the services the spec observes (ADR-0033), recorded as the IR's top-level `observes`, an array of
  the keys in written order. Each key joins the closed service space: one absent from the config's services is
  UNKNOWN_SERVICE_KEY listing the configured ones. A key written twice, a bare `observes`, an empty item (a leading,
  trailing or doubled comma) and a second `observes` line are MALFORMED_SYNTAX, each with a hint giving the form.
  When a spec declares `observes`, every service a scenario names must be one it declares: a `has` or `contains`
  prediction, a `seed`, a `deliver ... to`, a given `fault` and an `@<service>[i]` capture reference (alone or inside
  `not`) naming a configured service the spec does not declare is UNOBSERVED_SERVICE, naming the service and listing
  the declared ones in the hint ("add it to the observes line"). INCOMPLETE_PREDICTION then checks the declared
  services only, in config order. A spec with no `observes` line is checked against every configured service, as
  before, and its IR carries no `observes`. Declaring every configured service is allowed and is recorded as written.
  In a value block's matcher position, a list `[ ... ]` has its items read in matcher position, and inside it
  `{ ... }` is an object whose fields are read in matcher position, at any depth (ADR-0034). An item or field is a
  literal, an object, a list, a reference (`@when`, `@deliver`, `@given`, `@<service>[i]`), `any [type]`,
  `matching ...`, `not <matcher>` or `f32 ...`; an outline placeholder in it is literal data, as in a literal.
  A list holding no matcher at any depth is recorded as { matcher: "literal", value } exactly as before. Otherwise
  it is { matcher: "list", items }, each matcher-free item or field recorded as { matcher: "literal", value }, each
  object that holds a matcher as { matcher: "object", fields } with fields in written order, and each list that
  holds one as { matcher: "list", items }. `absent` as a list item, `absent` as a field of an object inside a list,
  and `not` over a list that holds a matcher are MALFORMED_SYNTAX, each with a hint giving the spelling to use;
  `not` over a list of literals stays a literal operand. A capture reference inside a list joins the closed service
  space and, when the spec declares observes, the observed space, as one outside it does. A `{ ... }` outside any
  list keeps its value-block meaning, { matcher: "nested", fields }.
  ADR-0040. A scenario with no predict is MISSING_MINIMUM, its line the scenario's opener, its message naming the
  scenario; it is checked with the trigger, before anything reads the prediction. Every quoted string, in a value
  and on a line (spec name, scenario name, clock at, seed from, equals fixture, stream, contract from, a variables
  template), is a JSON string: the escapes are \" \\ \/ \b \f \n \r \t and \uXXXX with four hex digits, the IR records
  the decoded string, and any other escape is MALFORMED_SYNTAX naming it (no line inside a value, the line on a
  line). A second when: or predict in a scenario, a second response in a prediction, a second has or a second
  contains for one service, a second clock at or random seed in a given, and a second spec, context, aggregate,
  type or status line in the header are MALFORMED_SYNTAX at the second line, the message naming the first one's
  line. A trailing comment, a # outside a string with a space or tab before it, is MALFORMED_SYNTAX with its line
  on every compiler-zone line and on a construct: line that is a typed directive once the comment is removed; in
  freeform text (a construct or enforce directive, a given context line) it stays text. Header directives are read
  between the pragma and the first section opener only; after it a header-shaped line is a directive in an agent
  zone, a context line in given:, and an unrecognized line elsewhere.

enforce:
  read the version pragma before anything else
  rejects MISSING_PRAGMA when the first non-comment line is not a feat version pragma
  rejects UNSUPPORTED_VERSION when the pragma names a version this toolchain does not support
  rejects MALFORMED_SYNTAX when a compiler-zone block violates the grammar, a fault line in given: included (ADR-0023), a negation whose operand is not a matcher it takes (ADR-0027), a random seed that is not a whole number in range (ADR-0029), an f32 digest of any other shape (ADR-0030), and a list item or a list object's field that is absent, or a negated list that holds a matcher (ADR-0034)
  rejects UNKNOWN_SERVICE_KEY when a prediction or a given fault targets a service absent from the config services, or a cross-surface capture reference names one (ADR-0021 — a reference names a service, so it shares the closed space)
  rejects UNKNOWN_COMMAND when a when or execute names a command absent from response.commands
  rejects UNDECLARED_SCHEMA when a scenario references a schema absent from the contract block
  rejects UNKNOWN_ACTOR when an as-clause names an actor absent from response.actors
  rejects DUPLICATE_SCENARIO_NAME when two scenarios in one spec share a name
  rejects TRIGGER_MISMATCH when the trigger form does not match the spec type discipline
  rejects QUERY_SIDE_EFFECT when a query spec predicts any service write
  rejects INCOMPLETE_PREDICTION when a non-query prediction omits a configured service, or, when the spec declares observes, an observed one
  rejects UNOBSERVED_SERVICE when a spec that declares observes names, in a prediction, seed, deliver, fault or capture reference, a configured service it does not observe
  accept `deliver … to response` as the response role, never a service reference (ADR-0036)
  rejects UNKNOWN_SERVICE_KEY when an observes line names a service absent from the config services
  rejects MALFORMED_SYNTAX when an observes line names no service, names one twice, has an empty item, or is written twice
  rejects MISSING_MINIMUM when a spec lacks the required minimum sections
  rejects MISSING_MINIMUM when a scenario has no predict block (ADR-0040)
  rejects MALFORMED_SYNTAX when a string holds an escape JSON does not have, a line that is written once per scope is written twice, or a line the parser reads by keyword carries a trailing comment (ADR-0040)
  read header directives in the header only, so a header-shaped line in a zone never changes the header (ADR-0040)
  never throw anything but a coded parse error for any input text (ADR-0040)

contract:
  input ParseInput
  response BuiltSpec
  error ParseError

scenario "parses the founding exemplar (create-flow)":
  when: Parse { spec: "corpus/create-flow/create-flow.feat", config: "corpus/create-flow/feat.config.json" }
  predict success:
    response OK BuiltSpec equals fixture "../../corpus/create-flow/create-flow.ir.json"
    filesystem has []

