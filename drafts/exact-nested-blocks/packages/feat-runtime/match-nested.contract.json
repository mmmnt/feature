{
  "$schema": "https://feat.dev/schemas/contract.json",
  "specId": "SPEC-RT-017",
  "schemas": {
    "MatchInput": {
      "description": "MatchValue takes value + matcher (SPEC-RT-011's probe); its diff form takes records + predicted (+ mode), or response + expect",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {},
        "matcher": {
          "type": "object",
          "required": [
            "matcher"
          ]
        },
        "mode": {
          "enum": [
            "ordered",
            "unordered",
            "contains"
          ]
        },
        "records": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type",
              "payload"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "type": "string"
              },
              "payload": {
                "type": "object"
              }
            }
          }
        },
        "predicted": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type",
              "schemaName"
            ]
          }
        },
        "response": {
          "type": "object",
          "required": [
            "status",
            "body"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {},
            "body": {
              "type": "object"
            }
          }
        },
        "expect": {
          "type": "object",
          "required": [
            "status",
            "schemaName"
          ]
        }
      }
    },
    "MatchResult": {
      "type": "object",
      "required": [
        "outcome",
        "count"
      ],
      "additionalProperties": false,
      "properties": {
        "outcome": {
          "enum": [
            "passed",
            "failed"
          ]
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "violation": {
          "type": "string"
        }
      }
    }
  }
}
