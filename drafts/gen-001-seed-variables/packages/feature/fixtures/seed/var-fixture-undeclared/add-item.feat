feat 1.0

# Fixture workspace for SPEC-GEN-001 (seed variables amendment): a name the spec does not declare, in a fixture, is validated as written

spec SPEC-ITM-001 "Add an item"
context Catalog
aggregate Item
type command
status agreed

construct:
  handler at src/add-item.ts
  touches src/**

enforce:
  rejects ITEM_EXISTS when the item id is already present

contract:
  input AddItemInput
  event ItemEvent
  record ItemRow
  error ItemError

variables:
  until: string = "2030-01-01T00:00:00Z"

scenario "fixture with an undeclared name":
  given:
    The store already holds seeded state.
    seed store from "data/items.json"
  when: AddItem { itemId: "22222222-0000-4000-8000-000000000009" }
  predict rejection ITEM_EXISTS:
    response 409 ItemError
    store has []
