feat 1.0

# SPEC-GEN-001 — seed fixtures are checked when `feat generate` inlines them (ADR-0003 fixture
# form, ADR-0007 closed schema reference space). Today pipeline.ts reads `seed <svc> from "<path>"`,
# casts the JSON and inlines it unchecked. This spec is the missing check. Rulings 79123645 and 473acc1d (Sift, 2026-11-09): fixture seeds are built
# before Sift's specs move forward. Ruling 05537e6e (Sift workspace, 2026-11-09): inline `with <Schema>`
# seed values are validated in the same change, and the founder flipped the spec draft -> agreed.
#
# Amended 2026-11-10 (founder ruling "Flip both (Recommended)", with "Code SEED_ROW_VALUES_INVALID" and "Plain seeds
# checked per row"): a scenario outline's inline seeds are checked once per example row, after that row's values are
# substituted (SPEC-DRV-001), and a violation in a row is SEED_ROW_VALUES_INVALID, anchored with the row. A fixture
# seed in an outline is never substituted and is checked once. SEED_VALUES_INVALID stays for a scenario that is not an outline.
#
# AMENDED copy 2026-11-10 (founder ruling "Resolve, then validate (Recommended)"): the seed check substitutes the spec's
# declared variables (ADR-0017, `${name}`) into seed values before validating, wherever the variable's value is static at
# generate time; a variable with no static value is skipped for that field. Builds on the outline-seeds amendment above.
#
# DRAFT: status draft; this file replaces generate-seed-fixtures.feat when the founder agrees the amendment.
#
# WHAT CHANGED versus generate-seed-fixtures.feat (and nothing else):
#  1. Before an inline record's values (or a fixture record's) are validated, every `${name}` in a string value, at any
#     depth, is replaced exactly as the harness replaces it at run time (feat-runtime substituteVariables): whole-string
#     or embedded, always as a string (a number variable renders as its decimal text), declared names only. The records
#     handed on and inlined are unchanged; only the validated copy is substituted.
#  2. A variable is static at generate time when it is a number literal, a template whose every reference is static, or
#     now()/iso() (with or without an offset) in a scenario that has `clock at`. unique(), and now()/iso() in a scenario
#     with no `clock at`, are not static. A string value that still holds a non-static reference after substitution is
#     skipped: that one field is not constrained, and no schema error at that field's path (or below it) counts.
#  3. A name the spec does not declare is left as written and validated as written, as at run time (in an inline seed
#     the parser has already refused it, UNKNOWN_VARIABLE; only a fixture file can carry one).
#  4. In an outline the row's values are substituted first (SPEC-DRV-001, at derive), then the variables.
#  5. The report gains `skipped`: the anchor of every skipped field, in check order, [] when none.
#  6. Scenarios: twelve added. The twenty existing scenarios are unchanged. No code is added; the contract gains
#     the report's `skipped` array.
#
# Same mechanism as everything else in the closed space: declared names come from the paired
# contract, values are validated by the configured schema adapter (FeatSchemaAdapter.validate, the
# adapter that resolved the registry). Inline `seed <svc> [ T with S {..} ]` records get the same
# values check (ruling 05537e6e); their undeclared names stay the parser's UNDECLARED_SCHEMA.

spec SPEC-GEN-001 "Check and inline seed fixtures at generate time"
context Toolchain
aggregate Generation
type command
status draft

construct:
  handler at packages/feature/src/seed-fixtures.ts
  touches packages/feature/src/seed-fixtures.ts
  touches packages/feature/src/pipeline.ts
  touches packages/feature/generate-seed-fixtures.feat
  touches packages/feature/generate-seed-fixtures.contract.json
  touches packages/feature/fixtures/seed/**
  touches feat.config.json
  imports parse from @mmmnt/feat-core
  needs SPEC-CORE-001
  The workspace is the directory holding the given config. For every spec under the config's specs.dir,
  every seed of the form `seed <service> from "<path>"` is resolved against the directory of the spec
  that names it (never the config directory, never the working directory), read, and parsed as JSON.
  A fixture is a JSON array of records { type: string, schemaName?: string, values: object }, the
  shape of an inline seed record. The step runs before emit; the checked records replace the seed
  in the topology, in file order, so the generated suite carries the data and reads no fixture at run time.
  schemaName is optional per the SeedRecord type: a record without one is shape-checked only. A record
  with one must name a schema declared in the spec's paired contract (the same closed space as ADR-0007),
  and its values must validate against that schema through the configured schema adapter.
  Records are indexed from 0 in file order. Every message names the fixture path exactly as the spec
  wrote it and, for a record problem, the record index.
  The refusal's code is that of the first violation in spec order, then scenario order, then row order (an
  outline's rows in example order), then seed order, then record order; its count is the number of violations
  found, and its detail lists them all, one per line, in that same order.
  The step collects every violation across every fixture of every spec before answering, and writes nothing:
  no generated test file exists after a refusal. The caller (feat generate) writes only after this step answers OK.
  Inline seed records (`seed <service> [ <Type> with <Schema> { ... } ]`) are checked in the same step:
  their values must validate against the declared schema through the same adapter. An undeclared inline
  schema name never reaches this step: the parser refuses it (UNDECLARED_SCHEMA). Inline records are not
  otherwise altered. An inline problem in a plain scenario is anchored `scenario "<name>" given › seed[i] record j`,
  where i is the seed's index in that scenario's given and j the record's index in the list.
  A scenario outline's inline seeds are checked once per example row, on that row's own seeds after its
  values are substituted (SPEC-DRV-001: a whole-value <placeholder> takes the row's value, a placeholder inside
  a string stays literal). Each record that fails is one violation, with the code SEED_ROW_VALUES_INVALID,
  anchored `scenario "<name>" given › seed[i] record j › row[n]`, n the 1-based example row, as derive names
  rows. A row whose substituted values validate raises nothing, whatever the other rows do. An inline seed
  with no placeholder in an outline is still checked in every row, so one bad record is one violation per row.
  A fixture seed (`seed <service> from "<path>"`) in an outline is never substituted, its path included (a
  path written as a placeholder is looked up as written, and is SEED_FIXTURE_NOT_FOUND); it is read, checked and
  counted once for the scenario, not once per row, and every row's seeds carry its checked records. Its problems
  keep their fixture codes and their fixture anchors.
  Variables (ADR-0017) are substituted into the values before they are validated, so the check sees the value the
  harness will seed. The spec's variables reach each case as its table; for every inline record of a scenario or outline
  row, and for every fixture record, each string in the record's values has its `${name}` references replaced, at any
  depth in objects and arrays, in the way the runtime replaces them: a reference is replaced inside the string, whether
  it is the whole string or part of it, with the variable's value as text (a number variable renders as its decimal
  string, so `"${n}"` is a string, never a number); a name the spec does not declare is left as written and validated as
  written. The substituted copy is what the schema adapter validates; the record stays as written and the runtime
  substitutes it again at run time. In an outline the row's values are substituted first (SPEC-DRV-001, at derive) and
  the variables after, so a row cell that holds `"${name}"` takes the variable's value.
  A variable's value is static at generate time when the check can compute the value the runtime will compute: a number
  literal is static; a string template is static when every variable it references is static; `now()`, `now(<ms>)`,
  `iso()` and `iso(<ms>)` are static in a scenario that declares `clock at` and take the instant `clock at` names plus the
  offset, as the runtime does, and are not static in a scenario without `clock at`; `unique()` is never static. A string
  value that still holds a reference to a variable that is not static after substitution is skipped for that field only:
  the schema's constraints at that value's path, and below it, are not applied, every other field of the record is
  checked as usual, and the field is listed in the report's `skipped`, anchored with its path (an RFC 6901 pointer into
  the record's values) after the record's anchor and, in an outline, its row. A scenario or row with no variables is
  checked exactly as before.
  The report always states how many seed records were checked (fixture and inline) and how many fixtures
  were inlined, so a pass is never silent about its input, and which fields were skipped (`skipped`, an array of anchors, empty when none). Inline records of an outline are counted in each
  row; a fixture's records and the fixture itself once.

enforce:
  resolve every fixture path against the directory of the spec that names it
  rejects SEED_FIXTURE_NOT_FOUND when the resolved path names no readable file
  rejects SEED_FIXTURE_NOT_JSON when the file's contents are not valid JSON
  rejects SEED_FIXTURE_NOT_RECORDS when the JSON is not an array of { type, schemaName?, values } records
  rejects SEED_FIXTURE_SCHEMA_UNDECLARED when a record's schemaName is absent from the paired contract
  rejects SEED_FIXTURE_VALUES_INVALID when a fixture record's values fail the declared schema
  rejects SEED_VALUES_INVALID when an inline seed record's values fail the declared schema in a scenario that is not an outline
  rejects SEED_ROW_VALUES_INVALID when an inline seed record's values fail the declared schema in an outline row, after the row's values are substituted
  report every violation in one answer, not only the first
  validate inline seed record values against the declared schema, leaving the records unchanged
  validate each outline row's own substituted seeds, never one shared array, and check a fixture seed once
  substitute the spec's declared variables into seed values before validating, and only where the value is static
  skip a field whose value holds a variable that is not static, constraining no other field, and report it

contract:
  input SeedFixtureInput
  response SeedFixtureReport
  error SeedFixtureError

scenario "a valid fixture is inlined in file order and leaves nothing to read at run time":
  when: InlineSeedFixtures { config: "packages/feature/fixtures/seed/valid/feat.config.json" }
  predict success:
    response OK SeedFixtureReport { specs: 1, fixtures: 1, records: 3, unresolved: 0, recordTypes: ["ItemAdded", "ItemRenamed", "ItemAdded"] }
    filesystem has []

scenario "a fixture path resolves against the spec, not the config":
  when: InlineSeedFixtures { config: "packages/feature/fixtures/seed/relative/feat.config.json" }
  predict success:
    response OK SeedFixtureReport { specs: 1, fixtures: 1, records: 1, unresolved: 0, recordTypes: ["ItemAdded"] }
    filesystem has []

scenario "valid inline seeds pass and are counted without reading any fixture":
  when: InlineSeedFixtures { config: "packages/feature/fixtures/seed/inline/feat.config.json" }
  predict success:
    response OK SeedFixtureReport { specs: 1, fixtures: 0, records: 1, unresolved: 0, recordTypes: ["ItemAdded"] }
    filesystem has []

scenario "an inline record whose values fail the declared schema is refused with its anchor":
  when: InlineSeedFixtures { config: "packages/feature/fixtures/seed/inline-bad/feat.config.json" }
  predict rejection SEED_VALUES_INVALID:
    response ERR SeedFixtureError { code: "SEED_VALUES_INVALID", count: 1, detail: matching "add an item.*given › seed\\[0\\] record 0.*ItemEvent.*/itemId must be string" }
    filesystem has []

scenario "a record naming an undeclared schema is refused with its fixture and index":
  when: InlineSeedFixtures { config: "packages/feature/fixtures/seed/undeclared/feat.config.json" }
  predict rejection SEED_FIXTURE_SCHEMA_UNDECLARED:
    response ERR SeedFixtureError { code: "SEED_FIXTURE_SCHEMA_UNDECLARED", count: 1, detail: matching "data/items\\.json record 1.*NoSuchSchema" }
    filesystem has []

scenario "a record whose values fail the declared schema is refused with the schema error":
  when: InlineSeedFixtures { config: "packages/feature/fixtures/seed/bad-values/feat.config.json" }
  predict rejection SEED_FIXTURE_VALUES_INVALID:
    response ERR SeedFixtureError { code: "SEED_FIXTURE_VALUES_INVALID", count: 1, detail: matching "data/items\\.json record 0.*ItemEvent.*/itemId must be string" }
    filesystem has []

scenario "a fixture file that does not exist is refused and named":
  when: InlineSeedFixtures { config: "packages/feature/fixtures/seed/missing/feat.config.json" }
  predict rejection SEED_FIXTURE_NOT_FOUND:
    response ERR SeedFixtureError { code: "SEED_FIXTURE_NOT_FOUND", count: 1, detail: matching "data/absent\\.json" }
    filesystem has []

scenario "a fixture file that is not JSON is refused and named":
  when: InlineSeedFixtures { config: "packages/feature/fixtures/seed/not-json/feat.config.json" }
  predict rejection SEED_FIXTURE_NOT_JSON:
    response ERR SeedFixtureError { code: "SEED_FIXTURE_NOT_JSON", count: 1, detail: matching "data/items\\.json" }
    filesystem has []

scenario "a fixture that is not an array is refused and named":
  when: InlineSeedFixtures { config: "packages/feature/fixtures/seed/not-array/feat.config.json" }
  predict rejection SEED_FIXTURE_NOT_RECORDS:
    response ERR SeedFixtureError { code: "SEED_FIXTURE_NOT_RECORDS", count: 1, detail: matching "data/items\\.json" }
    filesystem has []

scenario "a record without values is refused with its index":
  when: InlineSeedFixtures { config: "packages/feature/fixtures/seed/bad-record/feat.config.json" }
  predict rejection SEED_FIXTURE_NOT_RECORDS:
    response ERR SeedFixtureError { code: "SEED_FIXTURE_NOT_RECORDS", count: 1, detail: matching "data/items\\.json record 1.*values" }
    filesystem has []

scenario "every violation of every fixture is reported together":
  when: InlineSeedFixtures { config: "packages/feature/fixtures/seed/multi/feat.config.json" }
  predict rejection SEED_FIXTURE_SCHEMA_UNDECLARED:
    response ERR SeedFixtureError { code: "SEED_FIXTURE_SCHEMA_UNDECLARED", count: 3, detail: matching "data/first\\.json record 2" }
    filesystem has []

scenario "inline and fixture violations are reported together":
  when: InlineSeedFixtures { config: "packages/feature/fixtures/seed/mixed/feat.config.json" }
  predict rejection SEED_VALUES_INVALID:
    response ERR SeedFixtureError { code: "SEED_VALUES_INVALID", count: 2, detail: matching "data/items\\.json record 1" }
    filesystem has []

scenario "an outline whose rows all validate after substitution passes and is counted per row":
  when: InlineSeedFixtures { config: "packages/feature/fixtures/seed/outline-ok/feat.config.json" }
  predict success:
    response OK SeedFixtureReport { specs: 1, fixtures: 0, records: 2, unresolved: 0, recordTypes: ["ItemAdded", "ItemAdded"] }
    filesystem has []

scenario "an outline row whose substituted values fail is refused with its row, and the valid row raises nothing":
  when: InlineSeedFixtures { config: "packages/feature/fixtures/seed/outline-bad-row/feat.config.json" }
  predict rejection SEED_ROW_VALUES_INVALID:
    response ERR SeedFixtureError { code: "SEED_ROW_VALUES_INVALID", count: 1, detail: matching "^SEED_ROW_VALUES_INVALID: scenario \"seed per row\" given › seed\\[0\\] record 0 › row\\[2\\]: values fail schema 'ItemEvent': /itemId must be string$" }
    filesystem has []

scenario "every bad row is one violation, whether its value is a number or an object, and a string row passes":
  when: InlineSeedFixtures { config: "packages/feature/fixtures/seed/outline-bad-kinds/feat.config.json" }
  predict rejection SEED_ROW_VALUES_INVALID:
    response ERR SeedFixtureError { code: "SEED_ROW_VALUES_INVALID", count: 2, detail: matching "row\\[2\\][\\s\\S]*row\\[3\\]" }
    filesystem has []

scenario "an inline seed without a placeholder is checked in every row of an outline":
  when: InlineSeedFixtures { config: "packages/feature/fixtures/seed/outline-plain/feat.config.json" }
  predict rejection SEED_ROW_VALUES_INVALID:
    response ERR SeedFixtureError { code: "SEED_ROW_VALUES_INVALID", count: 2, detail: matching "row\\[1\\][\\s\\S]*row\\[2\\]" }
    filesystem has []

scenario "an outline row violation and a plain scenario violation are reported together, the first in spec order names the code":
  when: InlineSeedFixtures { config: "packages/feature/fixtures/seed/outline-mixed/feat.config.json" }
  predict rejection SEED_ROW_VALUES_INVALID:
    response ERR SeedFixtureError { code: "SEED_ROW_VALUES_INVALID", count: 2, detail: matching "seed per row.*given › seed\\[0\\] record 0 › row\\[2\\][\\s\\S]*SEED_VALUES_INVALID: scenario \"add an item\" given › seed\\[0\\] record 0: " }
    filesystem has []

scenario "a fixture seed in an outline is read and counted once, not once per row":
  when: InlineSeedFixtures { config: "packages/feature/fixtures/seed/outline-fixture-ok/feat.config.json" }
  predict success:
    response OK SeedFixtureReport { specs: 1, fixtures: 1, records: 3, unresolved: 0, recordTypes: ["ItemAdded", "ItemRenamed", "ItemAdded"] }
    filesystem has []

scenario "a bad fixture record in an outline is one violation with its fixture code, not one per row":
  when: InlineSeedFixtures { config: "packages/feature/fixtures/seed/outline-fixture-bad/feat.config.json" }
  predict rejection SEED_FIXTURE_VALUES_INVALID:
    response ERR SeedFixtureError { code: "SEED_FIXTURE_VALUES_INVALID", count: 1, detail: matching "^SEED_FIXTURE_VALUES_INVALID: data/items\\.json record 0" }
    filesystem has []

scenario "a fixture path written as a placeholder is not substituted and names the path as written":
  when: InlineSeedFixtures { config: "packages/feature/fixtures/seed/outline-fixture-path/feat.config.json" }
  predict rejection SEED_FIXTURE_NOT_FOUND:
    response ERR SeedFixtureError { code: "SEED_FIXTURE_NOT_FOUND", count: 1, detail: matching "<path>" }
    filesystem has []

scenario "a static literal variable is substituted into a seed value and the record validates":
  when: InlineSeedFixtures { config: "packages/feature/fixtures/seed/var-static-ok/feat.config.json" }
  predict success:
    response OK SeedFixtureReport { specs: 1, fixtures: 0, records: 1, unresolved: 0, recordTypes: ["ItemAdded"], skipped: [] }
    filesystem has []

scenario "a static variable whose value is invalid is refused with the inline code and its anchor":
  when: InlineSeedFixtures { config: "packages/feature/fixtures/seed/var-static-bad/feat.config.json" }
  predict rejection SEED_VALUES_INVALID:
    response ERR SeedFixtureError { code: "SEED_VALUES_INVALID", count: 1, detail: matching "^SEED_VALUES_INVALID: scenario \"item with a bad static variable\" given › seed\\[0\\] record 0: values fail schema 'ItemEvent': /validUntil must match format \"date-time\"$" }
    filesystem has []

scenario "a variable embedded in a string is substituted and the record validates":
  when: InlineSeedFixtures { config: "packages/feature/fixtures/seed/var-embedded/feat.config.json" }
  predict success:
    response OK SeedFixtureReport { specs: 1, fixtures: 0, records: 1, unresolved: 0, recordTypes: ["ItemAdded"], skipped: [] }
    filesystem has []

scenario "an embedded variable that makes the string invalid is refused":
  when: InlineSeedFixtures { config: "packages/feature/fixtures/seed/var-embedded-bad/feat.config.json" }
  predict rejection SEED_VALUES_INVALID:
    response ERR SeedFixtureError { code: "SEED_VALUES_INVALID", count: 1, detail: matching "given › seed\\[0\\] record 0.*ItemEvent.*/validUntil must match format" }
    filesystem has []

scenario "a number variable substitutes as a string, as at run time, so an integer field is refused":
  when: InlineSeedFixtures { config: "packages/feature/fixtures/seed/var-number-typed/feat.config.json" }
  predict rejection SEED_VALUES_INVALID:
    response ERR SeedFixtureError { code: "SEED_VALUES_INVALID", count: 1, detail: matching "/qty must be integer$" }
    filesystem has []

scenario "a relative time source under a frozen clock is static and validates":
  when: InlineSeedFixtures { config: "packages/feature/fixtures/seed/var-clock-ok/feat.config.json" }
  predict success:
    response OK SeedFixtureReport { specs: 1, fixtures: 0, records: 1, unresolved: 0, recordTypes: ["ItemAdded"], skipped: [] }
    filesystem has []

scenario "now under a frozen clock is static, so its epoch string is refused for a date-time field":
  when: InlineSeedFixtures { config: "packages/feature/fixtures/seed/var-clock-bad/feat.config.json" }
  predict rejection SEED_VALUES_INVALID:
    response ERR SeedFixtureError { code: "SEED_VALUES_INVALID", count: 1, detail: matching "/validUntil must match format" }
    filesystem has []

scenario "unique and an iso without a frozen clock are not static, so their fields are skipped and reported":
  when: InlineSeedFixtures { config: "packages/feature/fixtures/seed/var-nonstatic/feat.config.json" }
  predict success:
    response OK SeedFixtureReport { specs: 1, fixtures: 0, records: 1, unresolved: 0, recordTypes: ["ItemAdded"], skipped: ["scenario \"item with non-static variables\" given › seed[0] record 0 › /name", "scenario \"item with non-static variables\" given › seed[0] record 0 › /validUntil"] }
    filesystem has []

scenario "a skipped field does not hide another field of the same record":
  when: InlineSeedFixtures { config: "packages/feature/fixtures/seed/var-nonstatic-sibling/feat.config.json" }
  predict rejection SEED_VALUES_INVALID:
    response ERR SeedFixtureError { code: "SEED_VALUES_INVALID", count: 1, detail: matching "values fail schema 'ItemEvent': /qty must be integer$" }
    filesystem has []

scenario "an outline row's value is substituted first and its variable after, and only the bad row is refused":
  when: InlineSeedFixtures { config: "packages/feature/fixtures/seed/var-outline/feat.config.json" }
  predict rejection SEED_ROW_VALUES_INVALID:
    response ERR SeedFixtureError { code: "SEED_ROW_VALUES_INVALID", count: 1, detail: matching "^SEED_ROW_VALUES_INVALID: scenario \"row and variable\" given › seed\\[0\\] record 0 › row\\[2\\]: values fail schema 'ItemEvent': /validUntil must match format \"date-time\"$" }
    filesystem has []

scenario "a fixture record's variable is substituted like an inline one":
  when: InlineSeedFixtures { config: "packages/feature/fixtures/seed/var-fixture/feat.config.json" }
  predict success:
    response OK SeedFixtureReport { specs: 1, fixtures: 1, records: 1, unresolved: 0, recordTypes: ["ItemAdded"], skipped: [] }
    filesystem has []

scenario "a name the spec does not declare, in a fixture, is validated as written":
  when: InlineSeedFixtures { config: "packages/feature/fixtures/seed/var-fixture-undeclared/feat.config.json" }
  predict rejection SEED_FIXTURE_VALUES_INVALID:
    response ERR SeedFixtureError { code: "SEED_FIXTURE_VALUES_INVALID", count: 1, detail: matching "^SEED_FIXTURE_VALUES_INVALID: data/items\\.json record 0.*/validUntil must match format" }
    filesystem has []
