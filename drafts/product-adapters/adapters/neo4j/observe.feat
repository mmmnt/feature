feat 1.0

# SPEC-ADPNEO-001 — the Neo4j service adapter (@mmmnt/feat-adapter-neo4j, built on the official
# neo4j-driver). DRAFT: status draft until the founder flips it.
#
# Driven through adapters/neo4j/fixtures/probe.mjs (part of the build, inside touches, not
# shipped) against a Neo4j COMMUNITY container the TEST starts (the single user database, bolt://
# direct, auth none or a fixture user; DESIGN.md). `ObserveNeo4j { script, uri?, settleTimeoutMs? }`
# creates one adapter per namespace named in the script and runs a space-separated script.
# The fixture declares options.keys { Order: "orderId", Customer: "customerId" } (Mystery has none).
# Steps:
#   setup:<ns> / observes:<ns>
#   seed:<ns>:<Label>:<key>          adapter.seed(): a node of that label with its key property
#   create:<ns>:<Label>:<key>        the SYSTEM creates a node carrying the label and the namespace label
#   setprop:<ns>:<Label>:<key>:<val> the SYSTEM sets property v on that node
#   remove:<ns>:<Label>:<key>        the SYSTEM detach-deletes the node
#   link:<ns>:<Label>:<key>:<REL>:<Label2>:<key2>   the SYSTEM relates two namespaced nodes
#   linkout:<ns>:<Label>:<key>:<REL> the SYSTEM relates a namespaced node to a node of NO namespace
#   createraw:<Label>:<key>          the SYSTEM creates a node with no namespace label
#   createmystery:<ns>               the SYSTEM creates a namespaced node of label Mystery (no declared key)
#   txopen:<ns>:<Label>:<key> / txclose:<ns>   the SYSTEM creates in an explicit transaction and leaves it open / commits it
#   start / peek / stop / settle / reset : <ns>
#   read:<ns>[:<Label>:<key>]        adapter.read() with or without an expect hint
#   fault:<ns>:<Operation>.<FAULT>:<property>[:once|:times2|:reset]
#   fired:<ns>
# The trace carries the record count for window and read steps, settle true/false,
# `observes:a=<diff>/<state>`, a refused write `create:a!CONSTRAINT_VIOLATION`. `last` is the last
# peek or stop as `TYPE:key` joined by comma, in the adapter's order (nodes before
# relationships, each by key); a node's key is `Label:value`, a relationship's
# `Label:value-[REL]->Label2:value2`. `readVia` is KeyedMatch or NamespaceScan.
#
# Verified (DESIGN.md has the sources): Neo4j Change Data Capture is documented as an Enterprise
# Edition / Aura feature (introduced in 5.13, enabled per database with txLogEnrichment), so a
# Community server has no change feed and the diff is a snapshot comparison; `observes` says
# `snapshot`. The snapshot is exact for what is still there at the end and blind to a node
# created and removed inside the window.

spec SPEC-ADPNEO-001 "Neo4j adapter: snapshot diff, namespaced graph, settle, reset and faults"
context Toolchain
aggregate Adapters
type infrastructure
status draft

construct:
  handler at adapters/neo4j/src/index.ts
  touches adapters/neo4j/**
  needs SPEC-RT-002
  needs SPEC-FPX-001
  Declare `observes = { diff: "snapshot", state: true }` and the fault catalog
  `{ Write: { UNIQUE_CONSTRAINT_VIOLATION: ["reset"] }, Connection: { Timeout: ["reset"],
  ConnectionReset: ["reset"], Partition: ["reset"] } }` (Connection only with `options.proxy`).
  Options: `uri` (or `uriEnv`; bolt:// direct is the supported shape), `auth` (env-var NAMES),
  `keys` (label -> key property, required for every label the system
  writes), `settleTimeoutMs` (default 5000), `proxy`.
  Namespace: received from the runner (SPEC-RT-006) as the config's top-level `namespace`, never an option; the probe maps each script label (a, b) to the namespace `s` + 12 hex of sha256(label), and `raw=<value>` passes a value as is.
  Namespace use: every node the system creates carries the label `ns_<ns>`. A relationship belongs to
  the namespace when both its nodes carry the label; one with exactly one such endpoint is a
  NAMESPACE_BREACH. The label is stripped from the labels the adapter reports.
  startCapture(): snapshot the namespace (nodes with `ns_<ns>`, their relationships) in a read
  transaction. peekCapture()/stopCapture(): snapshot again and diff by identity: a node is
  `(first declared label, key property value)`, a relationship is `(start identity, type, end
  identity)`, parallel equal relationships collapse with `payload.count`. Added = INSERT,
  property-changed = MODIFY, gone = REMOVE; CapturedRecord { type, key, payload: properties plus
  `labels` (nodes) or `from`, `to`, `relType` (relationships), timestamp: the capture time }.
  A namespaced node whose labels declare no key is NODE_KEY_UNDECLARED.
  settle(): false with no window open and false when the URI is a routing one (neo4j://),
  because a read on another member is not ordered after the system's commit. Otherwise poll
  SHOW TRANSACTIONS until no transaction other than the adapter's own is running, then true;
  false if one is still running after settleTimeoutMs. It writes nothing.
  read(query): nodes with `ns_<ns>` and their relationships; with `query.expect` entries that
  give a label and a key literal, a keyed MATCH instead; the same record shape without a
  diff type. The fault placeholder is never returned.
  seed(records): CREATE (n:<type>:ns_<ns> $values) in one transaction, before the window.
  reset(): drop the namespace's fault constraints, DETACH DELETE every node with `ns_<ns>` in
  batches, close the window.
  fault(Write.UNIQUE_CONSTRAINT_VIOLATION, { property }): create a uniqueness constraint
  `feat_<ns>_<property>` on the namespace label itself (FOR (n:ns_<ns>) REQUIRE n.<property>
  IS UNIQUE) and a placeholder node carrying that property with the value the detail gives.

enforce:
  rejects NAMESPACE_INVALID when the namespace does not match ^s[0-9a-f]{12}$, the pattern the runner derives (SPEC-RT-006); defensive, the runner never passes another
  rejects NEO4J_UNREACHABLE when the server does not answer at setup
  rejects NODE_KEY_UNDECLARED when a namespaced node has no label with a declared key property
  rejects NAMESPACE_BREACH when a relationship joins a namespaced node and a node outside the namespace
  rejects FAULT_UNSUPPORTED when a fault is not in the catalog, or when its count is not one the fault declares
  capture and read are restricted to nodes carrying the namespace label
  the namespace label is never reported
  the diff is a snapshot comparison and cannot see a node created and removed inside the window
  settle resolves true only on a direct single-server connection with no other transaction running
  settle resolves false when no window is open, the URI routes, or a transaction stays open
  firedFaults is not implemented because the server reports no write it refused
  reset deletes the namespace's graph and drops the constraints its faults created

contract:
  input ObserveInput
  response ObserveResult
  error ObserveError

scenario outline "a namespace that does not match the runner's pattern is refused":
  when: ObserveNeo4j { script: <script> }
  predict rejection NAMESPACE_INVALID:
    response ERR ObserveError { code: "NAMESPACE_INVALID", detail: matching <detail> }
    filesystem has []
  examples:
    | script         | detail   |
    | "setup:raw=Orders" | "Orders" |
    | "setup:raw=a.b"    | "a.b"    |
    | "setup:raw=S0599e33863c1" | "S0599e33863c1" |
    | "setup:raw=s0599e33863c"  | "s0599e33863c" |

scenario "a server that does not answer is a configuration error at setup":
  when: ObserveNeo4j { script: "setup:a", uri: "unreachable" }
  predict rejection NEO4J_UNREACHABLE:
    response ERR ObserveError { code: "NEO4J_UNREACHABLE", detail: matching "bolt" }
    filesystem has []

scenario "the adapter declares snapshot diff and state":
  when: ObserveNeo4j { script: "setup:a observes:a" }
  predict success:
    response OK ObserveResult { trace: "setup:a observes:a=snapshot/true" }
    filesystem has []

scenario "a window reports nodes and relationships created, changed and removed, seeds excluded":
  when: ObserveNeo4j { script: "setup:a seed:a:Order:o9 seed:a:Order:o2 start:a create:a:Order:o1 create:a:Customer:c1 link:a:Order:o1:PLACED_BY:Customer:c1 setprop:a:Order:o2:7 remove:a:Order:o9 stop:a" }
  predict success:
    response OK ObserveResult {
      trace: "setup:a seed:a seed:a start:a create:a create:a link:a setprop:a remove:a stop:a=5",
      last: "INSERT:Customer:c1,INSERT:Order:o1,MODIFY:Order:o2,REMOVE:Order:o9,INSERT:Order:o1-[PLACED_BY]->Customer:c1"
    }
    filesystem has []

scenario "two namespaces never see each other's graph":
  when: ObserveNeo4j { script: "setup:a setup:b start:a start:b create:a:Order:o1 create:b:Order:o1 create:b:Order:o2 stop:a stop:b" }
  predict success:
    response OK ObserveResult {
      trace: "setup:a setup:b start:a start:b create:a create:b create:b stop:a=1 stop:b=2",
      last: "INSERT:Order:o1,INSERT:Order:o2"
    }
    filesystem has []

scenario "a node with no namespace label is nobody's effect":
  when: ObserveNeo4j { script: "setup:a start:a createraw:Order:o1 stop:a" }
  predict success:
    response OK ObserveResult { trace: "setup:a start:a createraw stop:a=0" }
    filesystem has []

scenario "a namespaced node whose label has no declared key cannot be identified, so the diff refuses":
  when: ObserveNeo4j { script: "setup:a start:a createmystery:a stop:a" }
  predict rejection NODE_KEY_UNDECLARED:
    response ERR ObserveError { code: "NODE_KEY_UNDECLARED", detail: matching "Mystery" }
    filesystem has []

scenario "a relationship that leaves the namespace is a breach, not a silent effect":
  when: ObserveNeo4j { script: "setup:a start:a create:a:Order:o1 linkout:a:Order:o1:SHIPPED_TO stop:a" }
  predict rejection NAMESPACE_BREACH:
    response ERR ObserveError { code: "NAMESPACE_BREACH", detail: matching "SHIPPED_TO" }
    filesystem has []

scenario "snapshot diff cannot see a node created and removed inside the window":
  when: ObserveNeo4j { script: "setup:a start:a create:a:Order:o1 remove:a:Order:o1 stop:a" }
  predict success:
    response OK ObserveResult { trace: "setup:a start:a create:a remove:a stop:a=0" }
    filesystem has []

scenario "a peek reports the window's records and consumes nothing":
  when: ObserveNeo4j { script: "setup:a start:a create:a:Order:o1 peek:a peek:a stop:a" }
  predict success:
    response OK ObserveResult {
      trace: "setup:a start:a create:a peek:a=1 peek:a=1 stop:a=1",
      last: "INSERT:Order:o1",
      peekEqualsStop: true
    }
    filesystem has []

scenario "a peek with no window open is empty":
  when: ObserveNeo4j { script: "setup:a create:a:Order:o1 peek:a" }
  predict success:
    response OK ObserveResult { trace: "setup:a create:a peek:a=0" }
    filesystem has []

scenario "settle vouches on a direct connection once no other transaction runs":
  when: ObserveNeo4j { script: "setup:a start:a create:a:Order:o1 settle:a stop:a" }
  predict success:
    response OK ObserveResult { trace: "setup:a start:a create:a settle:a=true stop:a=1", last: "INSERT:Order:o1" }
    filesystem has []

scenario "settle vouches on an empty window, which is how an absence is proven":
  when: ObserveNeo4j { script: "setup:a start:a settle:a stop:a" }
  predict success:
    response OK ObserveResult { trace: "setup:a start:a settle:a=true stop:a=0" }
    filesystem has []

scenario "settle declines when no window is open":
  when: ObserveNeo4j { script: "setup:a settle:a" }
  predict success:
    response OK ObserveResult { trace: "setup:a settle:a=false" }
    filesystem has []

scenario "settle declines while the system's transaction is open and vouches after it commits":
  when: ObserveNeo4j { script: "setup:a start:a txopen:a:Order:o1 settle:a txclose:a settle:a stop:a", settleTimeoutMs: 500 }
  predict success:
    response OK ObserveResult {
      trace: "setup:a start:a txopen:a settle:a=false txclose:a settle:a=true stop:a=1",
      last: "INSERT:Order:o1"
    }
    filesystem has []

scenario "settle declines on a routing connection, where another member may serve the read":
  when: ObserveNeo4j { script: "setup:a start:a create:a:Order:o1 settle:a stop:a", uri: "routing" }
  predict success:
    response OK ObserveResult { trace: "setup:a start:a create:a settle:a=false stop:a=1", last: "INSERT:Order:o1" }
    filesystem has []

scenario "a read given a label and key matches that node":
  when: ObserveNeo4j { script: "setup:a seed:a:Order:o1 seed:a:Order:o2 read:a:Order:o1" }
  predict success:
    response OK ObserveResult { trace: "setup:a seed:a seed:a read:a:Order:o1=1", readVia: "KeyedMatch" }
    filesystem has []

scenario "a read given no hint reports the namespace only and not the fault placeholder":
  when: ObserveNeo4j { script: "setup:a setup:b seed:a:Order:o1 seed:b:Order:o1 fault:a:Write.UNIQUE_CONSTRAINT_VIOLATION:orderId read:a" }
  predict success:
    response OK ObserveResult {
      trace: "setup:a setup:b seed:a seed:b fault:a:Write.UNIQUE_CONSTRAINT_VIOLATION read:a=1",
      readVia: "NamespaceScan"
    }
    filesystem has []

scenario "reset deletes the namespace's graph and leaves the other one alone":
  when: ObserveNeo4j { script: "setup:a setup:b seed:a:Order:o1 seed:b:Order:o1 reset:a read:a read:b" }
  predict success:
    response OK ObserveResult { trace: "setup:a setup:b seed:a seed:b reset:a read:a=0 read:b=1" }
    filesystem has []

scenario "a node that repeats a unique property is refused when UNIQUE_CONSTRAINT_VIOLATION is armed":
  when: ObserveNeo4j { script: "setup:a fault:a:Write.UNIQUE_CONSTRAINT_VIOLATION:orderId start:a create:a:Order:o1 stop:a" }
  predict success:
    response OK ObserveResult {
      trace: "setup:a fault:a:Write.UNIQUE_CONSTRAINT_VIOLATION start:a create:a!CONSTRAINT_VIOLATION stop:a=0"
    }
    filesystem has []

scenario "reset drops the constraint and the placeholder, so the same create then succeeds":
  when: ObserveNeo4j { script: "setup:a fault:a:Write.UNIQUE_CONSTRAINT_VIOLATION:orderId reset:a start:a create:a:Order:o1 stop:a" }
  predict success:
    response OK ObserveResult {
      trace: "setup:a fault:a:Write.UNIQUE_CONSTRAINT_VIOLATION reset:a start:a create:a stop:a=1",
      last: "INSERT:Order:o1"
    }
    filesystem has []

scenario "the server reports no write it refused, so firedFaults is not offered":
  when: ObserveNeo4j { script: "setup:a fault:a:Write.UNIQUE_CONSTRAINT_VIOLATION:orderId fired:a" }
  predict success:
    response OK ObserveResult { trace: "setup:a fault:a:Write.UNIQUE_CONSTRAINT_VIOLATION fired:a=unobserved" }
    filesystem has []

scenario outline "a fault the binding cannot produce faithfully is refused before it does anything":
  when: ObserveNeo4j { script: <script> }
  predict rejection FAULT_UNSUPPORTED:
    response ERR ObserveError { code: "FAULT_UNSUPPORTED", detail: matching <detail> }
    filesystem has []
  examples:
    | script                                                           | detail         |
    | "setup:a fault:a:Write.UNIQUE_CONSTRAINT_VIOLATION:orderId:once" | "once"         |
    | "setup:a fault:a:Write.DEADLOCK_DETECTED:orderId"                | "DEADLOCK_DETECTED" |
    | "setup:a fault:a:Read.UNIQUE_CONSTRAINT_VIOLATION:orderId"       | "Read"         |
