feat 1.0

# Fixture workspace for SPEC-GEN-001 (outline amendment): an outline whose fixture seed has an invalid record

spec SPEC-ITM-001 "Add an item"
context Catalog
aggregate Item
type command
status agreed

construct:
  handler at src/add-item.ts
  touches src/**

enforce:
  rejects ITEM_EXISTS when the item id is already present

contract:
  input AddItemInput
  event ItemEvent
  record ItemRow
  error ItemError

scenario outline "seed per row":
  given:
    The store already holds seeded state.
    seed store from "data/items.json"
  when: AddItem { itemId: "22222222-0000-4000-8000-000000000009" }
  predict rejection ITEM_EXISTS:
    response 409 ItemError
    store has []
  examples:
    | id |
    | "11111111-0000-4000-8000-000000000001" |
    | "11111111-0000-4000-8000-000000000002" |
