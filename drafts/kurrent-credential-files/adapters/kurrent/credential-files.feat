feat 1.0

# SPEC-ADPKUR-005 — Kurrent adapter: the instrument's credential is read from a file (an amendment to SPEC-ADPKUR-001, in a spec of its own).
# DRAFT for the founder's flip. Direction ruled 2026-11-13 for the flmnt integration tier, chosen verbatim: "Feature reads a file (Recommended)":
# a consumer whose secrets live in files (Docker secrets, a mounted secrets directory) must be able to hand the adapter a PATH, never a
# secret and never an environment variable that holds one. The environment-variable forms of SPEC-ADPKUR-001 stay, unchanged.
#
# What is added to the options (all paths; no option holds a secret):
#   connectionStringFile   a file whose content is the whole connection string. Exactly one of connectionString, connectionStringEnv,
#                          connectionStringFile is given.
#   system.passwordFile    with system.user (a literal login name, not a secret), the instrument's credentials: the password is the file's
#                          content. The environment form `system: { username, password }` (variable names) is the other form; the two
#                          forms are never mixed in one `system`.
# Reading a file:
#   - A relative path is resolved against the working directory of the run (the project root `feat run` starts in), as the client resolves
#     its own `tlsCAFile`.
#   - The file is read when the connection is resolved, before any connection: setup(), connectionTarget() and connectionRefusal().
#   - Exactly one trailing line ending (LF or CRLF) is removed, since a secret written by `echo` or an editor ends in one; nothing else is
#     trimmed, so a password with inner or leading spaces is kept as written.
#   - A path that is missing, is a directory, cannot be read, or holds nothing after the line ending is removed is refused at setup() with
#     CREDENTIAL_FILE_UNREADABLE before the adapter connects to anything. The detail names the option and the path and the cause; it never
#     carries the file's content.
#   - Two connection sources, or the two `system` forms mixed, are refused at setup() with OPTIONS_INVALID (the code SPEC-ADPKUR-004 added)
#     naming the options, before any read of a file and before any connection.
# Trusting a certificate authority needs no new option: `tlsCAFile=<path>` is the client's own connection-string parameter
# (@kurrent/kurrentdb-client 1.3.2 reads the file when the client is created), and the adapter passes every parameter through unchanged
# (SPEC-ADPKUR-004 rule 3). One scenario below proves that a connection string from a file keeps it.
#
# Driven through the probe of SPEC-ADPKUR-001 (adapters/kurrent/fixtures/probe.mjs, inside touches, not shipped).
# `ObserveKurrentCredentials { source, content?, path?, script? }` writes the fixture node's admin identity into a file in a fresh temporary
# directory and creates the adapter for namespace `a` from it:
#   source "passwordFile"           options { connectionString: <the node's string with no credentials>, system: { user: "admin", passwordFile } }
#   source "connectionStringFile"   options { connectionStringFile } where the file holds the node's string with the admin credentials
#   source "connectionStringAndFile" both connectionString and connectionStringFile
#   source "systemMixed"            system: { username: <var>, password: <var>, user: "admin", passwordFile }
#   content (default "exact")       "exact": the secret alone; "lf": the secret then "\n"; "crlf": the secret then "\r\n"; "empty": nothing;
#                                   "lfOnly": "\n" alone; "innerSpace": a user the probe creates on the node, whose password starts with
#                                   a space and has one inside, logged in as that user; "withCaFile" (connectionStringFile only): the string
#                                   with `&tlsCAFile=<a path in the directory>` appended
#   path (default "absolute")       "absolute": the file's absolute path; "relative": the same file, given relative to the working directory;
#                                   "missing": a path in the directory where nothing was written; "directory": the directory itself
#   script                          the steps of SPEC-ADPKUR-001 and SPEC-ADPKUR-004 (setup, start, write, settle, stop, params, rule, ...)
# The connection strings carry tls=true&tlsVerifyCert=false, as SPEC-ADPKUR-004's do. The probe never prints a secret: `params:` already
# removes it. The file and its directory are removed after the case.

spec SPEC-ADPKUR-005 "Kurrent adapter: the instrument's credential and connection string are read from files the config names by path"
context Toolchain
aggregate Adapters
type infrastructure
status draft

construct:
  handler at adapters/kurrent/src/index.ts
  touches adapters/kurrent/**
  touches feat.config.json
  needs SPEC-ADPKUR-001
  needs SPEC-ADPKUR-004
  Add `connectionStringFile` (a path) to the adapter's options, and `user` with `passwordFile` (a literal login name and a path) as the second
  form of `options.system`. Resolve the connection in one place (the resolveConnection of SPEC-ADPKUR-004): first refuse two connection
  sources or a mixed `system` with OPTIONS_INVALID; then read any file (relative to process.cwd()), remove exactly one trailing "\n" or
  "\r\n", and refuse a missing, unreadable, directory or empty file with CREDENTIAL_FILE_UNREADABLE; then apply the TLS host rule and the
  credentials as today. connectionRefusal() returns the first of these codes; connectionTarget() never throws for a refusal; setup() throws it
  before the first connection. Add CREDENTIAL_FILE_UNREADABLE to KurrentAdapterErrorCode. Document both options in the README.

enforce:
  rejects OPTIONS_INVALID when more than one of connectionString, connectionStringEnv and connectionStringFile is given, before any file is read or any connection
  rejects OPTIONS_INVALID when one system mixes the variable names (username, password) with user and passwordFile, before any file is read or any connection
  rejects CREDENTIAL_FILE_UNREADABLE when a named file is missing, is a directory, cannot be read, or is empty after one trailing line ending is removed, before any connection
  the detail of CREDENTIAL_FILE_UNREADABLE names the option and the path and never the file's content
  exactly one trailing LF or CRLF is removed from a file's content and nothing else is trimmed
  a relative path is resolved against the working directory of the run
  every connection-string parameter from a file is passed through unchanged, tlsCAFile included
  the environment-variable forms of SPEC-ADPKUR-001 behave exactly as before

contract:
  input CredentialsInput
  response ObserveResult
  error ObserveError

scenario "a password read from a file connects the instrument, and the system's writes are observed":
  when: ObserveKurrentCredentials { source: "passwordFile", script: "setup:a start:a write:a:orders:Placed settle:a stop:a" }
  predict success:
    response OK ObserveResult { trace: "setup:a start:a write:a settle:a=true stop:a=1", last: "orders/Placed" }
    filesystem has []

scenario outline "one trailing line ending is removed, so a secret written by echo or an editor still connects":
  when: ObserveKurrentCredentials { source: "passwordFile", content: <content>, script: "setup:a start:a write:a:orders:Placed settle:a stop:a" }
  predict success:
    response OK ObserveResult { trace: "setup:a start:a write:a settle:a=true stop:a=1", last: "orders/Placed" }
    filesystem has []
  examples:
    | content |
    | "lf"    |
    | "crlf"  |

scenario "nothing but the line ending is trimmed, so a password with a space in it is kept":
  when: ObserveKurrentCredentials { source: "passwordFile", content: "innerSpace", script: "setup:a start:a write:a:orders:Placed settle:a stop:a" }
  predict success:
    response OK ObserveResult { trace: "setup:a start:a write:a settle:a=true stop:a=1", last: "orders/Placed" }
    filesystem has []

scenario "a relative path is read from the run's working directory":
  when: ObserveKurrentCredentials { source: "passwordFile", path: "relative", script: "setup:a start:a write:a:orders:Placed settle:a stop:a" }
  predict success:
    response OK ObserveResult { trace: "setup:a start:a write:a settle:a=true stop:a=1", last: "orders/Placed" }
    filesystem has []

scenario "a connection string read from a file connects, and its parameters reach the client unchanged":
  when: ObserveKurrentCredentials { source: "connectionStringFile", script: "params:a setup:a start:a write:a:orders:Placed settle:a stop:a" }
  predict success:
    response OK ObserveResult { trace: "params:a=admin?tls=true&tlsVerifyCert=false setup:a start:a write:a settle:a=true stop:a=1", last: "orders/Placed" }
    filesystem has []

scenario "a tlsCAFile parameter in a connection string from a file is passed to the client as written":
  when: ObserveKurrentCredentials { source: "connectionStringFile", content: "withCaFile", script: "params:a" }
  predict success:
    response OK ObserveResult { trace: matching "^params:a=admin\\?tls=true&tlsVerifyCert=false&tlsCAFile=" }
    filesystem has []

scenario outline "a password file that cannot be used is refused before the adapter connects to anything":
  when: ObserveKurrentCredentials { source: "passwordFile", content: <content>, path: <path>, script: "setup:a" }
  predict rejection CREDENTIAL_FILE_UNREADABLE:
    response ERR ObserveError { code: "CREDENTIAL_FILE_UNREADABLE", detail: matching <detail> }
    filesystem has []
  examples:
    | content  | path        | detail                     |
    | "exact"  | "missing"   | "passwordFile.*missing"    |
    | "exact"  | "directory" | "passwordFile.*directory"  |
    | "empty"  | "absolute"  | "passwordFile.*empty"      |
    | "lfOnly" | "absolute"  | "passwordFile.*empty"      |

scenario "a connection-string file that is missing is refused the same way, naming its option":
  when: ObserveKurrentCredentials { source: "connectionStringFile", path: "missing", script: "setup:a" }
  predict rejection CREDENTIAL_FILE_UNREADABLE:
    response ERR ObserveError { code: "CREDENTIAL_FILE_UNREADABLE", detail: matching "connectionStringFile.*missing" }
    filesystem has []

scenario "the refusal is known without a connection, so connectionRefusal reports it":
  when: ObserveKurrentCredentials { source: "passwordFile", path: "missing", script: "rule:a" }
  predict success:
    response OK ObserveResult { trace: "rule:a=CREDENTIAL_FILE_UNREADABLE" }
    filesystem has []

scenario "two connection sources are refused before any file is read":
  when: ObserveKurrentCredentials { source: "connectionStringAndFile", path: "missing", script: "setup:a" }
  predict rejection OPTIONS_INVALID:
    response ERR ObserveError { code: "OPTIONS_INVALID", detail: matching "connectionString.*connectionStringFile" }
    filesystem has []

scenario "a system that mixes variable names with a password file is refused":
  when: ObserveKurrentCredentials { source: "systemMixed", script: "setup:a" }
  predict rejection OPTIONS_INVALID:
    response ERR ObserveError { code: "OPTIONS_INVALID", detail: matching "system.*passwordFile" }
    filesystem has []
