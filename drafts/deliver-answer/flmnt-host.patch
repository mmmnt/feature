diff --git a/crates/flmnt-kernel/src/registration.rs b/crates/flmnt-kernel/src/registration.rs
index dabb56d..c09c524 100644
--- a/crates/flmnt-kernel/src/registration.rs
+++ b/crates/flmnt-kernel/src/registration.rs
@@ -291,5 +291,36 @@ pub async fn issue(
     let command = COMMANDS
         .iter()
         .find(|c| c.context == context && c.name == name)?;
-    Some((command.handle)(ctx, ports, input).await)
+    let reply = (command.handle)(ctx, ports, input).await;
+    record_issued(context, name, &reply);
+    Some(reply)
+}
+
+/// What one in-process [`issue`] answered, as the spec host reports a delivered policy's outcomes (Feature ADR-0037;
+/// flmnt founder ruling 10d35eb4): the command's context and name, its status, and the refusal's code when it refused.
+#[derive(Debug, Clone, PartialEq, serde::Serialize)]
+pub struct Issued {
+    pub context: String,
+    pub command: String,
+    pub status: Value,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub code: Option<String>,
+}
+
+static ISSUED: std::sync::Mutex<Vec<Issued>> = std::sync::Mutex::new(Vec::new());
+
+fn record_issued(context: &str, name: &str, reply: &Reply) {
+    let code = reply
+        .body
+        .as_ref()
+        .and_then(|b| b.get("code"))
+        .and_then(Value::as_str)
+        .map(str::to_owned);
+    let issued = Issued { context: context.to_owned(), command: name.to_owned(), status: reply.status.clone(), code };
+    ISSUED.lock().unwrap_or_else(std::sync::PoisonError::into_inner).push(issued);
+}
+
+/// Takes every [`Issued`] recorded since the last take, in the order the commands were issued.
+pub fn take_issued() -> Vec<Issued> {
+    std::mem::take(&mut *ISSUED.lock().unwrap_or_else(std::sync::PoisonError::into_inner))
 }
