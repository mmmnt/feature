    cases: [ { anchor: "c1", name: "c1", delivers: [ { event: "Placed", payload: { n: 1, answer: { issued: [ { context: "c", command: "X", status: 409, code: "E" } ] } }, service: "response" }, { event: "Placed", payload: { n: 2 }, service: "response" } ], prediction: { type: "success", response: { status: "OK", schemaName: "Placed", valueBlock: { issued: { matcher: "literal", value: [ { context: "c", command: "X", status: 409, code: "E" } ] } } }, services: { store: { ordering: "ordered", records: [] } } } } ]
