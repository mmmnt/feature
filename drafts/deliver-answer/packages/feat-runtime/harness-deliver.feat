    config: "packages/feat-runtime/fixtures/harness/deliver-both.config.json"
    cases: [ { anchor: "c1", name: "c1", delivers: [ { event: "Placed", payload: { n: 1, answer: { issued: [ { context: "c", command: "X", status: 409, code: "E" } ] } }, service: "response" } ], prediction: { type: "success", services: { store: { ordering: "ordered", records: [] } } } } ]
