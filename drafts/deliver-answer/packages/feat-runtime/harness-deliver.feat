scenario "when several deliveries to response answer, the last answer is the case's response":
  when: RunHarnessCase {
    config: "packages/feat-runtime/fixtures/harness/deliver-both.config.json"
    cases: [ { anchor: "c1", name: "c1", delivers: [ { event: "Placed", payload: { n: 1, answer: { issued: [ { context: "c", command: "X", status: 409, code: "E" } ] } }, service: "response" }, { event: "Placed", payload: { n: 2, answer: { issued: [ { context: "c", command: "Y", status: 200 } ] } }, service: "response" } ], prediction: { type: "success", response: { status: "OK", schemaName: "Placed", valueBlock: { issued: { matcher: "literal", value: [ { context: "c", command: "Y", status: 200 } ] } } }, services: { store: { ordering: "ordered", records: [] } } } } ]
  }
