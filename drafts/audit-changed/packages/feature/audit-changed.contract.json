{
  "$schema": "https://feat.dev/schemas/contract.json",
  "specId": "SPEC-CHG-001",
  "schemas": {
    "ChangedInput": {
      "type": "object",
      "required": ["config", "paths"],
      "additionalProperties": false,
      "properties": {
        "config": { "type": "string", "minLength": 1 },
        "paths": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "ChangedReport": {
      "type": "object",
      "required": ["checked", "specd", "unspecd"],
      "additionalProperties": false,
      "properties": {
        "checked": { "type": "integer", "minimum": 0 },
        "specd": { "type": "integer", "minimum": 0 },
        "unspecd": { "type": "integer", "minimum": 0 }
      }
    },
    "ChangedError": {
      "type": "object",
      "required": ["code"],
      "properties": {
        "code": { "enum": ["NO_SPECS_FOUND", "SPEC_UNPARSEABLE", "OUTSIDE_TOUCHES", "HANDLER_OUTSIDE_FEATURE"] },
        "detail": { "type": "string" }
      }
    }
  }
}
