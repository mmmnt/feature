feat 1.0

# SPEC-RPC-002 — the host sharing of @mmmnt/feat-adapter-stdio-jsonrpc: ONE spec host per
# spec file, shared by the file's response role and every service role (Feat Host Protocol,
# schemas/feat-host-protocol.schema.json). Rationale: Feature's runner spawns `vitest run`;
# vitest runs files in parallel workers and a file's tests in order, and the harness builds
# adapters once per file (packages/feat-runtime/src/harness.ts), so scenarios in a host never overlap.
# Agreed and ordered built by Sift decision 58a4ac88 (2026-11-09). AMENDED by founder ruling
# 2026-11-09, RPC-002 A: the answer's per-file facts are an object KEYED BY FILE NAME
# (`files: { a: { ... } }`), not an array — nested value blocks match partially, so a scenario asserts
# only the facts it lists; array elements compare exactly, which made two scenarios with one input
# unsatisfiable. No language change.
# AMENDED by founder rulings 02af6938 (2026-11-24, item 6 "Fix as part of the build"; ADR-0039): a nested value block
# is now exact, so each file's facts block states every fact the probe answers for it (the values the probe gives,
# checked on Linux, where the timeout scenarios run); a scenario's subject is still the facts it was written for.
# AMENDED by founder ruling 5f05d5e1 (2026-11-14, "Seedable randomness", ADR-0029): the response role carries a
# case's random seed to the host by setSeed(seed), a whole number or null; a seed that is not a whole number
# from 0 to 2^53-1 is INVALID_SEED before any host call; a host that answers method not found leaves the seed
# refused, never ignored. The harness sends a seed only for a case that declares one and null on the next.
#
# AMENDED and agreed by founder decision 78a98840 (2026-11-23, "Ratify, build, release (Recommended)"; rulings cd46cd64):
# A request on the shared host that times out (HOST_TIMEOUT) ends the connection. Until now the timer
# only dropped the pending request and left the host working on it, and the line reader handed every
# line to whichever request was pending ("one request is outstanding, so any line answers it"). The
# late answer to request n was taken as the answer to request n+1 (PROTOCOL_VIOLATION: the answer
# carries id n, the request carried n+1), n+1's answer went to n+2, and every later result of the
# file was wrong or misleading. Amended: the request that timed out fails HOST_TIMEOUT; the adapter
# writes nothing more to that host and ends it (close stdin, kill after the grace period); every
# pending and every later call of every role of that file fails HOST_ENDED, a code of its own, its
# detail naming the method that timed out and the limit (a real crash keeps HOST_CRASHED); the registry entry is dropped, so no other file is affected and a file
# whose roles all leave and set up again gets a fresh host. The limit stays 30 s and is not
# configurable on a shared host; RunFiles alone passes its registry a shorter one (requestTimeoutMs)
# so a scenario need not wait 30 s. No protocol or schema change; the version stays 2. The one-shot
# exchange (SPEC-RPC-001) already ends its host on a timeout and is unchanged.
# Founder rulings cd46cd64 (2026-11-23) on workshop 3792ac58: (1) end the host; (2) a new code
# HOST_ENDED, not HOST_CRASHED, for the pending and later calls, its detail naming the method and the
# limit, a real crash keeping HOST_CRASHED; (3) the shorter limit is a HostRegistry constructor
# parameter only the test driver passes; (4) close stdin, then kill after 2 s, in the background;
# (5) release as a minor bump, 0.8.0, once the build is agreed.
# AMENDED and agreed by founder decision 40f96664 (2026-11-24, "Ratify, merge, release (Recommended)"; ruling bf2a3178, "Add a scenario first"):
# the last scenario, "a role that sets up after a timeout, while the ended host is still exiting, gets a fresh
# host and never the ended one", and the RunFiles input lateRole it uses. Dropping the registry entry at the
# timeout was not observable before: join spawns afresh once the ended host's process is gone, and every
# role sets up before the first case. lateRole names a role RunFiles sets up right after the first
# HOST_TIMEOUT; the fake host's late-invoke-slow-exit mode takes 1500 ms to exit once stdin closes (inside
# the 2 s grace), so that setup lands while the ended host still runs. lateRole, like requestTimeoutMs, is
# an input of the test driver only, unreachable from adapter config or feat.config.json.
# The fake host's late-invoke mode answers requests one at a time, as a host is bound to, and answers
# the first invoke 600 ms late, so the requests written after it wait behind it. It logs every method
# it receives; receivedAfterTimeout is what reached it after the client saw the timeout.
#
# AMENDMENT DRAFT (drafts/rpc-002-deterministic-timeouts, status draft, awaiting the owner): the timeout scenarios
# run without a race. The last scenario failed CI on Node 26 with `lateRoleOutcome: expected "ok", got
# "HOST_TIMEOUT"`. Cause: RunFiles's requestTimeoutMs (200 ms) is the limit of EVERY request of the file's registry
# (src/host.ts:100-106, the timer each request starts as it writes the request; src/host.ts:177, the registry hands the
# limit to each host it spawns), so the late role's setup on the host it has just spawned must be answered within
# 200 ms of being written, Node's start-up of fake-host.mjs included. Measured on a 16-core macOS host also running
# other work, Node 24.19.0, from spawn to the setup answer (HostConnection.spawn, then request("setup"); the timed
# window is the part after the write), 40 runs: with no load added, p50 173 ms, max 217 ms, 5 of 40 over 200 ms;
# with 8 busy loops added, p50 188 ms, max 231 ms, 9 of 40 over 200 ms. The scenario's input through runFiles:
# 1 of 10 runs with no load added answered lateRoleOutcome HOST_TIMEOUT; with the 8 busy loops, 5 of 20 did and 5
# more failed the whole file HOST_TIMEOUT at the first role's setup, which every scenario naming requestTimeoutMs
# risks. Two more clocks race in the fixture: the first invoke is answered 600 ms late against the 200 ms limit,
# and late-invoke-slow-exit exits 1500 ms after stdin closes against the registry's 2 s kill, so "the ended host is
# still exiting" when the late role sets up is a margin, not a fact; and RunFiles sleeps 20 ms before counting live
# hosts (src/run-files.ts:168). WHAT CHANGES (RunFiles and the fake host only; the adapters' own limit, grace and
# behaviour do not change):
#  1. requestTimeoutMs limits the invoke requests of the file only. Every other request (setup, reset, setClock,
#     capture, settle, teardown) keeps the adapters' 30 s limit, so a request that must be answered never races the
#     short limit. The limit stays a HostRegistry constructor parameter only the test driver passes (ruling
#     cd46cd64 (3)); it now names the methods it applies to.
#  2. The late-invoke modes never answer the first invoke on time: they hold its answer until their stdin closes,
#     which is the client ending the host after HOST_TIMEOUT, then write it (the late line the client must not take
#     for another request's). The timeout is then certain whatever the limit and the load.
#  3. late-invoke-slow-exit becomes late-invoke-held: after its stdin closes it does not exit until it receives
#     SIGTERM. RunFiles records endedHostAliveAtLateSetup, sets the late role up, records its outcome, and only then
#     sends SIGTERM to the ended host. For a file with lateRole, RunFiles's registry does not kill an ended host
#     after 2 s; it waits for it to exit (a registry parameter only the test driver passes, as the limit). So the
#     ended host is alive at the late setup by construction.
#  4. RunFiles counts live hosts after every role's teardown has awaited its host's exit, with no sleep.
#  5. One new scenario proves (1): a host that answers setup 500 ms late, under requestTimeoutMs 200, serves.
# The facts every scenario predicts are unchanged.
#
# Scope: the lifecycle (who spawns, who ends, what a crash does, what a mismatch does) and
# the protocol semantics the adapter relies on: settle (ADR-0021), peekCapture (ADR-0020),
# the clock through setClock, and the runner namespace (SPEC-RT-006). The exchange itself is SPEC-RPC-001.
# RunFiles drives the real adapter classes against the fake host of
# adapters/stdio-jsonrpc/fixtures/fake-host.mjs, one simulated spec file per entry of `files`
# (each file gets its own module registry, as a vitest worker gives it). Per file it runs:
# per case (one per entry of `clocks`, default one case with null): reset every service role, then
# setClock(clock) on the response role first and then on each service role in listed order, then for
# every service role startCapture, settle, peekCapture twice, stopCapture, and one invoke from the
# response role; teardown every role in order. The fake host --mode picks canned, echo, crash-on-invoke, spawn-task (invoke returns
# at once and a spawned task writes a record 200 ms later; settle waits for it),
# spawn-task-failed (that task aborts), unvouched (settle cannot vouch). It is part of the
# build and sits inside touches.
# Every setup carries the file's `namespace`; the fake host keeps the first namespace it is given,
# echoes it, and answers -32602 to a later setup that names another; FEAT_NAMESPACE is placed in the
# host's environment at spawn and the host reports it.
#
# The clock reaches the adapters through the optional setClock(clock: string | null) of
# drafts/adapter-interface/DESIGN.md section c, called by the harness every case after the resets.

spec SPEC-RPC-002 "Share one spec host per spec file"
context Toolchain
aggregate Host
type command
status draft

construct:
  handler at adapters/stdio-jsonrpc/src/run-files.ts
  touches adapters/stdio-jsonrpc/**
  touches feat.config.json
  needs SPEC-RPC-001
  The adapter is created with the runner's namespace (config.namespace, SPEC-RT-006). The adapter keeps a module-scoped registry of open hosts keyed by the canonical host
  configuration (command, cwd, env; never the namespace: one host per file already means one namespace per host). A role's setup looks its key up: the first role to set up
  spawns the host and sends the Feat Host Protocol setup for its own services; later roles join the
  open host and send setup for theirs. Setup is additive: it opens the named services and never
  closes or clears another role's. Each role's teardown sends teardown for its own services and
  leaves; the last role to leave ends the host (close stdin, then kill after a grace period). A
  role whose host configuration differs from the open host's is refused. When the host process
  exits, every pending and every later call of every role of that file fails with HOST_CRASHED;
  the registry entry is dropped so no other file is affected. When a request has no answer within
  the limit (30 s; a RunFiles file may name requestTimeoutMs, which limits its invoke requests only), that request fails
  HOST_TIMEOUT, the connection writes nothing more to the host and ends it (close stdin, then kill
  after the grace period), and every pending and every later call of every role of that file fails
  HOST_ENDED, its detail naming the method that timed out and the limit (a host that exits by
  itself still fails them HOST_CRASHED); a line the host writes after that is
  never taken as another request's answer. The scenario clock travels by setClock on each role, after the resets (an ISO-8601 time with a zone designator freezes it, null unfreezes it).
  settle returns the host's answer: true only when the host proves every task the scenario spawned
  has finished and written; false whenever it cannot vouch. peekCapture reads the captured
  records without consuming them; stopCapture returns them and closes the window.

enforce:
  one registry entry per host configuration within a spec file; separate files never share one
  rejects PROTOCOL_MISMATCH when the host's setup result names a protocol version other than 2, before any case runs
  rejects NAMESPACE_NOT_HONOURED when the host's setup result names a namespace other than the one sent, before any case runs
  rejects PROTOCOL_VIOLATION when the host's setup answer lacks the namespace echo or violates the protocol schema (the SPEC-RPC-001 exchange rule, surfaced for the file)
  rejects HOST_ERROR when the host refuses a role's setup, for instance with -32602 for a namespace other than the file's
  rejects INVALID_CLOCK when setClock is given a time without a zone designator, refused before any setClock reaches the host
  carry a case's random seed to the host by setSeed on the response role, a null seed unseeding it (ADR-0029)
  rejects INVALID_SEED when setSeed is given a seed that is not a whole number from 0 to 9007199254740991, refused before any setSeed reaches the host
  rejects HOST_CONFIG_MISMATCH when a role's host configuration differs from the host already open for its file
  fail with HOST_TIMEOUT a request the host does not answer within the limit, then write nothing more to that host and end it
  rejects HOST_ENDED when a role of a file calls after the file's host was ended after a timeout, the detail naming the method that timed out and the limit
  never take a line the host writes after a timeout as the answer to another request
  on every outcome leave no host process running
  make every timeout scenario certain by construction: the fake host withholds the answer meant to be late until the client has ended it, a request meant to be answered runs under the 30 s limit, and the ended host exits when the driver releases it, never on a timer

contract:
  input RunFilesInput
  response RunFilesResult
  error SharingError

scenario "one host serves the response role and every service role of a spec file":
  when: RunFiles { files: [{ name: "a", namespace: "s0599e33863c1", host: { command: ["node", "adapters/stdio-jsonrpc/fixtures/fake-host.mjs", "--mode", "canned"] }, roles: ["response", "log", "kv"] }] }
  predict success:
    response OK RunFilesResult { files: { a: { hostsSpawned: 1, spawnedBy: "response", endedBy: "kv", hostsAlive: 0, roleOutcomes: { response: "ok", log: "ok", kv: "ok" }, aliveAfterTeardown: [true,true,false], setups: [[],["log"],["kv"]], setupNamespaces: ["s0599e33863c1","s0599e33863c1","s0599e33863c1"], hostEnvNamespace: "s0599e33863c1", clocks: [null,null,null], clockRoles: ["response","log","kv"], resetsBeforeClock: true, settled: {"log":true,"kv":true}, peeks: [2,2], stopped: 2, recordsVisibleAfterSettle: 2 } }, distinctHosts: 1 }
    filesystem has []

scenario "the first role to set up spawns the host, whichever role it is":
  when: RunFiles { files: [{ name: "a", namespace: "s0599e33863c1", host: { command: ["node", "adapters/stdio-jsonrpc/fixtures/fake-host.mjs", "--mode", "canned"] }, roles: ["log", "response", "kv"] }] }
  predict success:
    response OK RunFilesResult { files: { a: { hostsSpawned: 1, spawnedBy: "log", endedBy: "kv", hostsAlive: 0, aliveAfterTeardown: [true,true,false], roleOutcomes: {"log":"ok","response":"ok","kv":"ok"}, setups: [["log"],[],["kv"]], setupNamespaces: ["s0599e33863c1","s0599e33863c1","s0599e33863c1"], hostEnvNamespace: "s0599e33863c1", clocks: [null,null,null], clockRoles: ["response","log","kv"], resetsBeforeClock: true, settled: {"log":true,"kv":true}, peeks: [2,2], stopped: 2, recordsVisibleAfterSettle: 2 } }, distinctHosts: 1 }
    filesystem has []

