feat 1.0

# SPEC-ADPNEO-005 — Neo4j adapter: a consumer's spec host may transform seed values before they are written, and every seed
# value is checked against what Neo4j can store (an amendment to SPEC-ADPNEO-001 and SPEC-ADPNEO-004, in a spec of its own,
# as SPEC-ADPNEO-003 and -004 are). DRAFT. Founder ruling 944b1d17 ("Feature seed hook"); its form and scope ruled in
# c141a704: Q1 "Spec host only (Recommended)", Q2 "Optional method, v2 (Recommended)", Q3 "All seeds" (the storability check
# applies to plain seeds too), Q4 "Check by doing it twice" (each seed call is transformed twice and must agree), Q5 "All
# store adapters" (the same option, protocol and refusals ship for Neo4j, Redis, Kurrent and DynamoDB in one release:
# SPEC-ADPRDS-002, SPEC-ADPKUR-006 and SPEC-ADPDDB-003 state it for theirs). ADR-0035.
#
# Why: a seed is written with `SET n = $values`, and Neo4j stores only scalars and homogeneous lists of scalars as a
# property. A consumer whose spec states a value only it can compute (a text its own pinned model encodes to a vector) has no
# way to state it at the integration tier; a map is refused by the server mid-transaction with a raw driver error.
#
#   options.seedTransform: { host: { command: [<argv>], cwd?, env? } }
#
# The hook is a spec host reached through the shared host registry of @mmmnt/feat-adapter-stdio-jsonrpc (so a consumer's one
# spec host process serves it), asked `transformSeed` (SPEC-RPC-001's amendment). Without options.seedTransform no host is
# asked; the storability check below still applies to every seed.
#
# Storable in Neo4j (a node's or a relationship's property value): a string, a finite number, a boolean, or a non-empty list
# whose items are all strings, all finite numbers or all booleans. Unstorable: null, a map, an empty list, a list mixing kinds,
# a list holding null, a map or a list.
#
# Spec tier, as SPEC-ADPNEO-003/-004: the integration config leaves this file out so it runs once. Driven through the probe
# of SPEC-ADPNEO-001 (adapters/neo4j/fixtures/probe.mjs) and the shared fake transform host
# (adapters/stdio-jsonrpc/fixtures/seed-host.mjs), both inside touches and never shipped. `ObserveNeo4jSeedTransform
# { host, script }` creates the adapter with options.seedTransform pointing at the fake host in mode `host`, then runs the
# steps of SPEC-ADPNEO-004 plus:
#   seedenc:<ns>:<Label>:<key>:<text>   seed() of one node whose `v` is { encode: "<text>" }
#   seedrelenc:<ns>:<Label>:<key>:<REL>:<Label2>:<key2>:<text>   one relationship whose `w` is { encode: "<text>" }
#   seedmix:<ns>                         ONE seed() call: Order:o1 with v { encode: "a" }, Order:o2 with v { encode: "b" }
#   seedraw:<ns>:<case>                  a plain seed of Order:o1 whose v is: map {x: 1}, empty [], mixed [1, "a"],
#                                        nulls [1, null], nested [[1]], null
#   calls:<ns>                           the number of transformSeed requests the fake host received
# Fake host modes (shared with SPEC-ADPRDS-002, SPEC-ADPKUR-006, SPEC-ADPDDB-003):
#   "encode"     replaces every { encode: t } value, at any depth of values, by [len(t), first char code of t, 1.0]
#   "slow"       as encode, answering after 200 ms
#   "random"     as encode, with a third item that differs on every request
#   "fail"       answers with a JSON-RPC error { code: -32000, message: "encoder not loaded" }
#   "map"        leaves each { encode: t } as it is
#   "mixed"      answers each { encode: t } as [1, "a"]
#   "short"      answers with one record fewer than it was sent
#   "retype"     changes each record's type to "Other"
#   "rekey"      changes each record's identity (Neo4j: the key property; Redis: key; Kurrent: stream; DynamoDB: the key attributes)
#   "scalar"     answers each record's values as the string "x"
#   "encodestr"  replaces every { encode: t } value by the string "enc:<t>"
#   "crash"      exits on the first transformSeed
#   "nomethod"   implements every method but transformSeed (method not found)
#   "absent"     the command names a file that does not exist
#   "nocommand"  options.seedTransform is { host: {} }
#   "none"       no options.seedTransform at all
# A step written with a trailing `!` records its refusal in the trace (`seedmix:a!SEED_TRANSFORM_FAILED`) and the script goes
# on, as SPEC-ADPNEO-001's refused writes do. `readValues` is each record's key, as readKeys, with its v or w as stored:
# `Order:o1{v=[2,97,1.0]}`.

spec SPEC-ADPNEO-005 "Neo4j adapter: a consumer's spec host may transform seed values, and every seed value must be one Neo4j can store"
context Toolchain
aggregate Adapters
type infrastructure
status draft

construct:
  handler at adapters/neo4j/src/index.ts
  touches adapters/neo4j/**
  touches adapters/stdio-jsonrpc/fixtures/seed-host.mjs
  touches feat.config.json
  touches feat.integration.config.json
  needs SPEC-ADPNEO-001
  needs SPEC-ADPNEO-004
  needs SPEC-RPC-001
  options.seedTransform { host: HostConfig } names a spec host; setup() joins it through the shared host registry, so a host
  that cannot be started is refused before any case. seed(records), when it is set, sends every record of the call, in order,
  as transformSeed { service, records: [{ type, values }] } TWICE, awaiting each answer; each answer must hold the same number
  of records in the same order with the same types and the same identity (a node's key property, options.keys; a
  relationship's `from` and `to`), and the two answers must be equal value for value (canonical JSON). The first answer's
  values replace the records' values. Then every record, transformed or plain, is checked for storability
  (every node value and every relationship property other than SPEC-ADPNEO-004's `from` and `to`), and only then validated
  and written exactly as SPEC-ADPNEO-001 and SPEC-ADPNEO-004 say, in one transaction. The transform applies to seeds only:
  capture, peek, stop, read and state never pass through it. teardown() leaves the registry. No transform is retried or cached.

enforce:
  rejects OPTIONS_INVALID when options.seedTransform is not { host } with a host whose command is a non-empty list of strings
  rejects SEED_TRANSFORM_UNAVAILABLE when the seed-transform host cannot be started at setup()
  rejects SEED_TRANSFORM_FAILED when the host answers transformSeed with an error, does not implement it, ends, or answers with records that differ in number, order, type or identity
  rejects SEED_TRANSFORM_NONDETERMINISTIC when the two answers to one seed call's transformSeed differ, naming the first record and value that differ
  rejects SEED_VALUE_UNSTORABLE when a seed record, transformed or plain, holds a value Neo4j cannot store as a property, naming the record and the property
  nothing of a seed call is written unless every record of it was transformed, checked and validated
  a transform applies to seeds only, never to what the adapter observes or reads
  without options.seedTransform no host is asked, and a storable seed is written exactly as SPEC-ADPNEO-001 and SPEC-ADPNEO-004 say

contract:
  input SeedTransformInput
  response SeedTransformResult
  error SeedTransformError

scenario "a node seed's value is written as the host transformed it":
  when: ObserveNeo4jSeedTransform { host: "encode", script: "setup:a seedenc:a:Order:o1:ab read:a" }
  predict success:
    response OK SeedTransformResult {
      trace: "setup:a seedenc:a read:a=1",
      readVia: "NamespaceScan",
      readValues: "Order:o1{v=[2,97,1.0]}"
    }
    filesystem has []

scenario "a transformed seed is state: the window that follows reports nothing":
  when: ObserveNeo4jSeedTransform { host: "encode", script: "setup:a seedenc:a:Order:o1:ab start:a stop:a" }
  predict success:
    response OK SeedTransformResult { trace: "setup:a seedenc:a start:a stop:a=0" }
    filesystem has []

scenario "a relationship seed's own property is transformed too":
  when: ObserveNeo4jSeedTransform { host: "encode", script: "setup:a seed:a:Order:o1 seed:a:Customer:c1 seedrelenc:a:Order:o1:PLACED_BY:Customer:c1:xyz read:a" }
  predict success:
    response OK SeedTransformResult {
      trace: "setup:a seed:a seed:a seedrelenc:a read:a=3",
      readVia: "NamespaceScan",
      readValues: "Customer:c1,Order:o1,Order:o1-[PLACED_BY]->Customer:c1{w=[3,120,1.0]}"
    }
    filesystem has []

scenario "one seed call is transformed in one request, asked twice, and written in order":
  when: ObserveNeo4jSeedTransform { host: "encode", script: "setup:a seedmix:a calls:a read:a" }
  predict success:
    response OK SeedTransformResult {
      trace: "setup:a seedmix:a calls:a=2 read:a=2",
      readVia: "NamespaceScan",
      readValues: "Order:o1{v=[1,97,1.0]},Order:o2{v=[1,98,1.0]}"
    }
    filesystem has []

scenario "a host that answers late is awaited before the seed is written":
  when: ObserveNeo4jSeedTransform { host: "slow", script: "setup:a seedenc:a:Order:o1:ab read:a" }
  predict success:
    response OK SeedTransformResult {
      trace: "setup:a seedenc:a read:a=1",
      readVia: "NamespaceScan",
      readValues: "Order:o1{v=[2,97,1.0]}"
    }
    filesystem has []

scenario "a read and a capture report the stored value, never the seed's original form":
  when: ObserveNeo4jSeedTransform { host: "encode", script: "setup:a seedenc:a:Order:o1:ab start:a setprop:a:Order:o1:z stop:a read:a" }
  predict success:
    response OK SeedTransformResult {
      trace: "setup:a seedenc:a start:a setprop:a stop:a=1 read:a=1",
      last: "UPDATE:Order:o1",
      readVia: "NamespaceScan",
      readValues: "Order:o1{v=z}"
    }
    filesystem has []

scenario "without seedTransform no host is asked and a plain seed is written as before":
  when: ObserveNeo4jSeedTransform { host: "none", script: "setup:a seed:a:Order:o1 read:a" }
  predict success:
    response OK SeedTransformResult {
      trace: "setup:a seed:a read:a=1",
      readVia: "NamespaceScan",
      readValues: "Order:o1"
    }
    filesystem has []

scenario "a host that cannot be started is refused at setup, before any case":
  when: ObserveNeo4jSeedTransform { host: "absent", script: "setup:a" }
  predict rejection SEED_TRANSFORM_UNAVAILABLE:
    response ERR SeedTransformError { code: "SEED_TRANSFORM_UNAVAILABLE", detail: matching "seedTransform" }
    filesystem has []

scenario "a seedTransform without a command is refused at setup":
  when: ObserveNeo4jSeedTransform { host: "nocommand", script: "setup:a" }
  predict rejection OPTIONS_INVALID:
    response ERR SeedTransformError { code: "OPTIONS_INVALID", detail: matching "seedTransform.host.command" }
    filesystem has []

scenario outline "a transform that fails writes nothing":
  when: ObserveNeo4jSeedTransform { host: <host>, script: "setup:a seedmix:a" }
  predict rejection SEED_TRANSFORM_FAILED:
    response ERR SeedTransformError { code: "SEED_TRANSFORM_FAILED", detail: matching <detail> }
    filesystem has []
  examples:
    | host       | detail               |
    | "fail"     | "encoder not loaded" |
    | "nomethod" | "transformSeed"      |
    | "crash"    | "ended"              |
    | "short"    | "2 records"          |
    | "retype"   | "Order"              |
    | "rekey"    | "orderId"            |

scenario "two answers that differ are refused as nondeterministic":
  when: ObserveNeo4jSeedTransform { host: "random", script: "setup:a seedenc:a:Order:o1:ab" }
  predict rejection SEED_TRANSFORM_NONDETERMINISTIC:
    response ERR SeedTransformError { code: "SEED_TRANSFORM_NONDETERMINISTIC", detail: matching "Order:o1 › v" }
    filesystem has []

scenario outline "after a refused seed call the namespace holds nothing of it":
  when: ObserveNeo4jSeedTransform { host: <host>, script: "setup:a seedmix:a! read:a" }
  predict success:
    response OK SeedTransformResult {
      trace: <trace>,
      readVia: "NamespaceScan",
      readValues: ""
    }
    filesystem has []
  examples:
    | host     | trace                                                        |
    | "short"  | "setup:a seedmix:a!SEED_TRANSFORM_FAILED read:a=0"           |
    | "random" | "setup:a seedmix:a!SEED_TRANSFORM_NONDETERMINISTIC read:a=0" |
    | "map"    | "setup:a seedmix:a!SEED_VALUE_UNSTORABLE read:a=0"           |

scenario outline "a transformed value Neo4j cannot store is refused before anything is written":
  when: ObserveNeo4jSeedTransform { host: <host>, script: "setup:a seedenc:a:Order:o1:ab" }
  predict rejection SEED_VALUE_UNSTORABLE:
    response ERR SeedTransformError { code: "SEED_VALUE_UNSTORABLE", detail: matching <detail> }
    filesystem has []
  examples:
    | host    | detail         |
    | "map"   | "Order:o1 › v" |
    | "mixed" | "Order:o1 › v" |

scenario outline "a plain seed Neo4j cannot store is refused before anything is written":
  when: ObserveNeo4jSeedTransform { host: "none", script: <script> }
  predict rejection SEED_VALUE_UNSTORABLE:
    response ERR SeedTransformError { code: "SEED_VALUE_UNSTORABLE", detail: matching "Order:o1 › v" }
    filesystem has []
  examples:
    | script                     |
    | "setup:a seedraw:a:map"    |
    | "setup:a seedraw:a:empty"  |
    | "setup:a seedraw:a:mixed"  |
    | "setup:a seedraw:a:nulls"  |
    | "setup:a seedraw:a:nested" |
    | "setup:a seedraw:a:null"   |
