feat 1.0

# SPEC-PRR-001 — the pull request build report Action (actions/pr-report). DRAFT, awaiting the founder's flip
# (ADR-0032-DRAFT; requested 2026-11-17: "I review all PRs, but I won't go through the code … get it into a friendly
# format, into the PR"; form ruled "GitHub Action in Feature (Recommended)"). Revised 2026-11-17 on the founder's
# feedback: "we need more detail on the attestations. digest is truncated, and we need to make alignment from the
# signature to the PR ref so we can establish an easy chain of evidence for an auditor."
#
# Driven through actions/pr-report/fixtures/probe.mjs (part of the build, inside touches, not shipped). The probe runs
# the Action's entry with a recorded GitHub API and a recorded Sigstore trust root (no network): every request is
# answered from a fixture, and the trace lists the requests made, in order, as `METHOD path`.
# `ProbePrReport { script }` runs a space-separated script:
#   pr:<n>                     the run belongs to pull request <n>: head 9f2c41d8a07e5b3c6d1f0e2a4b8c7d9e1f3a5b6c, base
#                              4e1a9c3b7d2f6e0a8c5b1d9f3e7a2c6b0d4f8e1a, built ref refs/pull/<n>/merge, built commit
#                              c0ffee12a3b4c5d6e7f8091a2b3c4d5e6f708192; `push:topic` = a push to a branch other than main
#   main:<sha>                 merge mode: the run is a push to main at <sha> (main sha below:
#                              5e8d1f2a3b4c5d6e7f8091a2b3c4d5e6f7081a2b)
#   prlookup:found|notfound    the pull request associated with the main commit (#7, merged from head
#                              9f2c41d8a07e5b3c6d1f0e2a4b8c7d9e1f3a5b6c, tested merge ref commit
#                              c0ffee12a3b4c5d6e7f8091a2b3c4d5e6f708192, PR run 44153523061), or none
#   mainattest:good|wrongsource  main's build attestation: source commit = main sha, or another commit
#   prattest:present|missing   the PR run's attestation digests are, or are not, retrievable
#   merge:good|badparents      the built commit's parents are [base, head], or are not
#   evidence:<tier>:<fixture>  an uploaded feat-evidence/2 bundle for that tier: `pass`, `fail` (one scenario fails
#                              with one violation row), `noruns` (verify pass, no run block)
#   jobs:<fixture>             the run's jobs: `green` (install, lint, unit, harness all succeed), `red` (harness fails)
#   attest:<fixture>           attestations for the run's artifact (subject
#                              sha256:3a7bd3e2360a3d29eea436fcfb7e44c735d117c42d1c1835420b6b9942dd4f1b): `verified`;
#                              `unverified` (the bundle's signature fails); `wrongsource` (provenance gitCommit is
#                              0badc0de1a2b3c4d5e6f708192a3b4c5d6e7f809); `foreignsigner` (SAN is another repository's
#                              workflow); `nolog` (no transparency-log entry); `none` (no attestation)
#   comment:<id>|none          an earlier report comment carrying the marker exists with that id, or none does
#   token:full|readonly        the token's granted permissions (readonly = what a fork pull request receives)
#   go                         run the Action
# After `go` the trace carries `verdict=<pass|fail|incomplete>`, `chain=<ok|broken:<link>>` and `sections=<names>`;
# `body` is the rendered comment's markdown and `check` the check run's conclusion.

spec SPEC-PRR-001 "PR build report: one updating comment and a check summary, with an auditable chain of evidence"
context Toolchain
aggregate Reporting
type infrastructure
status draft

construct:
  handler at actions/pr-report/src/index.ts
  touches actions/pr-report/**
  Read every uploaded feat-evidence bundle (one per tier), the workflow run's jobs, the built commit, and the
  attestations of the run's artifacts; verify each attestation (signature, certificate chain to the Sigstore root,
  transparency-log inclusion, signer identity, provenance source); render one markdown report and post it as ONE pull
  request comment found again by the marker `<!-- feat-pr-report -->` (update in place, else create), and as the
  summary of a check run named `feat report` whose conclusion is the verdict.
  The report has: the verdict; a chain of evidence — PR number → head commit → base commit → built ref → built commit
  (parents = [base, head]) → run (id, attempt, workflow) → provenance source commit (= built commit) → signer (SAN
  workflow@ref, issuer) → artifact digest → transparency-log entry — with the first broken link named; per attested
  artifact the subject digest, predicate type, certificate identity and issuer, builder, provenance source repo, ref
  and commit, run id, attempt and link, Rekor log index, entry UUID and integrated time, the verified status, and a
  filled-in `gh attestation verify` command; specs per tier; CI jobs with conclusion, duration and link.
  Every digest and commit SHA is printed in full, never shortened.
  The verdict is pass only when every tier's bundle has verify pass and run pass, every job succeeded, and every
  link of the chain holds; fail when any of them failed or any link is broken; incomplete when evidence or a run is
  missing.

enforce:
  exactly one report comment exists on the pull request after any number of runs
  the check run's conclusion equals the report's verdict
  every digest and commit SHA in the report is printed in full
  the provenance's source commit must equal the commit the run built, or the chain is broken at the provenance link
  the signer must be one of this repository's workflows at the built ref, or the chain is broken at the signer link
  an attestation with no transparency-log entry breaks the chain at the log link
  the built commit's parents must be the pull request's base and head, or the chain is broken at the built-commit link
  on a push to main the Action signs one merge-linking attestation naming the pull request number, its head commit,
  the tested merge-ref commit, the pull request run and its attestation digests, the main commit and main's artifact
  digests; posts a check run on the main commit in the same report format; and appends "merged as <main sha>" with
  the merge attestation's full digest to the closed pull request's report comment
  main's build attestation must have the main commit as its source, or the chain is broken at the main-provenance link
  rejects NO_PR_CONTEXT when the run is neither a pull request nor a push to main, and nothing is posted
  rejects NO_PR_FOR_MERGE when no merged pull request is associated with the main commit, and nothing is signed or posted
  rejects PR_EVIDENCE_MISSING when the pull request run's attestations cannot be retrieved, and nothing is signed or posted
  rejects NO_EVIDENCE when no evidence bundle was uploaded, and nothing is posted
  rejects INSUFFICIENT_PERMISSIONS when the token cannot write pull request comments or check runs, and nothing is posted

contract:
  input ProbeInput
  response ProbeResult
  error ReportError

scenario "a green build with an unbroken chain posts a new report comment and a passing check":
  when: ProbePrReport { script: "pr:7 merge:good evidence:unit:pass evidence:integration:pass jobs:green attest:verified comment:none token:full go" }
  predict success:
    response OK ProbeResult {
      trace: "GET /repos/o/r/actions/runs/1/attempts/1/jobs GET /repos/o/r/commits/c0ffee12a3b4c5d6e7f8091a2b3c4d5e6f708192 GET /repos/o/r/attestations/sha256:3a7bd3e2360a3d29eea436fcfb7e44c735d117c42d1c1835420b6b9942dd4f1b GET /repos/o/r/issues/7/comments POST /repos/o/r/issues/7/comments POST /repos/o/r/check-runs verdict=pass chain=ok sections=verdict,chain,attestations,specs:unit,specs:integration,jobs"
      check: "success"
    }
    filesystem has []

scenario "a second run updates the same comment instead of adding one":
  when: ProbePrReport { script: "pr:7 merge:good evidence:unit:pass jobs:green attest:verified comment:901 token:full go" }
  predict success:
    response OK ProbeResult {
      trace: "GET /repos/o/r/actions/runs/1/attempts/1/jobs GET /repos/o/r/commits/c0ffee12a3b4c5d6e7f8091a2b3c4d5e6f708192 GET /repos/o/r/attestations/sha256:3a7bd3e2360a3d29eea436fcfb7e44c735d117c42d1c1835420b6b9942dd4f1b GET /repos/o/r/issues/7/comments PATCH /repos/o/r/issues/comments/901 POST /repos/o/r/check-runs verdict=pass chain=ok sections=verdict,chain,attestations,specs:unit,jobs"
      check: "success"
    }
    filesystem has []

scenario "the report prints every digest and commit in full":
  when: ProbePrReport { script: "pr:7 merge:good evidence:unit:pass jobs:green attest:verified comment:none token:full go" }
  predict success:
    response OK ProbeResult {
      trace: any string
      body: matching "sha256:3a7bd3e2360a3d29eea436fcfb7e44c735d117c42d1c1835420b6b9942dd4f1b"
      check: "success"
    }
    filesystem has []

scenario "a failing scenario shows its violation and fails the check":
  when: ProbePrReport { script: "pr:7 merge:good evidence:unit:pass evidence:integration:fail jobs:red attest:verified comment:none token:full go" }
  predict success:
    response OK ProbeResult {
      trace: "GET /repos/o/r/actions/runs/1/attempts/1/jobs GET /repos/o/r/commits/c0ffee12a3b4c5d6e7f8091a2b3c4d5e6f708192 GET /repos/o/r/attestations/sha256:3a7bd3e2360a3d29eea436fcfb7e44c735d117c42d1c1835420b6b9942dd4f1b GET /repos/o/r/issues/7/comments POST /repos/o/r/issues/7/comments POST /repos/o/r/check-runs verdict=fail chain=ok sections=verdict,failures,chain,attestations,specs:unit,specs:integration,jobs"
      check: "failure"
    }
    filesystem has []

scenario "an attestation whose signature fails verification breaks the chain":
  when: ProbePrReport { script: "pr:7 merge:good evidence:unit:pass jobs:green attest:unverified comment:none token:full go" }
  predict success:
    response OK ProbeResult {
      trace: "GET /repos/o/r/actions/runs/1/attempts/1/jobs GET /repos/o/r/commits/c0ffee12a3b4c5d6e7f8091a2b3c4d5e6f708192 GET /repos/o/r/attestations/sha256:3a7bd3e2360a3d29eea436fcfb7e44c735d117c42d1c1835420b6b9942dd4f1b GET /repos/o/r/issues/7/comments POST /repos/o/r/issues/7/comments POST /repos/o/r/check-runs verdict=fail chain=broken:signature sections=verdict,chain,attestations,specs:unit,jobs"
      check: "failure"
    }
    filesystem has []

scenario "a provenance source commit other than the built commit breaks the chain":
  when: ProbePrReport { script: "pr:7 merge:good evidence:unit:pass jobs:green attest:wrongsource comment:none token:full go" }
  predict success:
    response OK ProbeResult {
      trace: "GET /repos/o/r/actions/runs/1/attempts/1/jobs GET /repos/o/r/commits/c0ffee12a3b4c5d6e7f8091a2b3c4d5e6f708192 GET /repos/o/r/attestations/sha256:3a7bd3e2360a3d29eea436fcfb7e44c735d117c42d1c1835420b6b9942dd4f1b GET /repos/o/r/issues/7/comments POST /repos/o/r/issues/7/comments POST /repos/o/r/check-runs verdict=fail chain=broken:provenance sections=verdict,chain,attestations,specs:unit,jobs"
      check: "failure"
    }
    filesystem has []

scenario "a signer that is not this repository's workflow breaks the chain":
  when: ProbePrReport { script: "pr:7 merge:good evidence:unit:pass jobs:green attest:foreignsigner comment:none token:full go" }
  predict success:
    response OK ProbeResult {
      trace: "GET /repos/o/r/actions/runs/1/attempts/1/jobs GET /repos/o/r/commits/c0ffee12a3b4c5d6e7f8091a2b3c4d5e6f708192 GET /repos/o/r/attestations/sha256:3a7bd3e2360a3d29eea436fcfb7e44c735d117c42d1c1835420b6b9942dd4f1b GET /repos/o/r/issues/7/comments POST /repos/o/r/issues/7/comments POST /repos/o/r/check-runs verdict=fail chain=broken:signer sections=verdict,chain,attestations,specs:unit,jobs"
      check: "failure"
    }
    filesystem has []

scenario "an attestation with no transparency-log entry breaks the chain":
  when: ProbePrReport { script: "pr:7 merge:good evidence:unit:pass jobs:green attest:nolog comment:none token:full go" }
  predict success:
    response OK ProbeResult {
      trace: "GET /repos/o/r/actions/runs/1/attempts/1/jobs GET /repos/o/r/commits/c0ffee12a3b4c5d6e7f8091a2b3c4d5e6f708192 GET /repos/o/r/attestations/sha256:3a7bd3e2360a3d29eea436fcfb7e44c735d117c42d1c1835420b6b9942dd4f1b GET /repos/o/r/issues/7/comments POST /repos/o/r/issues/7/comments POST /repos/o/r/check-runs verdict=fail chain=broken:log sections=verdict,chain,attestations,specs:unit,jobs"
      check: "failure"
    }
    filesystem has []

scenario "a built commit whose parents are not the PR's base and head breaks the chain":
  when: ProbePrReport { script: "pr:7 merge:badparents evidence:unit:pass jobs:green attest:verified comment:none token:full go" }
  predict success:
    response OK ProbeResult {
      trace: "GET /repos/o/r/actions/runs/1/attempts/1/jobs GET /repos/o/r/commits/c0ffee12a3b4c5d6e7f8091a2b3c4d5e6f708192 GET /repos/o/r/attestations/sha256:3a7bd3e2360a3d29eea436fcfb7e44c735d117c42d1c1835420b6b9942dd4f1b GET /repos/o/r/issues/7/comments POST /repos/o/r/issues/7/comments POST /repos/o/r/check-runs verdict=fail chain=broken:built-commit sections=verdict,chain,attestations,specs:unit,jobs"
      check: "failure"
    }
    filesystem has []

scenario "a bundle with no run is incomplete, not passing":
  when: ProbePrReport { script: "pr:7 merge:good evidence:unit:noruns jobs:green attest:none comment:none token:full go" }
  predict success:
    response OK ProbeResult {
      trace: "GET /repos/o/r/actions/runs/1/attempts/1/jobs GET /repos/o/r/commits/c0ffee12a3b4c5d6e7f8091a2b3c4d5e6f708192 GET /repos/o/r/issues/7/comments POST /repos/o/r/issues/7/comments POST /repos/o/r/check-runs verdict=incomplete chain=ok sections=verdict,chain,specs:unit,jobs"
      check: "neutral"
    }
    filesystem has []

scenario "a merge to main signs the merge-linking attestation, checks main and points the PR at it":
  when: ProbePrReport { script: "main:5e8d1f2a3b4c5d6e7f8091a2b3c4d5e6f7081a2b prlookup:found prattest:present mainattest:good evidence:unit:pass jobs:green comment:901 token:full go" }
  predict success:
    response OK ProbeResult {
      trace: "GET /repos/o/r/actions/runs/1/attempts/1/jobs GET /repos/o/r/commits/5e8d1f2a3b4c5d6e7f8091a2b3c4d5e6f7081a2b/pulls GET /repos/o/r/actions/runs/44153523061/artifacts GET /repos/o/r/attestations/sha256:3a7bd3e2360a3d29eea436fcfb7e44c735d117c42d1c1835420b6b9942dd4f1b GET /repos/o/r/attestations/sha256:9b74c9897bac770ffc029102a200c5de2a4c2a6c2d1e3f4a5b6c7d8e9f0a1b2c ATTEST https://feat.dev/attestation/pr-merge/v1 POST /repos/o/r/check-runs GET /repos/o/r/issues/7/comments PATCH /repos/o/r/issues/comments/901 verdict=pass chain=ok sections=verdict,merge-chain,attestations,specs:unit,jobs"
      check: "success"
    }
    filesystem has []

scenario "main's build attested for another commit breaks the chain at main's provenance":
  when: ProbePrReport { script: "main:5e8d1f2a3b4c5d6e7f8091a2b3c4d5e6f7081a2b prlookup:found prattest:present mainattest:wrongsource evidence:unit:pass jobs:green comment:901 token:full go" }
  predict success:
    response OK ProbeResult {
      trace: "GET /repos/o/r/actions/runs/1/attempts/1/jobs GET /repos/o/r/commits/5e8d1f2a3b4c5d6e7f8091a2b3c4d5e6f7081a2b/pulls GET /repos/o/r/actions/runs/44153523061/artifacts GET /repos/o/r/attestations/sha256:3a7bd3e2360a3d29eea436fcfb7e44c735d117c42d1c1835420b6b9942dd4f1b GET /repos/o/r/attestations/sha256:9b74c9897bac770ffc029102a200c5de2a4c2a6c2d1e3f4a5b6c7d8e9f0a1b2c POST /repos/o/r/check-runs GET /repos/o/r/issues/7/comments PATCH /repos/o/r/issues/comments/901 verdict=fail chain=broken:main-provenance sections=verdict,merge-chain,attestations,specs:unit,jobs"
      check: "failure"
    }
    filesystem has []

scenario "a main commit with no merged pull request is refused and nothing is signed":
  when: ProbePrReport { script: "main:5e8d1f2a3b4c5d6e7f8091a2b3c4d5e6f7081a2b prlookup:notfound mainattest:good evidence:unit:pass jobs:green token:full go" }
  predict rejection NO_PR_FOR_MERGE:
    response ERR ReportError { code: "NO_PR_FOR_MERGE" }
    filesystem has []

scenario "a pull request run whose attestations are gone is refused and nothing is signed":
  when: ProbePrReport { script: "main:5e8d1f2a3b4c5d6e7f8091a2b3c4d5e6f7081a2b prlookup:found prattest:missing mainattest:good evidence:unit:pass jobs:green comment:901 token:full go" }
  predict rejection PR_EVIDENCE_MISSING:
    response ERR ReportError { code: "PR_EVIDENCE_MISSING" }
    filesystem has []

scenario "a push to a branch other than main is refused and nothing is posted":
  when: ProbePrReport { script: "push:topic evidence:unit:pass jobs:green attest:verified token:full go" }
  predict rejection NO_PR_CONTEXT:
    response ERR ReportError { code: "NO_PR_CONTEXT" }
    filesystem has []

scenario "no uploaded evidence is refused and nothing is posted":
  when: ProbePrReport { script: "pr:7 merge:good jobs:green attest:verified comment:none token:full go" }
  predict rejection NO_EVIDENCE:
    response ERR ReportError { code: "NO_EVIDENCE" }
    filesystem has []

scenario "a read-only token is refused before anything is posted":
  when: ProbePrReport { script: "pr:7 merge:good evidence:unit:pass jobs:green attest:verified comment:none token:readonly go" }
  predict rejection INSUFFICIENT_PERMISSIONS:
    response ERR ReportError { code: "INSUFFICIENT_PERMISSIONS" }
    filesystem has []
