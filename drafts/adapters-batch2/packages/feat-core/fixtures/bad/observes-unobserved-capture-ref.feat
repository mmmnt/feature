feat 1.0

spec SPEC-BAD-105 "a capture reference names a service the spec does not observe"
context Bad
aggregate Thing
type command
status draft
observes eventStore

construct:
  handler at src/do-thing.ts
  touches src/**

enforce:
  do the thing

contract:
  input ThingInput
  response ThingResult

scenario "does the thing":
  when: DoThing { value: 1 }
  predict success:
    response OK ThingResult { id: @cache[0].id }
    eventStore has []
