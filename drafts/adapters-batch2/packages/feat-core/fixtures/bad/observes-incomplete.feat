feat 1.0

spec SPEC-BAD-107 "a prediction omits a service the spec observes"
context Bad
aggregate Thing
type command
status draft
observes eventStore, cache

construct:
  handler at src/do-thing.ts
  touches src/**

enforce:
  do the thing

contract:
  input ThingInput
  response ThingResult

scenario "does the thing":
  when: DoThing { value: 1 }
  predict success:
    response OK ThingResult
    eventStore has []
