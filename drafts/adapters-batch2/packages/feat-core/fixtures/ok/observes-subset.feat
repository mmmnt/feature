feat 1.0

spec SPEC-OK-202 "a command that observes two of three services"
context Bad
aggregate Thing
type command
status draft
observes log, eventStore

construct:
  handler at src/do-thing.ts
  touches src/**

enforce:
  do the thing

contract:
  input ThingInput
  response ThingResult

scenario "does the thing":
  when: DoThing { value: 1 }
  predict success:
    response OK ThingResult
    eventStore has []
    log has []
