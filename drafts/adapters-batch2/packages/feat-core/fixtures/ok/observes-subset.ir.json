{
  "featVersion": "1.0",
  "identity": {
    "id": "SPEC-OK-202",
    "name": "a command that observes two of three services",
    "context": "Bad",
    "aggregate": "Thing",
    "type": "command",
    "status": "draft"
  },
  "observes": [
    "log",
    "eventStore"
  ],
  "construct": [
    {
      "kind": "handler",
      "path": "src/do-thing.ts"
    },
    {
      "kind": "touches",
      "glob": "src/**"
    }
  ],
  "enforce": [
    {
      "kind": "constraint",
      "text": "do the thing"
    }
  ],
  "contract": [
    {
      "kind": "input",
      "schemaName": "ThingInput"
    },
    {
      "kind": "response",
      "schemaName": "ThingResult"
    }
  ],
  "scenarios": [
    {
      "name": "does the thing",
      "when": {
        "command": "DoThing",
        "payload": {
          "value": 1
        }
      },
      "prediction": {
        "type": "success",
        "response": {
          "status": "OK",
          "schemaName": "ThingResult"
        },
        "services": {
          "eventStore": {
            "records": []
          },
          "log": {
            "records": []
          }
        }
      }
    }
  ]
}
