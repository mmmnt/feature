feat 1.0

spec SPEC-BAD-107 "Fault on an unconfigured service"
context Bad
aggregate Thing
type command
status draft

construct:
  handler at src/do-thing.ts
  touches src/**

enforce:
  do the thing

contract:
  input ThingInput
  response ThingResult

scenario "does the thing":
  given:
    fault ghostStore AppendToStream NotLeader
  when: DoThing { value: 1 }
  predict success:
    response OK ThingResult
    eventStore has []
