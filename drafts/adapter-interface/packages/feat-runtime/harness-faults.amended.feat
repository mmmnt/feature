    cases: [
      { anchor: "c1", name: "c1", given: { faults: [ { service: "store", operation: "Connection", fault: "Timeout", times: 1 } ] }, when: { command: "Ping", payload: { appends: 1 } }, prediction: { type: "success", services: { store: { ordering: "ordered", records: [] } } } }
    ]
