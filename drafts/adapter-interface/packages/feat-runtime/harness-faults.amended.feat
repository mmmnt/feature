    config: "packages/feat-runtime/fixtures/harness/fault-legacy.config.json"
    cases: [
      { anchor: "c1", name: "c1", given: { faults: [ { service: "store", operation: "AppendToStream", fault: "NotLeader", times: 1 } ] }, when: { command: "Ping", payload: { appends: 1 } }, prediction: { type: "success", services: { store: { ordering: "ordered", records: [] } } } }
    ]
  }
  predict success:
    response OK RunResult { outcome: "passed", calls: "reset:store arm:store=AppendToStream/NotLeader/1 start:store invoke:Ping consume:store=AppendToStream:NotLeader stop:store fired:store" }
    filesystem has []

scenario "a transport fault until reset is armed and checked like any other":
  when: RunHarnessCase {
    config: "packages/feat-runtime/fixtures/harness/fault.config.json"
    cases: [
      { anchor: "c1", name: "c1", given: { faults: [ { service: "store", operation: "Connection", fault: "Timeout", times: "reset" } ] }, when: { command: "Ping", payload: { appends: 0 } }, prediction: { type: "success", services: { store: { ordering: "ordered", records: [] } } } }
    ]
  }
  predict success:
    response OK RunResult { outcome: "failed", violationCodes: "FAULT_NOT_CONSUMED", calls: "reset:store arm:store=Connection/Timeout/reset start:store invoke:Ping stop:store fired:store" }
    filesystem has []
