scenario "a fault that is not a transport fault can declare only until reset too":
  when: RunHarnessCase {
    config: "packages/feat-runtime/fixtures/harness/fault.config.json"
    cases: [
      { anchor: "c1", name: "c1", given: { executes: [ { command: "Ping", payload: { appends: 1 } } ], faults: [ { service: "store", operation: "AppendToStream", fault: "AccessDenied", times: 2 } ] }, when: { command: "Ping", payload: { appends: 1 } }, prediction: { type: "success", services: { store: { ordering: "ordered", records: [] } } } }
    ]
  }
  predict rejection FAULT_UNSUPPORTED:
    response ERR HarnessError { code: "FAULT_UNSUPPORTED", calls: "", service: "store", detail: matching "AccessDenied" }
    filesystem has []

scenario "a fault that declares only until reset is armed when the case writes until reset":
  when: RunHarnessCase {
    config: "packages/feat-runtime/fixtures/harness/fault.config.json"
    cases: [
      { anchor: "c1", name: "c1", given: { faults: [ { service: "store", operation: "AppendToStream", fault: "AccessDenied", times: "reset" } ] }, when: { command: "Ping", payload: { appends: 2 } }, prediction: { type: "success", services: { store: { ordering: "ordered", records: [] } } } }
    ]
  }
  predict success:
    response OK RunResult { outcome: "passed", calls: "reset:store arm:store=AppendToStream/AccessDenied/reset start:store invoke:Ping consume:store=AppendToStream:AccessDenied consume:store=AppendToStream:AccessDenied stop:store fired:store" }
    filesystem has []

scenario "a catalog in the earlier array shape declares every count":
