feat 1.0

# SPEC-ADPHND-001 — the handler adapter honours the scenario clock. Grammar §5.1 already says
# `clock at` is "honored by the handler adapter only (it injects the clock)"; today the adapter
# injects nothing and the harness forwards the clock to no adapter, so a handler that reads
# the time reads the wall. This spec makes the sentence true. DRAFT: status draft until the
# founder flips it.
#
# The hook is the optional `setClock(clock: string | null)` of SPEC-RT-002; this spec is the
# handler adapter's side of it. Driven through adapters/handler/fixtures/probe.mjs (part of
# the build, inside touches): `ProbeHandlerClock { script }` creates the adapter (actors:
# default `operator`, context { role: "operator" }; commands Now and Legacy from
# fixtures/handlers.mjs) and runs a space-separated script: `clock:<iso>`, `clock:null`,
# `invoke:Now`, `invoke:Legacy`. `Now` is a three-argument handler returning what its context
# says; `Legacy` is a two-argument handler that returns its actor's role. The trace shows each
# step; `invoke:Now` adds now, iso and frozen (now and iso are shown only when frozen; an
# unfrozen clock shows `wall=true` when it was within a minute of the wall clock).
#
# Decision carried by the scenarios: the clock reaches a handler as its THIRD argument, a
# context object { clock: { now(): number, iso(): string, frozen: boolean } }, never by
# patching the global Date (a test double that leaks into the code under test and every
# other adapter in the process). The context is always supplied; an unfrozen clock reads the
# wall, so a handler can use ctx.clock unconditionally.

spec SPEC-ADPHND-001 "Handler adapter: the scenario clock"
context Toolchain
aggregate Adapters
type infrastructure
status draft

construct:
  handler at adapters/handler/src/index.ts
  touches adapters/handler/**
  needs SPEC-RT-002
  Implement setClock(clock): null unfreezes; a string must be an ISO-8601 instant WITH a zone
  designator (Z or +hh:mm) and parse to a finite time, or the adapter refuses it; the clock
  holds until the next setClock. invoke(command, input, actor) calls the handler as
  handler(input, actorContext, { clock }) where clock.now() is the frozen instant in epoch
  milliseconds (constant while frozen, Date.now() when not), clock.iso() is
  new Date(now()).toISOString(), and clock.frozen says which. The actor argument and the return
  value are unchanged. teardown() unfreezes.

enforce:
  setClock accepts null or an ISO-8601 instant with a zone designator
  rejects INVALID_CLOCK when setClock is given a string that is not an ISO-8601 instant with a zone designator
  a frozen clock is constant across every invocation until the next setClock
  the handler receives the clock as its third argument and the actor context as its second

contract:
  input ProbeInput
  response ProbeResult
  error ClockError

scenario "a frozen clock reaches the handler":
  when: ProbeHandlerClock { script: "clock:2026-07-16T00:00:00Z invoke:Now" }
  predict success:
    response OK ProbeResult { trace: "clock:2026-07-16T00:00:00Z invoke:Now now=1784160000000 iso=2026-07-16T00:00:00.000Z frozen=true" }
    filesystem has []

scenario "a frozen clock does not advance between invocations":
  when: ProbeHandlerClock { script: "clock:2026-07-16T00:00:00Z invoke:Now invoke:Now" }
  predict success:
    response OK ProbeResult {
      trace: "clock:2026-07-16T00:00:00Z invoke:Now now=1784160000000 iso=2026-07-16T00:00:00.000Z frozen=true invoke:Now now=1784160000000 iso=2026-07-16T00:00:00.000Z frozen=true"
    }
    filesystem has []

scenario "a later clock replaces the earlier one":
  when: ProbeHandlerClock { script: "clock:2026-07-16T00:00:00Z clock:2026-07-16T12:30:00Z invoke:Now" }
  predict success:
    response OK ProbeResult {
      trace: "clock:2026-07-16T00:00:00Z clock:2026-07-16T12:30:00Z invoke:Now now=1784205000000 iso=2026-07-16T12:30:00.000Z frozen=true"
    }
    filesystem has []

scenario "a zone offset is honoured":
  when: ProbeHandlerClock { script: "clock:2026-07-16T02:00:00+02:00 invoke:Now" }
  predict success:
    response OK ProbeResult { trace: "clock:2026-07-16T02:00:00+02:00 invoke:Now now=1784160000000 iso=2026-07-16T00:00:00.000Z frozen=true" }
    filesystem has []

scenario "clock null unfreezes, which is how a case without clock at is delivered":
  when: ProbeHandlerClock { script: "clock:2026-07-16T00:00:00Z clock:null invoke:Now" }
  predict success:
    response OK ProbeResult { trace: "clock:2026-07-16T00:00:00Z clock:null invoke:Now frozen=false wall=true" }
    filesystem has []

scenario "with no clock ever set the handler reads the wall":
  when: ProbeHandlerClock { script: "invoke:Now" }
  predict success:
    response OK ProbeResult { trace: "invoke:Now frozen=false wall=true" }
    filesystem has []

scenario "a two-argument handler and its actor are unaffected by the clock":
  when: ProbeHandlerClock { script: "clock:2026-07-16T00:00:00Z invoke:Legacy" }
  predict success:
    response OK ProbeResult { trace: "clock:2026-07-16T00:00:00Z invoke:Legacy role=operator" }
    filesystem has []

scenario outline "a clock that is not an ISO-8601 instant with a zone is refused":
  when: ProbeHandlerClock { script: <script> }
  predict rejection INVALID_CLOCK:
    response ERR ClockError { code: "INVALID_CLOCK", detail: matching <detail> }
    filesystem has []
  examples:
    | script                     | detail      |
    | "clock:yesterday"          | "yesterday" |
    | "clock:2026-07-16"         | "2026-07-16" |
    | "clock:2026-07-16T00:00:00" | "T00:00:00" |
    | "clock:2026-13-45T00:00:00Z" | "2026-13-45" |
