{
  "featVersion": "1.0",
  "schemas": { "adapter": "@mmmnt/feat-schema-json" },
  "response": {
    "adapter": "@mmmnt/feat-adapter-handler",
    "commands": {
      "PlaceOrder": { "module": "features/place-order/handler.ts", "export": "placeOrder" }
    }
  },
  "services": {
    "eventStore": { "adapter": "@mmmnt/feat-adapter-memory", "consistency": "strong" }
  },
  "specs": { "dir": ".", "pattern": "*.feat", "contractPattern": "*.contract.json", "outputPattern": "{name}.test.ts" },
  "report": { "format": ["console"] }
}
