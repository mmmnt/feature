      "RunOverlappingCases": {
        "module": "packages/feat-runtime/fixtures/harness/probe.mjs",
        "export": "runOverlapping"
      },
      "CheckChanged": {
        "module": "packages/feature/src/audit-changed.ts",
        "export": "checkChanged"
      },
      "ReadChanged": {
        "module": "packages/feature/fixtures/changed/probe.mjs",
        "export": "readChanged"
      }
    }
  },
  "services": {
    "filesystem": {
      "adapter": "@mmmnt/feat-adapter-fs",
      "consistency": "acid",
      "options": {
        "scope": "packages"
      }
    }
  },
  "specs": {
    "dir": ".",
    "pattern": "**/*.feat",
    "contractPattern": "**/*.contract.json",
    "outputPattern": "{name}.test.ts",
    "exclude": [
      "drafts/**",
      "corpus/**",
      "**/fixtures/**",
      "docs/**",
      "reports/**",
      "coverage/**",
      "editor/**",
      "editors/**",
      "adapters/dynamodb/transport.feat",
      "adapters/kafka/transport.feat",
      "adapters/kms/transport.feat",
      "adapters/kurrent/transport.feat",
      "adapters/neo4j/transport.feat",
      "adapters/kafka/broker-loss.feat",
      "adapters/kurrent/broker-loss.feat"
    ]
  },
  "report": {
    "format": [
      "console",
      "junit"
    ],
    "junitOutput": ".feature/reports/feat-junit.xml"
  },
  "environment": "toolchain"
}
