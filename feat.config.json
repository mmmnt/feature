        "module": "packages/feat-runner/fixtures/probe.mjs",
        "export": "preflightSerial"
      },
      "RunVitest": {
        "module": "packages/feat-runner/fixtures/probe.mjs",
        "export": "runVitest"
      },
      "SynthLocalCdk": {
        "module": "packages/feat-cdk/fixtures/probe.mjs",
