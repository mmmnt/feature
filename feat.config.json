      },
      "RunHarnessNamespace": {
        "module": "packages/feat-runtime/fixtures/harness/probe.mjs",
        "export": "runNamespace"
      },
      "Exchange": {
        "module": "adapters/stdio-jsonrpc/src/exchange.ts",
        "export": "exchange"
      },
      "ProbeHandlerNamespace": {
