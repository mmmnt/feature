scenario "a command that observes two of three services predicts those two and records them in written order":
  when: Parse { spec: "packages/feat-core/fixtures/ok/observes-subset.feat", config: "packages/feat-core/fixtures/parse-observes.config.json" }
  predict success:
    response OK BuiltSpec equals fixture "../../packages/feat-core/fixtures/ok/observes-subset.ir.json"
    filesystem has []

scenario "a query that observes one service may read it with contains":
  when: Parse { spec: "packages/feat-core/fixtures/ok/observes-query.feat", config: "packages/feat-core/fixtures/parse-observes.config.json" }
  predict success:
    response OK BuiltSpec equals fixture "../../packages/feat-core/fixtures/ok/observes-query.ir.json"
    filesystem has []

scenario outline "refuses an observes declaration that is not well formed or names an unconfigured service":
  when: Parse { spec: <spec>, config: "packages/feat-core/fixtures/parse-observes.config.json" }
  predict rejection <code>:
    response ERR ParseError { code: <code>, hint: matching <hint> }
    filesystem has []
  examples:
    | spec                                                         | code                  | hint                     |
    | "packages/feat-core/fixtures/bad/observes-unknown-service.feat" | "UNKNOWN_SERVICE_KEY" | "^Configured services: eventStore, cache, log" |
    | "packages/feat-core/fixtures/bad/observes-duplicate.feat"    | "MALFORMED_SYNTAX"    | "^Write 'observes <service>, <service>'" |
    | "packages/feat-core/fixtures/bad/observes-bare.feat"         | "MALFORMED_SYNTAX"    | "^Write 'observes <service>, <service>'" |
    | "packages/feat-core/fixtures/bad/observes-trailing-comma.feat" | "MALFORMED_SYNTAX"  | "^Write 'observes <service>, <service>'" |
    | "packages/feat-core/fixtures/bad/observes-twice.feat"        | "MALFORMED_SYNTAX"    | "^Write 'observes <service>, <service>'" |

scenario outline "refuses a service the spec uses but does not observe, naming it and the observed ones":
  when: Parse { spec: <spec>, config: "packages/feat-core/fixtures/parse-observes.config.json" }
  predict rejection UNOBSERVED_SERVICE:
    response ERR ParseError { code: "UNOBSERVED_SERVICE", message: matching "'cache'", hint: matching "^Observed services: eventStore" }
    filesystem has []
  examples:
    | spec                                                              |
    | "packages/feat-core/fixtures/bad/observes-unobserved-prediction.feat" |
    | "packages/feat-core/fixtures/bad/observes-unobserved-contains.feat"   |
    | "packages/feat-core/fixtures/bad/observes-unobserved-seed.feat"       |
    | "packages/feat-core/fixtures/bad/observes-unobserved-fault.feat"      |
    | "packages/feat-core/fixtures/bad/observes-unobserved-capture-ref.feat" |
    | "packages/feat-core/fixtures/bad/observes-unobserved-deliver.feat"   |
    | "packages/feat-core/fixtures/bad/list-unobserved-service.feat"       |

scenario "a prediction that omits an observed service is incomplete":
  when: Parse { spec: "packages/feat-core/fixtures/bad/observes-incomplete.feat", config: "packages/feat-core/fixtures/parse-observes.config.json" }
  predict rejection INCOMPLETE_PREDICTION:
    response ERR ParseError { code: "INCOMPLETE_PREDICTION", message: matching "observed service 'cache'" }
    filesystem has []

scenario "a word that merely begins with fault stays freeform context":
  when: Parse { spec: "packages/feat-core/fixtures/ok/fault-prefix-word.feat", config: "packages/feat-core/fixtures/parse.config.json" }
  predict success:
    response OK BuiltSpec equals fixture "../../packages/feat-core/fixtures/ok/fault-prefix-word.ir.json"
    filesystem has []

scenario outline "rejects invalid specs with the precise code":
  when: Parse { spec: <spec>, config: "packages/feat-core/fixtures/parse.config.json" }
  predict rejection <code>:
    response ERR ParseError { code: <code> }
    filesystem has []
  examples:
    | spec                                    | code                      |
    | "packages/feat-core/fixtures/bad/missing-pragma.feat"      | "MISSING_PRAGMA"          |
    | "packages/feat-core/fixtures/bad/unsupported-version.feat" | "UNSUPPORTED_VERSION"     |
    | "packages/feat-core/fixtures/bad/malformed-syntax.feat"    | "MALFORMED_SYNTAX"        |
    | "packages/feat-core/fixtures/bad/unknown-service.feat"     | "UNKNOWN_SERVICE_KEY"     |
    | "packages/feat-core/fixtures/bad/unknown-capture-service.feat" | "UNKNOWN_SERVICE_KEY" |
    | "packages/feat-core/fixtures/bad/unknown-command.feat"     | "UNKNOWN_COMMAND"         |
    | "packages/feat-core/fixtures/bad/undeclared-schema.feat"   | "UNDECLARED_SCHEMA"       |
    | "packages/feat-core/fixtures/bad/unknown-actor.feat"       | "UNKNOWN_ACTOR"           |
    | "packages/feat-core/fixtures/bad/duplicate-scenario.feat"  | "DUPLICATE_SCENARIO_NAME" |
    | "packages/feat-core/fixtures/bad/trigger-mismatch.feat"    | "TRIGGER_MISMATCH"        |
    | "packages/feat-core/fixtures/bad/query-side-effect.feat"   | "QUERY_SIDE_EFFECT"       |
    | "packages/feat-core/fixtures/bad/incomplete-prediction.feat" | "INCOMPLETE_PREDICTION" |
    | "packages/feat-core/fixtures/bad/missing-minimum.feat"     | "MISSING_MINIMUM"         |
    | "packages/feat-core/fixtures/bad/rejection-id-lower-camel.feat"      | "MALFORMED_SYNTAX" |
    | "packages/feat-core/fixtures/bad/rejection-id-mixed-case-snake.feat" | "MALFORMED_SYNTAX" |
    | "packages/feat-core/fixtures/bad/rejection-id-kebab.feat"            | "MALFORMED_SYNTAX" |
    | "packages/feat-core/fixtures/bad/fault-missing-operation.feat"      | "MALFORMED_SYNTAX"        |
    | "packages/feat-core/fixtures/bad/fault-lowercase-operation.feat"    | "MALFORMED_SYNTAX"        |
    | "packages/feat-core/fixtures/bad/fault-times-zero.feat"             | "MALFORMED_SYNTAX"        |
    | "packages/feat-core/fixtures/bad/fault-times-without-count.feat"    | "MALFORMED_SYNTAX"        |
    | "packages/feat-core/fixtures/bad/fault-trailing-junk.feat"          | "MALFORMED_SYNTAX"        |
    | "packages/feat-core/fixtures/bad/fault-bare-keyword.feat"           | "MALFORMED_SYNTAX"        |
    | "packages/feat-core/fixtures/bad/fault-unknown-service.feat"        | "UNKNOWN_SERVICE_KEY"     |
    | "packages/feat-core/fixtures/bad/not-not.feat"                      | "MALFORMED_SYNTAX"        |
    | "packages/feat-core/fixtures/bad/random-seed-negative.feat"         | "MALFORMED_SYNTAX"        |
    | "packages/feat-core/fixtures/bad/random-seed-missing.feat"          | "MALFORMED_SYNTAX"        |
    | "packages/feat-core/fixtures/bad/not-absent.feat"                   | "MALFORMED_SYNTAX"        |
