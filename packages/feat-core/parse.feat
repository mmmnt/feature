scenario outline "rejects invalid specs with the precise code":
  when: Parse { spec: <spec>, config: "fixtures/parse.config.json" }
  predict rejection <code>:
    response ERR ParseError { code: <code> }
    filesystem has []
  examples:
    | spec                                    | code                      |
    | "fixtures/bad/missing-pragma.feat"      | "MISSING_PRAGMA"          |
    | "fixtures/bad/unsupported-version.feat" | "UNSUPPORTED_VERSION"     |
    | "fixtures/bad/malformed-syntax.feat"    | "MALFORMED_SYNTAX"        |
    | "fixtures/bad/unknown-service.feat"     | "UNKNOWN_SERVICE_KEY"     |
    | "fixtures/bad/unknown-command.feat"     | "UNKNOWN_COMMAND"         |
    | "fixtures/bad/undeclared-schema.feat"   | "UNDECLARED_SCHEMA"       |
    | "fixtures/bad/unknown-actor.feat"       | "UNKNOWN_ACTOR"           |
    | "fixtures/bad/duplicate-scenario.feat"  | "DUPLICATE_SCENARIO_NAME" |
    | "fixtures/bad/trigger-mismatch.feat"    | "TRIGGER_MISMATCH"        |
    | "fixtures/bad/query-side-effect.feat"   | "QUERY_SIDE_EFFECT"       |
    | "fixtures/bad/incomplete-prediction.feat" | "INCOMPLETE_PREDICTION" |
    | "fixtures/bad/missing-minimum.feat"     | "MISSING_MINIMUM"         |
