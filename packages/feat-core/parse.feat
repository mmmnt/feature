feat 1.0

# SPEC-CORE-001 — the parser's own contract, written in the language it parses.
# The corpus is the executable ground truth: one golden scenario per exemplar
# (equals fixture, ADR-0013). Rejection families cover the pragma, the four
# closed reference spaces, trigger discipline, the query guarantee, and the
# no-escape-hatch minimums. status agreed proposed per ADR-0008.

spec SPEC-CORE-001 "Parse a .feat file to BuiltSpec IR"
context Toolchain
aggregate Language
type infrastructure
status agreed

construct:
  handler at packages/feat-core/src/parse.ts
  touches packages/feat-core/**
  imports BuiltSpec from @mmmnt/feat-types
  needs SPEC-RT-001
  Implement with Langium: .langium grammar, generated AST, AST-to-IR transformer.
  The corpus at corpus/ is ground truth: every exemplar parses to its .ir.json exactly.
  Agent zones are opaque: parse errors inside construct:/enforce: freeform text are impossible.
  The response body is the IR WITHOUT loc (ADR-0013 companion ruling); loc serves LSP surfaces only.
  Parse errors carry line numbers and a hint naming valid alternatives where a closed space is violated.

enforce:
  read the version pragma before anything else
  rejects MISSING_PRAGMA when the first non-comment line is not a feat version pragma
  rejects UNSUPPORTED_VERSION when the pragma names a version this toolchain does not support
  rejects MALFORMED_SYNTAX when a compiler-zone block violates the grammar
  rejects UNKNOWN_SERVICE_KEY when a prediction targets a service absent from the config services
  rejects UNKNOWN_COMMAND when a when or execute names a command absent from response.commands
  rejects UNDECLARED_SCHEMA when a scenario references a schema absent from the contract block
  rejects UNKNOWN_ACTOR when an as-clause names an actor absent from response.actors
  rejects DUPLICATE_SCENARIO_NAME when two scenarios in one spec share a name
  rejects TRIGGER_MISMATCH when the trigger form does not match the spec type discipline
  rejects QUERY_SIDE_EFFECT when a query spec predicts any service write
  rejects INCOMPLETE_PREDICTION when a non-query prediction omits a configured service
  rejects MISSING_MINIMUM when a spec lacks the required minimum sections

contract:
  input ParseInput
  response BuiltSpec
  error ParseError

scenario "parses the founding exemplar (create-flow)":
  when: Parse { spec: "../../corpus/create-flow/create-flow.feat", config: "../../corpus/create-flow/feat.config.json" }
  predict success:
    response OK BuiltSpec equals fixture "../../corpus/create-flow/create-flow.ir.json"
    filesystem has []

