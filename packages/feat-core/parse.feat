scenario outline "refuses a negation of a matcher it does not take, naming the spelling to use":
  when: Parse { spec: <spec>, config: "packages/feat-core/fixtures/parse.config.json" }
  predict rejection MALFORMED_SYNTAX:
    response ERR ParseError { code: "MALFORMED_SYNTAX", message: matching <message>, hint: matching <hint> }
    filesystem has []
  examples:
    | spec                                                  | message                 | hint                                |
    | "packages/feat-core/fixtures/bad/not-not.feat"        | "^'not not' is refused" | "^Write the operand itself"         |
    | "packages/feat-core/fixtures/bad/not-absent.feat"     | "^'not absent' is refused" | "^Write 'any'"                   |
    | "packages/feat-core/fixtures/bad/not-bare-any.feat"   | "^'not any' is refused" | "^Write 'absent'"                   |
    | "packages/feat-core/fixtures/bad/not-block.feat"      | "^'not \\{ … \\}' is refused" | "^Negate a field inside the block" |
    | "packages/feat-core/fixtures/bad/not-bare.feat"       | "^'not' takes a matcher" | "^Write 'not' and one matcher"     |

scenario outline "refuses an f32 digest of any other shape, giving the form":
  when: Parse { spec: <spec>, config: "packages/feat-core/fixtures/parse.config.json" }
  predict rejection MALFORMED_SYNTAX:
    response ERR ParseError { code: "MALFORMED_SYNTAX", message: matching <message>, hint: matching "^Write 'f32 <dims> sha256" }
    filesystem has []
  examples:
    | spec                                                     | message                                         |
    | "packages/feat-core/fixtures/bad/f32-zero-dims.feat"        | "^'f32' takes a positive integer length: '0'"   |
    | "packages/feat-core/fixtures/bad/f32-fractional-dims.feat"  | "^'f32' takes a positive integer length: '1\\.5'" |
    | "packages/feat-core/fixtures/bad/f32-uppercase-digest.feat" | "^the digest after 'sha256' must be 64 lowercase" |
    | "packages/feat-core/fixtures/bad/f32-short-digest.feat"     | "^the digest after 'sha256' must be 64 lowercase" |
    | "packages/feat-core/fixtures/bad/f32-missing-sha256.feat"   | "^'f32' takes a length, the word 'sha256'"      |
    | "packages/feat-core/fixtures/bad/f32-bare.feat"             | "^'f32' takes a length, the word 'sha256'"      |
    | "packages/feat-core/fixtures/bad/not-f32.feat"              | "^'not f32 …' is refused"                       |

scenario outline "refuses a list item or a list object's field it does not take, naming the spelling to use":
  when: Parse { spec: <spec>, config: "packages/feat-core/fixtures/parse.config.json" }
  predict rejection MALFORMED_SYNTAX:
    response ERR ParseError { code: "MALFORMED_SYNTAX", message: matching <message>, hint: matching <hint> }
    filesystem has []
  examples:
    | spec                                                     | message                                | hint                             |
    | "packages/feat-core/fixtures/bad/list-absent-item.feat"  | "^'absent' is not a list item"         | "^Write a shorter list"          |
    | "packages/feat-core/fixtures/bad/list-absent-field.feat" | "^'absent' is refused inside a list"   | "^Leave the field out"           |
    | "packages/feat-core/fixtures/bad/not-list.feat"          | "^'not \\[ … \\]' is refused"          | "^Negate a field inside an item" |
