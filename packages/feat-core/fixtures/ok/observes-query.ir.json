{
  "featVersion": "1.0",
  "identity": {
    "id": "SPEC-OK-201",
    "name": "a query that observes one service",
    "context": "Bad",
    "aggregate": "Thing",
    "type": "query",
    "status": "draft"
  },
  "observes": [
    "cache"
  ],
  "construct": [
    {
      "kind": "handler",
      "path": "src/do-thing.ts"
    },
    {
      "kind": "touches",
      "glob": "src/**"
    }
  ],
  "enforce": [
    {
      "kind": "constraint",
      "text": "do the thing"
    }
  ],
  "contract": [
    {
      "kind": "input",
      "schemaName": "ThingInput"
    },
    {
      "kind": "response",
      "schemaName": "ThingResult"
    }
  ],
  "scenarios": [
    {
      "name": "reads the thing",
      "when": {
        "command": "DoThing",
        "payload": {
          "value": 1
        }
      },
      "prediction": {
        "type": "success",
        "response": {
          "status": "OK",
          "schemaName": "ThingResult"
        },
        "services": {
          "cache": {
            "contains": [
              {
                "type": "Entry",
                "schemaName": "ThingResult",
                "valueBlock": {
                  "id": {
                    "matcher": "literal",
                    "value": "e-1"
                  }
                }
              }
            ]
          }
        }
      }
    }
  ]
}
