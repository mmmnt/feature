feat 1.0

spec SPEC-OK-202 "a policy delivers to its response host and to a service in one sequence"
context Ok
aggregate Thing
type policy
status draft
observes eventStore

construct:
  handler at src/react.ts
  touches src/**

enforce:
  react to the thing

contract:
  event ThingResult

scenario "the policy reacts to an event its host receives":
  deliver ThingHappened { id: "t-1" } to response
  deliver ThingNoted { id: "t-1" } to eventStore
  predict success:
    eventStore has []
