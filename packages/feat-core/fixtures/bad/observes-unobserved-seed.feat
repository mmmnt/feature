feat 1.0

spec SPEC-BAD-103 "a seed targets a service the spec does not observe"
context Bad
aggregate Thing
type command
status draft
observes eventStore

construct:
  handler at src/do-thing.ts
  touches src/**

enforce:
  do the thing

contract:
  input ThingInput
  response ThingResult

scenario "does the thing":
  given:
    seed cache [ Entry with ThingResult { id: "e-1" } ]
  when: DoThing { value: 1 }
  predict success:
    response OK ThingResult
    eventStore has []
