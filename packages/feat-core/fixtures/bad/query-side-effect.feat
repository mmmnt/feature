feat 1.0

spec SPEC-BAD-010 "Query with a side effect"
context Bad
aggregate Thing
type query
status draft

construct:
  handler at src/do-thing.ts
  touches src/**

enforce:
  read the thing

contract:
  input ThingInput
  response ThingResult
  record ThingRow

scenario "query that writes":
  when: DoThing { value: 1 }
  predict success:
    response OK ThingResult
    eventStore has [ ThingWritten with ThingRow ]
