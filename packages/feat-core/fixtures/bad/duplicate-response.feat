feat 1.0

spec SPEC-BAD-151 "A prediction with two response lines"
context Bad
aggregate Thing
type command
status draft

construct:
  handler at src/do-thing.ts
  touches src/**

enforce:
  do the thing

contract:
  input ThingInput
  response ThingResult
  record ThingRow

scenario "does the thing":
  when: DoThing { value: 1 }
  predict success:
    response OK ThingResult { ok: true }
    response OK ThingResult { ok: false }
    eventStore has []
