feat 1.0

spec SPEC-BAD-120 "A random seed that is not a whole number"
context Bad
aggregate Thing
type command
status draft

construct:
  handler at src/do-thing.ts
  touches src/**

enforce:
  do the thing

contract:
  input ThingInput
  response ThingResult

scenario "does the thing":
  given:
    random seed -1
  when: DoThing { value: 1 }
  predict success:
    response OK ThingResult
    eventStore has []
