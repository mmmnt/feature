feat 1.0

spec SPEC-BAD-156 "A trailing comment on a given execute line"
context Bad
aggregate Thing
type command
status draft

construct:
  handler at src/do-thing.ts
  touches src/**

enforce:
  do the thing

contract:
  input ThingInput
  response ThingResult
  record ThingRow

scenario "does the thing":
  given:
    execute DoThing { value: 0 }   # warm up
  when: DoThing { value: 1 }
  predict success:
    response OK ThingResult
    eventStore has []
