feat 1.0

# ADR-0038 (founder rulings 7d3026eb and 55fb39c4): 'partial' marks a whole block, never a field's value.

spec SPEC-BAD-139 "partial as a field value"
context Bad
aggregate Thing
type command
status draft

construct:
  handler at src/do-thing.ts
  touches src/**

enforce:
  do the thing

contract:
  input ThingInput
  response ThingResult
  record ThingRow

scenario "does the thing":
  when: DoThing { value: 1 }
  predict success:
    response OK ThingResult { nested: partial { a: 1 } }
