feat 1.0

spec SPEC-BAD-016 "Rejection id with a hyphen"
context Bad
aggregate Thing
type command
status draft

construct:
  handler at src/do-thing.ts
  touches src/**

enforce:
  do the thing
  rejects not-operator when the thing is refused

contract:
  input ThingInput
  response ThingResult
  error ThingError

scenario "refuses the thing":
  when: DoThing { value: 1 }
  predict rejection not-operator:
    response ERR ThingError { code: "X" }
    eventStore has []
