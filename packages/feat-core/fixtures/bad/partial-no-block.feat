feat 1.0

# ADR-0038 (founder rulings 7d3026eb and 55fb39c4): 'partial' with no value block says nothing; refused.

spec SPEC-BAD-143 "partial with no block"
context Bad
aggregate Thing
type command
status draft

construct:
  handler at src/do-thing.ts
  touches src/**

enforce:
  do the thing

contract:
  input ThingInput
  response ThingResult
  record ThingRow

scenario "does the thing":
  when: DoThing { value: 1 }
  predict success:
    response OK ThingResult partial
