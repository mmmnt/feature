feat 1.0

spec SPEC-BAD-106 "a query's contains names a service the spec does not observe"
context Bad
aggregate Thing
type query
status draft
observes eventStore

construct:
  handler at src/do-thing.ts
  touches src/**

enforce:
  do the thing

contract:
  input ThingInput
  response ThingResult

scenario "reads the thing":
  when: DoThing { value: 1 }
  predict success:
    response OK ThingResult
    cache contains [ Entry with ThingResult { id: "e-1" } ]
