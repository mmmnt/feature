feat 1.0

spec SPEC-BAD-166 "A has line that changes the ordering its service's contains line wrote"
context Bad
aggregate Thing
type command
status draft

construct:
  handler at src/do-thing.ts
  touches src/**

enforce:
  do the thing

contract:
  input ThingInput
  response ThingResult
  record ThingRow

scenario "does the thing":
  when: DoThing { value: 1 }
  predict success:
    response OK ThingResult
    eventStore contains ordered [ Wrote with ThingRow { ref: "a" } ]
    eventStore has unordered [ Wrote with ThingRow { ref: "a" } ]
