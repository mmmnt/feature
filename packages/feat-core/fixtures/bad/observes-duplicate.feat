feat 1.0

spec SPEC-BAD-108 "observes names a service twice"
context Bad
aggregate Thing
type command
status draft
observes cache, cache

construct:
  handler at src/do-thing.ts
  touches src/**

enforce:
  do the thing

contract:
  input ThingInput
  response ThingResult

scenario "does the thing":
  when: DoThing { value: 1 }
  predict success:
    response OK ThingResult
    cache has []
