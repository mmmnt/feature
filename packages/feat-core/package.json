  "dependencies": {
    "@mmmnt/feat-types": "workspace:^",
    "@mmmnt/feat-runtime": "workspace:^"
  },
  "devDependencies": {
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.0",
    "vitest": "^3.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mmmnt/feature.git",
    "directory": "packages/feat-core"
  },
  "homepage": "https://github.com/mmmnt/feature/tree/main/packages/feat-core#readme",
  "bugs": {
    "url": "https://github.com/mmmnt/feature/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "feature",
    "feat",
    "specification",
    "spec-driven-development",
    "testing",
    "vitest",
    "parser",
    "dsl",
    "ir"
  ],
  "engines": {
    "node": ">=22"
  }
