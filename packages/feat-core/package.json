{
  "name": "@mmmnt/feat-core",
  "version": "0.17.0",
  "description": "Feat language core: recursive-descent parser, AST->BuiltSpec IR, closed-reference-space validation.",
  "license": "BSD-3-Clause",
  "author": "listenrightmeow <@listenrightmeow> (https://sdd.mmmnt.dev/)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
