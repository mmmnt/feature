{
  "name": "@mmmnt/feat-derive",
  "version": "0.1.8",
  "description": "Feat derive: BuiltSpec IR + FeatConfig -> TestTopology. Pure and deterministic (INV-2); outline expansion, ordering resolution, query implicit-zero synthesis.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@mmmnt/feat-types": "workspace:^"
  },
  "devDependencies": {
    "@mmmnt/feat-core": "workspace:^",
    "vitest": "^3.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mmmnt/feature.git",
    "directory": "packages/feat-derive"
  },
  "homepage": "https://github.com/mmmnt/feature#readme",
  "bugs": {
    "url": "https://github.com/mmmnt/feature/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
