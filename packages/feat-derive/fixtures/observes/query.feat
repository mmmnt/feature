feat 1.0

spec SPEC-FIX-303 "a query observes one"
context Fixture
aggregate Thing
type query
status draft
observes cache

construct:
  handler at src/do-thing.ts
  touches src/**

enforce:
  do the thing

contract:
  input ThingInput
  response ThingResult
  error Refusal

scenario "reads the thing":
  when: DoThing { value: 1 }
  predict success:
    response OK ThingResult
