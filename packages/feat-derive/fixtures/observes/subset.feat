feat 1.0

spec SPEC-FIX-302 "observes two"
context Fixture
aggregate Thing
type command
status draft
observes log, eventStore

construct:
  handler at src/do-thing.ts
  touches src/**

enforce:
  do the thing
  rejects NOPE when the thing cannot be done

contract:
  input ThingInput
  response ThingResult
  error Refusal

scenario "does the thing":
  when: DoThing { value: 1 }
  predict success:
    response OK ThingResult
    eventStore has []
    log has []

scenario "refuses the thing":
  when: DoThing { value: 0 }
  predict rejection NOPE:
    response ERR Refusal { code: "NOPE" }
    eventStore has []
    log has []

scenario "fails the thing":
  when: DoThing { value: 2 }
  predict error BROKEN:
    response ERR Refusal { code: "BROKEN" }
    eventStore has []
    log has []
