feat 1.0

# Fixture workspace for SPEC-GEN-001 (seed variables amendment): a static literal variable whose value is not a date-time

spec SPEC-ITM-001 "Add an item"
context Catalog
aggregate Item
type command
status agreed

construct:
  handler at src/add-item.ts
  touches src/**

enforce:
  rejects ITEM_EXISTS when the item id is already present

contract:
  input AddItemInput
  event ItemEvent
  record ItemRow
  error ItemError

variables:
  until: string = "not-a-date"

scenario "item with a bad static variable":
  given:
    The store already holds seeded state.
    seed store [ ItemAdded with ItemEvent { itemId: "11111111-0000-4000-8000-000000000001", validUntil: "${until}" } ]
  when: AddItem { itemId: "22222222-0000-4000-8000-000000000009" }
  predict rejection ITEM_EXISTS:
    response 409 ItemError
    store has []
