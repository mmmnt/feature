{
  "name": "@mmmnt/feature",
  "version": "0.18.0",
  "description": "The feat CLI — Feature, the quality spine of AI-native delivery.",
  "license": "BSD-3-Clause",
  "author": "listenrightmeow <@listenrightmeow> (https://sdd.mmmnt.dev/)",
  "type": "module",
  "bin": {
    "feat": "./bin/run.js"
  },
  "main": "./dist/index.js",
  "files": [
    "bin",
    "dist",
    "schemas"
  ],
  "oclif": {
    "bin": "feat",
    "dirname": "feat",
    "commands": "./dist/commands",
    "topicSeparator": " "
  },
  "scripts": {
    "build": "node scripts/copy-schemas.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude '**/generate-seed-fixtures.test.ts' --exclude '**/audit-changed.test.ts' --exclude '**/init.test.ts'"
  },
  "dependencies": {
    "@mmmnt/feat-core": "workspace:^",
    "@mmmnt/feat-derive": "workspace:^",
    "@mmmnt/feat-emit-ts": "workspace:^",
    "@mmmnt/feat-runtime": "workspace:^",
    "@oclif/core": "^5.1.12",
    "@mmmnt/feat-types": "workspace:^",
    "@mmmnt/feat-runner": "workspace:^",
    "@mmmnt/feat-analyze": "workspace:^"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "vitest": ">=3.2.0"
  },
  "devDependencies": {
    "vitest": "^3.2.0",
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mmmnt/feature.git",
    "directory": "packages/feature"
  },
  "homepage": "https://github.com/mmmnt/feature/tree/main/packages/feature#readme",
  "bugs": {
    "url": "https://github.com/mmmnt/feature/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "feature",
    "feat",
    "specification",
    "spec-driven-development",
    "testing",
    "vitest",
    "cli",
    "test-generation",
    "dsl"
  ]
}
