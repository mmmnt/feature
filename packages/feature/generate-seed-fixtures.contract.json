{
  "$schema": "https://feat.dev/schemas/contract.json",
  "specId": "SPEC-GEN-001",
  "schemas": {
    "SeedFixtureInput": {
      "type": "object",
      "required": ["config"],
      "additionalProperties": false,
      "properties": {
        "config": { "type": "string", "minLength": 1 }
      }
    },
    "SeedFixtureReport": {
      "type": "object",
      "required": ["specs", "fixtures", "records", "unresolved", "recordTypes", "skipped"],
      "additionalProperties": false,
      "properties": {
        "specs": { "type": "integer", "minimum": 0 },
        "fixtures": { "type": "integer", "minimum": 0 },
        "records": { "type": "integer", "minimum": 0 },
        "unresolved": { "type": "integer", "minimum": 0 },
        "recordTypes": { "type": "array", "items": { "type": "string" } },
        "skipped": { "type": "array", "items": { "type": "string" } }
      }
    },
    "SeedFixtureError": {
      "type": "object",
      "required": ["code", "count", "detail"],
      "properties": {
        "code": {
          "enum": [
            "SEED_FIXTURE_NOT_FOUND",
            "SEED_FIXTURE_NOT_JSON",
            "SEED_FIXTURE_NOT_RECORDS",
            "SEED_FIXTURE_SCHEMA_UNDECLARED",
            "SEED_FIXTURE_VALUES_INVALID",
            "SEED_VALUES_INVALID",
            "SEED_ROW_VALUES_INVALID"
          ]
        },
        "count": { "type": "integer", "minimum": 1 },
        "detail": { "type": "string" }
      }
    }
  }
}
