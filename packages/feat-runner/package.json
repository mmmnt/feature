{
  "name": "@mmmnt/feat-runner",
  "version": "0.17.0",
  "description": "Feat runner: thin vitest subprocess orchestrator (GAP-D09). Spec filtering, exit-code passthrough, JUnit collection.",
  "license": "BSD-3-Clause",
  "author": "listenrightmeow <@listenrightmeow> (https://sdd.mmmnt.dev/)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude '**/serial-faults.test.ts' --exclude '**/local-vitest.test.ts' --passWithNoTests"
  },
  "dependencies": {
    "@mmmnt/feat-types": "workspace:^"
  },
  "peerDependencies": {
    "vitest": ">=3.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mmmnt/feature.git",
    "directory": "packages/feat-runner"
  },
  "homepage": "https://github.com/mmmnt/feature/tree/main/packages/feat-runner#readme",
  "bugs": {
    "url": "https://github.com/mmmnt/feature/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@mmmnt/feat-runtime": "workspace:^",
    "vitest": "^3.2.0"
  },
  "keywords": [
    "feature",
    "feat",
    "specification",
    "spec-driven-development",
    "testing",
    "vitest",
    "test-runner"
  ],
  "engines": {
    "node": ">=22"
  }
}
