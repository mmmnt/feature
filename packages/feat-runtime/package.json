{
  "name": "@mmmnt/feat-runtime",
  "version": "0.17.0",
  "description": "What generated tests import: loadConfig, config-driven adapter loading (createAdapter contract), lifecycle/capture orchestration, precondition executor, toMatchPrediction. Deps: feat-types + Ajv only (ADR-0001).",
  "license": "BSD-3-Clause",
  "author": "listenrightmeow <@listenrightmeow> (https://sdd.mmmnt.dev/)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schemas/*": "./schemas/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schemas"
  ],
  "scripts": {
    "build": "node scripts/copy-schema.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude '**/load-config.test.ts' --exclude '**/harness-observation.test.ts' --exclude '**/harness-faults.test.ts' --exclude '**/load-config-extends.test.ts' --exclude '**/harness-namespace.test.ts' --exclude '**/harness-cases.test.ts' --exclude '**/harness-setup.test.ts' --exclude '**/harness-given-order.test.ts' --exclude '**/match-not.test.ts' --exclude '**/match-given.test.ts' --exclude '**/harness-seed.test.ts' --exclude '**/harness-deliver.test.ts' --exclude '**/match-nested.test.ts' --passWithNoTests"
  },
  "dependencies": {
    "@mmmnt/feat-types": "workspace:^",
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.0"
  },
  "devDependencies": {
    "vitest": "^3.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mmmnt/feature.git",
    "directory": "packages/feat-runtime"
  },
  "homepage": "https://github.com/mmmnt/feature/tree/main/packages/feat-runtime#readme",
  "bugs": {
    "url": "https://github.com/mmmnt/feature/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "feature",
    "feat",
    "specification",
    "spec-driven-development",
    "testing",
    "vitest",
    "test-harness",
    "runtime"
  ],
  "engines": {
    "node": ">=22"
  }
}
