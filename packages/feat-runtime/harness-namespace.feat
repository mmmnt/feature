feat 1.0

# SPEC-RT-006 — the runner's namespace (founder ruling c7af7871, 2026-11-09, item 2): one
# namespace per spec file, derived by the runner, handed to every adapter and to the spec host.
# Agreed and ordered built by Sift decision 58a4ac88 (2026-11-09). Builds after SPEC-RT-002; the product adapters
# of drafts/product-adapters need it (they no longer take `options.namespace`).
#
# The rule. namespace(specPath) = "s" + the first 12 hex characters of the SHA-256 of the spec
# file's path, UTF-8, relative to the directory of the active feat.config.json, with "/" as the
# separator, no leading "./", case kept. The result is exactly the pattern ^s[0-9a-f]{12}$ that the
# Feat Host Protocol fixes for `setup.namespace` (founder ruling a59656b7); every product binding
# accepts it (no dot, hash sign or slash, 13 characters).
# Examples: adapters/kurrent/observe.feat -> s0599e33863c1; adapters/kafka/observe.feat ->
# s3b04e21257fd; packages/feat-core/parse.feat -> s828460f74230.
#   - Stable within a file: derived once, when the harness for the file is built, so every case,
#     every adapter and the host see the same value; reset() never changes it.
#   - Stable across runs, workers and machines: a function of the path alone. A crashed run's
#     leftovers sit in the same namespace and are cleared by the next case's reset.
#   - Collision-free across parallel files: distinct paths give distinct values with
#     overwhelming probability (48 bits); the runner checks the whole run's spec set before any
#     file starts and refuses a collision (NAMESPACE_COLLISION) rather than hoping.
#   - Not configured: a `namespace` key in a service's `options` or in the response config is
#     refused at load (NAMESPACE_CONFIGURED), because a configured value is shared by every file
#     and defeats the isolation.
# How it composes with SPEC-RT-004 (extends, TIER_SPACE_MISMATCH, INVALID_CONFIG). The namespace is
# never part of any config FILE: it is added to the in-memory config object after loadConfig has
# returned (base and overlay merged, validated), as a top-level key beside `adapter` and
# `options`. So (1) it is not a service key, command name or actor name, and cannot cause
# TIER_SPACE_MISMATCH; (2) it is not in the document the config schema validates, and the
# derivation-hash slice (featVersion plus the three closed spaces) does not include it, so
# generated files do not change per path; (3) a `namespace` key written in a file, base or
# overlay, in response config or in any service's options, is a different failure: loadConfig
# finishes first (so INVALID_CONFIG and TIER_SPACE_MISMATCH are reported ahead of it), then the
# runner refuses the merged result with NAMESPACE_CONFIGURED. The same value reaches both tiers'
# adapters for one spec file, because the path alone derives it.
# Delivery. Every service adapter and the response adapter is created with
# createAdapter({ ...config, namespace }) (a top-level key beside `options`); the in-process
# handler's context carries `ctx.namespace`; process.env.FEAT_NAMESPACE is set for the file and
# restored on teardown; the stdio spec host receives it in `setup` and must echo it (PROTOCOL_VIOLATION if not; see
# drafts/stdio-jsonrpc-adapter/NAMESPACE-IMPACT.md).
# What a host that ignores it breaks. Its writes land outside the namespace, so a product
# adapter's capture filters them out and an absence (`records []`) passes while the system is
# doing the wrong thing, which is the worst failure an isolation layer has. So honouring is
# checked, not assumed: the host must report the namespace it is running under, and the harness
# refuses the case when what it reports differs (NAMESPACE_NOT_HONOURED). AMENDED by founder ruling
# 2026-11-09, namespace timing A: for the RESPONSE adapter the check runs AFTER the case's invoke() returns
# and BEFORE any prediction is compared, not right after setup — an in-process handler can only report the
# namespace once it has read it, which it does inside invoke(). A SERVICE adapter keeps the earlier check, at
# its setup, before any case runs. Who answers what:
#   - A stdio spec host speaks the Feat Host Protocol, whose `setup` result REQUIRES the echo and
#     fixes its pattern. A missing or malformed echo is PROTOCOL_VIOLATION, raised by the stdio
#     adapter at the transport layer (SPEC-RPC-001/002 own that case, not this spec; the harness
#     only surfaces it unchanged). NAMESPACE_NOT_HONOURED covers a WELL-FORMED echo of another value.
#   - "none" (nothing reported) is meaningful only for hosts that do not speak the protocol: the
#     in-process handler adapter, whose handler reads `ctx.namespace`, and any response or service
#     adapter that implements the optional reportedNamespace(). The handler adapter reports the
#     value its context handed out and none when the handler never read it. For these, none is
#     NAMESPACE_NOT_HONOURED (response adapter: after the invoke; service adapter: at setup). An
#     adapter with no reportedNamespace() is not checked.
#
# Driven through packages/feat-runtime/fixtures/harness/probe.mjs (the same probe
# as SPEC-RT-002; part of the build). `RunHarnessNamespace { specs, hostEcho?, digest?, config? }`
# builds one harness per path in `specs` as the runner would (two paths = two files in
# parallel), with stub adapters that record the namespace they were created with. `hostEcho` is
# the namespace the stub host reports: ok (the delivered one), none, other (the well-formed
# s000000000000), malformed (not the pattern); `hostKind` is protocol (a stub of the Feat Host
# Protocol adapter, which validates its setup result as the real one does) or in-process (a handler
# adapter stub with reportedNamespace()). `digest: "collide"`
# forces two paths to one digest. `config: "configured"` loads a config with options.namespace, "configured-overlay" one whose
# overlay (SPEC-RT-004) carries it.
# The answer: `namespaces` (path=value, comma-joined, in `specs` order), `trace` (create:<role>
# ns=<value> for each adapter, then case:<name> for each case run, env=<value>/env=restored),
# and `valid` (every derived value matches ^s[0-9a-f]{12}$).

spec SPEC-RT-006 "Runner: one namespace per spec file, delivered to adapters and host"
context Toolchain
aggregate Runtime
type infrastructure
status agreed

construct:
  handler at packages/feat-runtime/src/namespace.ts
  touches packages/feat-runtime/**
  touches packages/feat-types/**
  needs SPEC-RT-002
  Export deriveNamespace(specPath: string, configDir: string): string by the rule in the header
  (normalise the path to the config directory, "/" separators, no "./"). The harness derives it
  once per file, then creates the response adapter and every service adapter with
  createAdapter({ ...config, namespace }), sets process.env.FEAT_NAMESPACE (restoring the prior
  value on teardown), passes it as ctx.namespace to the handler adapter, and, for an adapter
  that can report one (reportedNamespace()), compares it with the derived one: a service adapter's at its
  setup, the response adapter's after the case's invoke() returns and before the predictions are compared.
  The runner (feat run) derives the namespace of every spec file in the run before starting vitest
  and refuses two files with one value. Loading a config whose response config or any service
  options has a `namespace` key is refused.
  FeatServiceAdapter and FeatResponseAdapter config types gain `namespace: string`.

enforce:
  rejects NAMESPACE_COLLISION when two spec files of one run derive the same namespace
  rejects NAMESPACE_NOT_HONOURED when a host reports a well-formed namespace other than the one delivered, or, for a host that does not speak the Feat Host Protocol and implements reportedNamespace(), none; the response adapter is checked after the case's invoke and before its predictions are compared, a service adapter at setup
  rejects PROTOCOL_VIOLATION when a stdio host's setup result lacks the namespace or malforms it (raised by the stdio adapter per SPEC-RPC-001/002 and surfaced unchanged)
  rejects NAMESPACE_CONFIGURED when a loaded config (base or overlay, after the SPEC-RT-004 checks) carries a namespace key in response config or service options
  add the namespace to the in-memory config after loadConfig, never to a file, so it cannot affect the tier spaces or the derivation hash
  derive the namespace from the spec file's path alone, relative to the config directory
  create every adapter of a file with the same namespace for the whole file
  set FEAT_NAMESPACE for the file and restore it on teardown

contract:
  input RunInput
  response RunResult
  error NamespaceError

scenario "the namespace matches the protocol's pattern and is derived from the spec path":
  when: RunHarnessNamespace { specs: ["adapters/kurrent/observe.feat", "adapters/kafka/observe.feat", "packages/feat-core/parse.feat"] }
  predict success:
    response OK RunResult {
      namespaces: "adapters/kurrent/observe.feat=s0599e33863c1,adapters/kafka/observe.feat=s3b04e21257fd,packages/feat-core/parse.feat=s828460f74230",
      valid: true
    }
    filesystem has []

scenario "equivalent spellings of one path give one namespace":
  when: RunHarnessNamespace { specs: ["./adapters/kurrent/observe.feat", "adapters\\kurrent\\observe.feat"] }
  predict success:
    response OK RunResult {
      namespaces: "adapters/kurrent/observe.feat=s0599e33863c1,adapters/kurrent/observe.feat=s0599e33863c1",
      valid: true
    }
    filesystem has []

scenario "every adapter of a file and every case of it see the same namespace":
  when: RunHarnessNamespace { specs: ["adapters/kurrent/observe.feat"], cases: 2 }
  predict success:
    response OK RunResult {
      namespaces: "adapters/kurrent/observe.feat=s0599e33863c1",
      trace: "create:response ns=s0599e33863c1 create:store ns=s0599e33863c1 case:c1 case:c2"
    }
    filesystem has []

scenario "two files in parallel each get their own namespace":
  when: RunHarnessNamespace { specs: ["adapters/kurrent/observe.feat", "adapters/kafka/observe.feat"], cases: 1 }
  predict success:
    response OK RunResult {
      namespaces: "adapters/kurrent/observe.feat=s0599e33863c1,adapters/kafka/observe.feat=s3b04e21257fd",
      trace: "create:response ns=s0599e33863c1 create:store ns=s0599e33863c1 create:response ns=s3b04e21257fd create:store ns=s3b04e21257fd case:c1 case:c1"
    }
    filesystem has []

scenario "the namespace is in the environment while the file runs and restored after":
  when: RunHarnessNamespace { specs: ["adapters/kurrent/observe.feat"], cases: 1, env: "FEAT_NAMESPACE" }
  predict success:
    response OK RunResult {
      namespaces: "adapters/kurrent/observe.feat=s0599e33863c1",
      trace: "create:response ns=s0599e33863c1 create:store ns=s0599e33863c1 case:c1 env=s0599e33863c1 teardown env=restored"
    }
    filesystem has []

scenario "a host that echoes the delivered namespace is accepted":
  when: RunHarnessNamespace { specs: ["adapters/kurrent/observe.feat"], hostKind: "protocol", hostEcho: "ok" }
  predict success:
    response OK RunResult { namespaces: "adapters/kurrent/observe.feat=s0599e33863c1" }
    filesystem has []

scenario "an in-process host that reports no namespace is refused after the invoke":
  when: RunHarnessNamespace { specs: ["adapters/kurrent/observe.feat"], hostKind: "in-process", hostEcho: "none", cases: 1 }
  predict rejection NAMESPACE_NOT_HONOURED:
    response ERR NamespaceError { code: "NAMESPACE_NOT_HONOURED", trace: "create:response ns=s0599e33863c1 create:store ns=s0599e33863c1 case:c1", detail: matching "s0599e33863c1" }
    filesystem has []

scenario "a protocol host that reports another well-formed namespace is refused after the invoke":
  when: RunHarnessNamespace { specs: ["adapters/kurrent/observe.feat"], hostKind: "protocol", hostEcho: "other", cases: 1 }
  predict rejection NAMESPACE_NOT_HONOURED:
    response ERR NamespaceError { code: "NAMESPACE_NOT_HONOURED", trace: "create:response ns=s0599e33863c1 create:store ns=s0599e33863c1 case:c1", detail: matching "s000000000000" }
    filesystem has []

scenario "the response check comes before the predictions: a refused namespace is reported, not the violation behind it":
  when: RunHarnessNamespace { specs: ["adapters/kurrent/observe.feat"], hostKind: "in-process", hostEcho: "none", cases: 1, wrongPrediction: true }
  predict rejection NAMESPACE_NOT_HONOURED:
    response ERR NamespaceError { code: "NAMESPACE_NOT_HONOURED", trace: "create:response ns=s0599e33863c1 create:store ns=s0599e33863c1 case:c1" }
    filesystem has []

scenario "a service adapter that reports another namespace is still refused at its setup, before any case runs":
  when: RunHarnessNamespace { specs: ["adapters/kurrent/observe.feat"], serviceEcho: "other", cases: 1 }
  predict rejection NAMESPACE_NOT_HONOURED:
    response ERR NamespaceError { code: "NAMESPACE_NOT_HONOURED", trace: "create:response ns=s0599e33863c1 create:store ns=s0599e33863c1", detail: matching "s000000000000" }
    filesystem has []

scenario "a protocol host whose setup result has no namespace is a protocol violation, not this spec's refusal":
  when: RunHarnessNamespace { specs: ["adapters/kurrent/observe.feat"], hostKind: "protocol", hostEcho: "none", cases: 1 }
  predict rejection PROTOCOL_VIOLATION:
    response ERR NamespaceError { code: "PROTOCOL_VIOLATION", trace: "create:response ns=s0599e33863c1", detail: matching "namespace" }
    filesystem has []

scenario "a protocol host whose echo is not the protocol's pattern is a protocol violation":
  when: RunHarnessNamespace { specs: ["adapters/kurrent/observe.feat"], hostKind: "protocol", hostEcho: "malformed", cases: 1 }
  predict rejection PROTOCOL_VIOLATION:
    response ERR NamespaceError { code: "PROTOCOL_VIOLATION", trace: "create:response ns=s0599e33863c1", detail: matching "namespace" }
    filesystem has []

scenario "two files that derive one namespace stop the run before any file starts":
  when: RunHarnessNamespace { specs: ["adapters/kurrent/observe.feat", "adapters/kafka/observe.feat"], digest: "collide" }
  predict rejection NAMESPACE_COLLISION:
    response ERR NamespaceError { code: "NAMESPACE_COLLISION", trace: "", detail: matching "adapters/kafka/observe.feat" }
    filesystem has []

scenario "a configured namespace is refused at load":
  when: RunHarnessNamespace { specs: ["adapters/kurrent/observe.feat"], config: "configured" }
  predict rejection NAMESPACE_CONFIGURED:
    response ERR NamespaceError { code: "NAMESPACE_CONFIGURED", trace: "", detail: matching "namespace" }
    filesystem has []

scenario "a namespace written in a tier overlay is refused after the overlay itself is accepted":
  when: RunHarnessNamespace { specs: ["adapters/kurrent/observe.feat"], config: "configured-overlay" }
  predict rejection NAMESPACE_CONFIGURED:
    response ERR NamespaceError { code: "NAMESPACE_CONFIGURED", trace: "", detail: matching "overlay" }
    filesystem has []
