feat 1.0

# SPEC-RT-012 — the runtime evaluates `@given.response.<path>` and `@given[i].response.<path>` as
# matchers (ADR-0028; requested by flmnt, founder rulings 00fd1773 "Ask Feature for it" and 5f05d5e1 "Agree as drafted",
# 2026-11-14).
# Today the reference is input-side only, so a prediction cannot say a retry answers the id the first call
# minted, or that a second call draws a different secret. SPEC-CORE-001 (amended with ADR-0028) parses
# the reference in a value block to { matcher: "givenRef", index?, path }; this spec makes applyMatcher
# evaluate it, alone and as the operand of `not` (ADR-0027).
#
# WHAT CHANGES (and nothing else):
#  1. feat-types: Matcher gains { matcher: "givenRef"; index?: number; path: string }.
#  2. applyMatcher: givenRef equals the value at <path> in the response body of the given's i-th execute
#     (index absent: the last), in written order.
#  3. A reference that cannot resolve is a violation, never a pass: no execute in the given, an index out of
#     range, a path absent on that body.
#  4. `not` takes givenRef as an operand, with the same resolution rule.
# Unchanged: the input-side form, every other matcher, the record and response diffs, the anchors.
#
# Driven through the probe `MatchValue` (packages/feat-runtime/fixtures/matcher/probe.mjs), which gains
# `given`: the response bodies of the given's executes, in written order.

spec SPEC-RT-012 "Matcher: a reference to the given's response"
context Toolchain
aggregate Runtime
type infrastructure
status agreed

construct:
  handler at packages/feat-runtime/src/matcher.ts
  touches packages/feat-runtime/**
  touches packages/feat-types/**
  touches packages/feat-core/**
  needs SPEC-CORE-001
  needs SPEC-RT-011
  Types (feat-types): Matcher gains { matcher: "givenRef"; index?: number; path: string }.
  applyMatcher on givenRef: resolve the body of given[index] (index absent: the last); equal passes, else one
  violation "<anchor>: expected <shown> = <resolved as JSON>, got <value as JSON>" (got "(absent)" for an absent field). Unresolvable: one
  violation "<anchor>: <shown> resolved to nothing — <why>", <why> one of "the given ran no execute",
  "the given ran <n> execute(s)" for an index out of range, "that field is absent on the response".
  <shown> is @given.response.<path> without an index, @given[<i>].response.<path> with one.

enforce:
  pass a given reference equal to the value at its path in that execute's response body
  report a given reference that differs, naming it and the value it resolved to
  report a given reference that cannot resolve, never pass it
  accept a given reference as the operand of not, under the same resolution rule

contract:
  input MatchInput
  response MatchResult

scenario "a given reference passes on the value the last execute answered":
  when: MatchValue { value: "inv-1", matcher: { matcher: "givenRef", path: "inviteId" }, given: [ { inviteId: "inv-1" } ] }
  predict success:
    response OK MatchResult { outcome: "passed", count: 0, violation: absent }
    filesystem has []

scenario "a given reference fails on a different value, naming the reference and its value":
  when: MatchValue { value: "inv-2", matcher: { matcher: "givenRef", path: "inviteId" }, given: [ { inviteId: "inv-1" } ] }
  predict success:
    response OK MatchResult { outcome: "failed", count: 1, violation: "a: expected @given.response.inviteId = \"inv-1\", got \"inv-2\"" }
    filesystem has []

scenario "an indexed given reference reads that execute, not the last":
  when: MatchValue { value: "inv-1", matcher: { matcher: "givenRef", index: 0, path: "inviteId" }, given: [ { inviteId: "inv-1" }, { inviteId: "inv-2" } ] }
  predict success:
    response OK MatchResult { outcome: "passed", count: 0, violation: absent }
    filesystem has []

scenario "not a given reference passes on a value that differs from the given's":
  when: MatchValue { value: "AB12-CD34", matcher: { matcher: "not", operand: { matcher: "givenRef", path: "code" } }, given: [ { code: "ZZ99-YY88" } ] }
  predict success:
    response OK MatchResult { outcome: "passed", count: 0, violation: absent }
    filesystem has []

scenario "not a given reference fails on the same value":
  when: MatchValue { value: "AB12-CD34", matcher: { matcher: "not", operand: { matcher: "givenRef", path: "code" } }, given: [ { code: "AB12-CD34" } ] }
  predict success:
    response OK MatchResult { outcome: "failed", count: 1, violation: "a: expected not @given.response.code (= \"AB12-CD34\"), got \"AB12-CD34\"" }
    filesystem has []

scenario "a given reference with no execute in the given is a violation":
  when: MatchValue { value: "inv-1", matcher: { matcher: "givenRef", path: "inviteId" }, given: [] }
  predict success:
    response OK MatchResult { outcome: "failed", count: 1, violation: "a: @given.response.inviteId resolved to nothing — the given ran no execute" }
    filesystem has []

scenario "a given reference whose index is out of range is a violation":
  when: MatchValue { value: "inv-1", matcher: { matcher: "givenRef", index: 2, path: "inviteId" }, given: [ { inviteId: "inv-1" } ] }
  predict success:
    response OK MatchResult { outcome: "failed", count: 1, violation: "a: @given[2].response.inviteId resolved to nothing — the given ran 1 execute(s)" }
    filesystem has []

scenario "a given reference whose path is absent on the response is a violation":
  when: MatchValue { value: "inv-1", matcher: { matcher: "givenRef", path: "inviteId" }, given: [ { id: "inv-1" } ] }
  predict success:
    response OK MatchResult { outcome: "failed", count: 1, violation: "a: @given.response.inviteId resolved to nothing — that field is absent on the response" }
    filesystem has []
