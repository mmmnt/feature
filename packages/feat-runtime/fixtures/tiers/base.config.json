{
  "featVersion": "1.0",
  "environment": "spec",
  "schemas": {
    "adapter": "@mmmnt/feat-schema-json"
  },
  "response": {
    "adapter": "@mmmnt/feat-adapter-handler",
    "commands": {
      "Ping": {
        "module": "src/ping.ts",
        "export": "ping"
      },
      "Pong": {
        "module": "src/pong.ts",
        "export": "pong"
      }
    },
    "actors": {
      "default": "operator",
      "operator": {
        "context": {
          "role": "operator"
        }
      },
      "auditor": {
        "context": {
          "role": "auditor"
        }
      }
    }
  },
  "services": {
    "eventStore": {
      "adapter": "@mmmnt/feat-adapter-memory",
      "consistency": "strong",
      "options": {
        "inMemory": true,
        "seed": "base"
      }
    },
    "filesystem": {
      "adapter": "@mmmnt/feat-adapter-fs",
      "consistency": "acid"
    }
  },
  "specs": {
    "dir": "packages",
    "pattern": "**/*.feat",
    "contractPattern": "**/*.contract.json",
    "outputPattern": "{name}.test.ts"
  },
  "report": {
    "format": [
      "console"
    ]
  }
}
