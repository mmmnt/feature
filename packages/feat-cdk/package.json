{
  "name": "@mmmnt/feat-cdk",
  "version": "0.5.0",
  "description": "Point Feature at your CDK app: derive the deployment (resources, SSM contract, dependency closure) from the cloud assembly — SynthStack as a command, zero convention files",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude '**/local-cdk.test.ts'"
  },
  "dependencies": {
    "@mmmnt/feat-types": "workspace:^"
  },
  "devDependencies": {
    "@mmmnt/feat-runtime": "workspace:^",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "BSD-3-Clause",
  "author": "listenrightmeow <@listenrightmeow> (https://sdd.mmmnt.dev/)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mmmnt/feature.git",
    "directory": "packages/feat-cdk"
  },
  "homepage": "https://github.com/mmmnt/feature/tree/main/packages/feat-cdk#readme",
  "bugs": {
    "url": "https://github.com/mmmnt/feature/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "feature",
    "feat",
    "specification",
    "spec-driven-development",
    "testing",
    "vitest",
    "aws-cdk",
    "cloudformation",
    "infrastructure",
    "adapter"
  ]
}
